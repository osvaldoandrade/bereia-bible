{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bereia.org/schemas/manifest/1",
  "title": "Manifesto de fontes — Bereia Version",
  "version": "1.0.0",
  "description": "Contrato do sources/manifest.json. Cada fonte é uma dependência de dados pinada. Versionamento file-per-major; horizonte de compatibilidade N-1 (igual ao verse-record).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated", "entries"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "generated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "role", "file", "url", "mirrors", "git_commit", "sha256",
          "size_bytes", "license_spdx", "license_name", "license_url",
          "attribution", "usage_scope", "retirement_condition", "owner",
          "retrieved", "notes"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "role": { "type": "string" },
          "file": { "type": "string", "pattern": "^sources/" },
          "url": { "type": "string", "pattern": "^https://" },
          "mirrors": { "type": "array", "items": { "type": "string", "pattern": "^https://" } },
          "git_commit": { "type": ["string", "null"], "description": "SHA do commit upstream quando a fonte vem de git; null caso contrário" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "license_spdx": { "type": "string", "description": "Identificador SPDX ou LicenseRef-*" },
          "license_name": { "type": "string" },
          "license_url": { "type": "string", "pattern": "^https://" },
          "attribution": { "type": "string", "description": "String de atribuição exigida/adotada; replicada em NOTICE.md" },
          "usage_scope": { "enum": ["textual-authority", "qa-control-only", "analysis-only-quarantined"], "description": "Escopo permitido; ver docs/licenses/allowlist.txt" },
          "retirement_condition": { "type": "string", "description": "Condição que dispara reavaliação/retirada da fonte" },
          "owner": { "type": "string" },
          "retrieved": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
