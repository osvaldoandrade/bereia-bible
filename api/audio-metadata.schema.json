{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bereia.dev/schemas/audio-metadata.schema.json",
  "title": "Bereia Audio Metadata",
  "type": "object",
  "required": [
    "schema_version",
    "book",
    "chapter",
    "source_commit",
    "narration_source_commit",
    "tts_model",
    "model_revision",
    "runtime",
    "hardware",
    "narration_model",
    "narration_prompt_version",
    "seed",
    "cache_key",
    "voices",
    "segments",
    "mastering",
    "outputs"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "book": { "type": "string" },
    "chapter": { "type": "integer", "minimum": 1 },
    "source_commit": { "type": "string" },
    "narration_source_commit": { "type": "string" },
    "tts_model": { "type": "string" },
    "model_revision": { "type": "string" },
    "runtime": { "const": "mps" },
    "hardware": { "const": "Apple M4 Max" },
    "narration_model": { "type": "string" },
    "narration_prompt_version": { "type": "string" },
    "seed": { "type": "integer" },
    "cache_key": { "type": "string" },
    "voices": { "type": "object" },
    "segments": { "type": "array" },
    "mastering": { "type": "object" },
    "outputs": { "type": "object" }
  }
}
