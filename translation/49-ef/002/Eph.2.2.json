  "decisoes": [
    {
      "questao": "αἰών — glosa",
      "escolha": "'século'",
      "justificativa": "consistência lexical com o corpus já traduzido (Rom.12.2, 1Cor.2.6, 1Cor.3.18: αἰών→'século'), EDITORIAL §11.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'era' ou 'curso'",
          "motivo": "'era' já usado uma vez (1Cor.1.20) mas 'século' é a glosa dominante; 'curso' é paráfrase interpretativa sem base lexical fixa no corpus"
        }
      ]
    },
    {
      "questao": "ἐξουσία — glosa",
      "escolha": "'autoridade'",
      "justificativa": "consistência lexical com Rom.13.1 (ἐξουσία→'autoridade'), EDITORIAL §11.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'poder'",
          "motivo": "glosa plausível mas rompe a consistência já fixada no corpus"
        }
      ]
    },
    {
      "questao": "τοῦ πνεύματος — sintaxe de aposição",
      "escolha": "'o espírito' em aposição a 'o príncipe' (não a 'autoridade')",
      "justificativa": "leitura sintática majoritária do NT grego: o genitivo τοῦ πνεύματος reidentifica ὁ ἄρχων ('o príncipe'), não τῆς ἐξουσίας; aposição de caso solto é comum na koiné.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'o espírito' em aposição a 'autoridade'",
          "motivo": "gramaticalmente possível mas produz leitura teologicamente incoerente (personificaria 'autoridade' em vez do 'príncipe')"
        }
      ]
    },
    {
      "questao": "πνεῦμα minúsculo",
      "escolha": "manter minúsculo",
      "justificativa": "refere-se a um espírito sob o domínio do 'príncipe' (leitura demoníaca/hostil), distinto do Espírito Santo maiusculado em vv.18,22; a fonte pinada (Nestle1904) já grafa 'πνεύματος' em minúscula aqui, apoiando a distinção (EDITORIAL §10).",
      "alternativas_rejeitadas": []
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "“Segundo o século deste mundo” reflete a tradução_literal (aion) e não é arcaísmo (palavra corrente); ARA usa “curso” e NVIPT “a presente ordem” como sinônimos estilísticos, NTLH parafraseia. “Espírito” minúsculo está correto: refere-se ao espírito que anima a desobediência, não ao Espírito Santo (EDITORIAL §10). (ER-0019 v2).",
      "alternativas_rejeitadas": [],
