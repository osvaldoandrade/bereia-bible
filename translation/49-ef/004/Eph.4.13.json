  "decisoes": [
    {
      "questao": "ἐπίγνωσις — conhecimento pleno ou apenas 'conhecimento'?",
      "escolha": "pleno conhecimento",
      "justificativa": "ἐπίγνωσις (com prefixo ἐπι-) é semanticamente mais intenso que γνῶσις simples; a tradução marca essa diferença.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'conhecimento'",
          "motivo": "apagaria a distinção lexical com γνῶσις presente em outras passagens paulinas"
        }
      ]
    },
    {
      "questao": "ἄνδρα τέλειον — homem maduro, perfeito ou feito?",
      "escolha": "homem maduro",
      "justificativa": "τέλειος aqui contrasta com νήπιοι ('crianças') de v.14 — o eixo semântico é maturidade, não perfeição moral.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'homem perfeito'",
          "motivo": "em português soa como perfeição moral/absoluta, deslocando o contraste etário/maturidade do contexto"
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "\"Homem maduro\" é mais natural que \"homem feito\" (ARA) e converge com a ideia de maturidade de NTLH/NVIPT; a BV já atende ao piso de naturalidade do §1.4. Mantido. (ER-0019 v2).",
