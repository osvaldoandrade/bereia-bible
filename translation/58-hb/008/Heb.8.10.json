  "decisoes": [
    {
      "questao": "εἰς Θεόν / εἰς λαόν — hebraísmo predicativo (εἰς + acusativo = 'para/como')",
      "escolha": "normalizado para predicativo direto: 'serei o Deus deles... serão o meu povo'",
      "justificativa": "calque do predicativo hebraico לְ (לְ־אלהים / לְ־עם), preservado na traducao_literal ('para Deus'/'para povo'); o publicado normaliza para a construção predicativa natural do português, por analogia à doutrina do calque (ER-0013) aplicada aqui ao NT.",
      "alternativas_rejeitadas": [
        {
          "opcao": "manter 'para Deus'/'para povo' no publicado",
          "motivo": "gramatical mas artificial em português; a doutrina do calque reserva essa forma à camada literal"
        }
      ]
    },
    {
      "questao": "διδοὺς...ἐπιγράψω — cadeia particípio + verbo finito",
      "escolha": "normalizado para dois verbos finitos coordenados: 'porei... e escreverei'",
      "justificativa": "particípio circunstancial διδούς seguido de futuro finito ἐπιγράψω; o português corrido prefere coordenação finita; a traducao_literal preserva a estrutura particípio+finito.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'dando minhas leis... escreverei'",
          "motivo": "soa como tradução palavra-a-palavra, quebrando a fluência exigida por EDITORIAL §1.3"
        }
      ]
    },
    {
      "questao": "λέγει Κύριος — mesmo tratamento YHWH-subjacente de 8:8-9",
      "escolha": "diz o SENHOR",
      "justificativa": "continuação da mesma citação de Jeremias 31:31-34.",
      "alternativas_rejeitadas": []
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "Achado PRO-1 sinaliza 4 pronomes de 3ª pessoa, mas o antecedente ('a casa de Israel') é único e inequívoco ao longo de todo o trecho — não há ambiguidade referencial. ARA e NVIPT apresentam a mesma densidade de pronomes de 3ª pessoa nesta fórmula de aliança ('seu... seu... seu... eles' / 'suas... seus... deles... eles'), confirmando que a repetição é estrutural ao paralelismo da promessa, não defeito. Mantido sem alteração. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
