      "questao": "Alternância singular/plural distributivo (בְּשָׂרוֹ 'a carne DELE', sing., vs. בְּפִיהֶם 'na boca DELES', plur.) — traço coletivo/distributivo do hebraico.",
      "escolha": "Normalizar para 'de cada um' / 'na boca' (sem pronome), preservando o valor distributivo em português neutro.",
      "justificativa": "ER-0013: variação formular normalizável no publicado quando soa artificial; a literal preserva a alternância singular/plural do hebraico.",
      "alternativas_rejeitadas": [
        {
          "opcao": "manter singular/plural exatos ('a carne dele... a língua dele na boca deles')",
          "motivo": "soa como erro de concordância em português; a variação distributiva do hebraico não tem paralelo direto natural"
        }
      ]
    },
