  "decisoes": [
    {
      "questao": "ὑμεῖς οἱ ἀκολουθήσαντές μοι — sujeito antecipado (casus pendens), com o predicado καθήσεσθε separado por toda a oração temporal",
      "escolha": "reorganizar a ordem no publicado ('vocês, que me seguiram, ... também se assentarão'), aproximando sujeito e verbo; a literal preserva a ordem grega",
      "justificativa": "o grego antecipa o sujeito e insere a oração temporal entre ele e o verbo principal; a reorganização evita um período de leitura difícil em português sem alterar o sentido (doutrina do calque, ER-0013)",
      "alternativas_rejeitadas": [
        {
          "opcao": "manter a ordem grega integralmente no publicado",
          "motivo": "produziria período de compreensão difícil, com sujeito e verbo principal separados por oração inteira"
        }
      ]
    },
    {
      "questao": "παλιγγενεσία — hapax em Mateus; termo técnico escatológico de restauração final",
      "escolha": "'regeneração'",
      "justificativa": "glosa corrente em português para παλιγγενεσία no registro teológico (cf. Tt 3:5); designa a restauração final de todas as coisas, sentido escatológico-coletivo, não apenas 'novo nascimento' individual",
      "alternativas_rejeitadas": [
        {
          "opcao": "'renovação'",
          "motivo": "menos consolidada como termo técnico; 'regeneração' é a glosa corrente para este contexto"
        }
      ]
    }
  ],
