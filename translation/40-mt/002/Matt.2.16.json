  "decisoes": [
    {
      "questao": "ἐνεπαίχθη (ἐμπαίζω) — 'enganado' vs. 'escarnecido/zombado'",
      "escolha": "enganado",
      "justificativa": "ἐμπαίζω cobre 'zombar, ridicularizar, enganar'; no contexto (magos não retornam conforme combinado), o sentido operativo é o de ter sido burlado na expectativa, não o de escárnio verbal.",
      "alternativas_rejeitadas": [
        {
          "opcao": "escarnecido/zombado",
          "motivo": "sentido mais literal do verbo, porém menos ajustado ao contexto narrativo de expectativa frustrada"
        }
      ]
    },
    {
      "questao": "ἀποστείλας ἀνεῖλεν — dois verbos coordenados ('enviando', 'matou') vs. causativo único",
      "escolha": "mandou matar (causativo condensado)",
      "justificativa": "O grego coordena duas ações (ἀποστείλας 'enviando' + ἀνεῖλεν 'matou'), implicando execução por terceiros enviados por Herodes; o português usa naturalmente o causativo 'mandou matar' para o mesmo sentido; a traducao_literal preserva as duas ações separadamente.",
      "alternativas_rejeitadas": [
        {
          "opcao": "e, enviando, matou",
          "motivo": "mais literal, mas 'enviando' sem objeto expresso soa incompleto em português; preferido o causativo natural"
        }
      ]
    }
  ],
  "palavras_supridas": [],
  "ambiguidades_preservadas": [
    "παῖς não especifica sexo gramaticalmente; 'meninos' no plural genérico do português cobre a mesma amplitude sem decidir se todas as crianças mortas eram do sexo masculino."
  ],
  "justificativa": "διετοῦς καὶ κατωτέρω vertido 'de dois anos para baixo', idiomático padrão para faixa etária-limite.",
