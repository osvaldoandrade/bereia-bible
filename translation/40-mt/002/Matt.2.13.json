  "decisoes": [
    {
      "questao": "ἄγγελος κυρίου — artigo ausente no grego: 'um anjo do Senhor' vs. 'o anjo do Senhor'",
      "escolha": "um anjo do Senhor (anártrico, indefinido)",
      "justificativa": "ἄγγελος é anártrico no grego (sem artigo); a gramática não licencia o definido 'o anjo do Senhor', que importaria identificação com uma figura teofânica específica do AT (mal'ak YHWH) não codificada pelo grego de Mateus aqui.",
      "alternativas_rejeitadas": [
        {
          "opcao": "o anjo do Senhor",
          "motivo": "tradição de outras versões usa o definido, mas o grego anártrico não o exige; TEOLOGIA §2 veda inserir implicação que o texto-fonte não codifica"
        }
      ]
    },
    {
      "questao": "φαίνεται — presente histórico",
      "escolha": "apareceu (normalizado para pretérito no publicado)",
      "justificativa": "Presente histórico grego para narração vívida; o português narrativo normaliza para pretérito perfeito.",
      "alternativas_rejeitadas": [
        {
          "opcao": "aparece (presente literal mantido no publicado)",
          "motivo": "soa não natural em narrativa portuguesa corrida; reservado à traducao_literal"
        }
      ]
    },
    {
      "questao": "Registro de segunda pessoa do anjo (mensageiro divino) a José",
      "escolha": "você (implícito nas formas verbais: levante-se, tome, fuja, fique, lhe)",
      "justificativa": "EDITORIAL/ER-0003 classifica discurso 'de Deus para humanos' no registro você/vocês; a mensagem angélica veicula fala divina dirigida a José.",
      "alternativas_rejeitadas": [
        {
          "opcao": "tu (levanta-te, toma, foge)",
          "motivo": "ER-0003 reserva 'tu' à oração dirigida a Deus, não ao sentido inverso"
        }
      ]
    }
  ],
