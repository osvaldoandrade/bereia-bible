  "decisoes": [
    {
      "questao": "σου (singular) / ἠθελήσατε (plural) — mudança de número na mesma frase",
      "escolha": "'teus filhos' (singular, Jerusalém personificada) seguido de 'vocês não quiseram' (plural, os habitantes)",
      "justificativa": "o próprio grego muda de 2ª singular (σου, dirigido à cidade personificada) para 2ª plural (ἠθελήσατε, dirigido aos seus habitantes reais) na mesma sentença; D-0003 exige preservar a distinção singular/plural do original, por isso a BV reproduz essa mesma mudança em vez de nivelar tudo para singular ou plural.",
      "alternativas_rejeitadas": [
        {
          "opcao": "uniformizar tudo em 'vocês' (plural)",
          "motivo": "apagaria a personificação poética de Jerusalém como interlocutora singular, marca retórica do lamento"
        }
      ]
    },
    {
      "questao": "ὄρνις / νοσσία",
      "escolha": "'galinha' / 'filhotes'",
      "justificativa": "imagem de proteção maternal; 'galinha' é a glosa tradicional para ὄρνις neste contexto (ave doméstica que abriga a ninhada), 'filhotes' evita registro excessivamente coloquial ('pintinhos') mantendo o registro formal-neutro (EDITORIAL §1.2).",
      "alternativas_rejeitadas": [
        {
          "opcao": "'pintinhos'",
          "motivo": "registro coloquial demais para o tom solene do lamento"
        }
      ]
    }
  ],
