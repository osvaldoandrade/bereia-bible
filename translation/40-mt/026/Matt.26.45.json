  "decisoes": [
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "CAL-2 sinalizou 'eis que', mas aqui reproduz ἰδοὺ ἤγγικεν do grego, repetido verbatim no v.46 ('eis que chegou...' nos dois versos) — repetição intencional do original marcando dupla proclamação solene de Jesus (regra 4). ARA mantém 'eis que' nos dois versos; NVIPT preserva o marcador (deslocado para a oração seguinte); NTLH substitui por 'Olhem!' — nenhuma referência simplesmente apaga a força dêitica. Mantido por doutrina do calque (EDITORIAL §6.2: manter quando o original marca o dêitico com força). (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
