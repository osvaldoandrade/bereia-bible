    {
      "questao": "Ἄφες + subjuntivo deliberativo (ἐκβάλω)",
      "escolha": "\"Deixa eu tirar\"",
      "justificativa": "Construção coloquial equivalente ao grego (pedido de permissão + 1ª pessoa subjuntiva), mais natural que um imperativo isolado.",
      "alternativas_rejeitadas": [
        {
          "opcao": "\"Deixa-me tirar\" (com clítico)",
          "motivo": "registro possível, mas \"deixa eu\" é mais corrente na oralidade formal-neutra alvo"
        }
      ]
    },
    {
      "questao": "ἰδού interjetivo",
      "escolha": "não vertido lexicalmente no publicado (normalizado para \"sendo que\"), preservado como \"eis que\" na literal",
      "justificativa": "Doutrina do calque (ER-0013) aplicada por analogia: interjeição hebraizante/semitizante soa artificial em prosa contemporânea.",
      "alternativas_rejeitadas": [
        {
          "opcao": "\"eis que\" no publicado",
          "motivo": "registro arcaizante para diálogo cotidiano entre irmãos"
        }
      ]
    },
    {
      "questao": "Revisão editorial do texto_bv",
      "escolha": "Deixa eu tirar o cisco do seu olho → Deixe-me tirar o cisco do seu olho",
      "justificativa": "Paradigma de 2ª pessoa (§3/D-0003): o capítulo usa você/vocês, mas “Deixa” é imperativo de tu, quebrando a coerência de paradigma. Corrige também a construção não normativa “deixa eu” (pronome reto como objeto do infinitivo causativo) para o clítico “deixe-me”, alinhado com NVIPT (“Deixe-me tirar”) e ARA (“Deixa-me tirar”). — revisão de forma sem alteração de sentido (ER-0019). Achado de paradigma de 2ª pessoa: “Deixa” (tu) destoava do você/vocês predominante no capítulo; corrigido para “Deixe-me”, forma de você compatível com o restante do texto e com NVIPT/ARA.",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
