    {
      "questao": "Manutenção do texto_bv (revisão ER-0024 v2)",
      "escolha": "texto mantido",
      "justificativa": "\"Um dos menores destes mandamentos\" é construção partitiva idiomática do português para o superlativo grego τῶν ἐλαχίστων (cf. \"um dos maiores problemas\"); pronome resumptivo \"esse\" retoma \"quem\" com clareza. (ER-0024 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0024"
    }
