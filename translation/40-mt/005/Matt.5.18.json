  "decisoes": [
    {
      "questao": "ἀμήν λέγω: fórmula de ênfase",
      "escolha": "'em verdade eu lhes digo'",
      "justificativa": "fórmula solene de autenticação característica do discurso de Jesus nos evangelhos (ἀμήν transliterado do hebraico); 'em verdade... digo' é a forma consolidada e ainda viva no português bíblico contemporâneo (não arcaísmo morto).",
      "alternativas_rejeitadas": [
        {
          "opcao": "amém eu lhes digo (transliteração integral)",
          "motivo": "menos natural como abertura de oração em português; 'amém' funciona em português como resposta/aclamação, não como advérbio de ênfase inicial"
        }
      ]
    },
    {
      "questao": "ἰῶτα/κεραία: menor letra/menor traço",
      "escolha": "'jota' / 'til'",
      "justificativa": "ἰῶτα é a menor letra do alfabeto grego (equivalente funcional ao iode hebraico); κεραία, um pequeno traço/serifa que distingue letras hebraicas semelhantes. 'Jota' e 'til' são as glosas consolidadas na tradição bíblica em português, reconhecíveis ao leitor.",
      "alternativas_rejeitadas": [
        {
          "opcao": "ápice/traço (κεραία)",
          "motivo": "mais literal, porém sem a mesma força de reconhecimento imediato que 'til' tem na tradição de tradução bíblica em português"
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "As três referências divergem do termo “jota” (ARA “um só i”, NVIPT “a menor letra”, NTLH “nem a menor letra”), mas “jota” é escolha lexical deliberada e bem atestada em revisões contemporâneas de Almeida (ex.: NAA) para o iota grego, e tornou-se idiomática em português (“não mudar nem um jota”) — mais natural que “um só i”. Não é arcaísmo (não consta em EDITORIAL §1.2) nem gera ambiguidade; mantido. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
