    {
      "questao": "ἄνθρωπος genérico plural: 'pessoas' vs 'homens'",
      "escolha": "'pessoas' (uso corrente, ao longo do capítulo, para ἄνθρωπος plural genérico)",
      "justificativa": "ἄνθρωπος é termo genérico de humanidade, não específico de gênero (diferente de ἀνήρ); 'pessoas' evita a leitura restritiva que 'homens' pode sugerir em português contemporâneo, mantendo o mesmo valor lexical. Decisão aplicada de forma consistente em todo o capítulo (5:13,16,19,45).",
      "alternativas_rejeitadas": [
        {
          "opcao": "homens",
          "motivo": "tradução tradicional e ainda corrente, mas pode soar restritiva a leitores contemporâneos onde o grego é inclusivo"
        }
      ]
    },
    {
      "questao": "μωραίνω aplicado ao sal: 'perder o sabor' vs 'tornar-se insensato'",
      "escolha": "'perder o sabor'",
      "justificativa": "μωραίνω ('tornar tolo/insensato') é usado aqui em sentido derivado, técnico para alimentos que perdem sua qualidade (ficar insípido); a acepção literal ('insensato') é preservada na traducao_literal.",
      "alternativas_rejeitadas": [
        {
          "opcao": "tornar-se insensato/louco",
          "motivo": "leitura literal do lema, mas sem sentido aplicado a sal em português; a acepção derivada é a lexicalmente correta no contexto"
        }
      ]
    },
