  "decisoes": [
    {
      "questao": "σκανδαλίζω: 'fizer pecar' vs 'escandalizar/fizer tropeçar'",
      "escolha": "'fizer pecar' (sentido dinâmico)",
      "justificativa": "σκανδαλίζω deriva da imagem de um 'gatilho de armadilha' (σκάνδαλον), i.e., causar queda/tropeço que leva ao pecado; 'escandalizar' em português contemporâneo mudou de sentido (causar indignação moral em terceiros), por isso se opta pela glosa dinâmica 'fazer pecar', preservando a imagem de tropeço na traducao_literal.",
      "alternativas_rejeitadas": [
        {
          "opcao": "escandalizar",
          "motivo": "falso cognato: em português atual significa 'chocar/indignar', sentido distinto do grego"
        },
        {
          "opcao": "fazer tropeçar",
          "motivo": "mais literal, porém menos claro quanto à consequência (o pecado) que o contexto exige"
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "As três referências traduzem γέεννα por “inferno”; a BV mantém a transliteração técnica “geena”, de forma consistente nas três ocorrências do capítulo (5:22, 5:29, 5:30), preservando distinção exegética do grego do NT. Mudança de terminologia teológica está fora do escopo desta revisão de forma (ver também justificativa de Matt.5.22). (ER-0019 v2).",
      "alternativas_rejeitadas": [],
