  "decisoes": [
    {
      "questao": "יְחִידְךָ (yechidkha)",
      "escolha": "o teu único filho",
      "justificativa": "'Teu único/unigênito' (Isaque é o filho da promessa; Ismael foi enviado). A LXX verte ἀγαπητός 'amado' (cf. Mc 1:11). A gradação 'filho/único/amado' intensifica a prova.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'teu amado'",
          "motivo": "leitura da LXX; o hebraico é 'único'"
        }
      ]
    },
    {
      "questao": "לֶךְ־לְךָ (lekh-lekha)",
      "escolha": "vai-te",
      "justificativa": "Mesma expressão do chamado inicial (12:1) — moldura do ciclo de Abraão: sai da terra // oferece o filho.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'vai'",
          "motivo": "perde o eco deliberado com 12:1"
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "Discurso direto de Deus a Abraão emprega paradigma “tu” (toma, teu, amas, vai-te, oferece-o, te direi). As três referências (NTLH, ARA, NVIPT) também usam tu-formas neste verso (ARA/NVIPT: “Toma… teu filho… amas”). Embora §3/D-0003 prescreva você para Deus→humano, a convergência das referências indica que o registro solene em tu é convenção tradutória aceita para este trecho. Normalizar exigiria mudar paradigma de todo o discurso divino do capítulo — alteração de forma de amplo alcance sem cobertura das refs. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
