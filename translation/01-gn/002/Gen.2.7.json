    {
      "questao": "נֶפֶשׁ חַיָּה (nephesh chayyah)",
      "escolha": "ser vivente",
      "justificativa": "Valor lexical 'ser/criatura vivente'; a MESMA expressão descreve os animais em 2:19 e 1:20-24 — o homem é נפש חיה como eles, distinto pelo sopro divino. NÃO elevar a 'alma' aqui (importaria dualismo corpo/alma que o hebraico não afirma).",
      "alternativas_rejeitadas": [
        {
          "opcao": "'alma vivente'",
          "motivo": "importa dualismo antropológico ausente do texto; quebra a consistência com os animais (2:19)"
        }
      ]
    },
    {
      "questao": "יצר (yatsar)",
      "escolha": "formar",
      "justificativa": "Verbo do oleiro que molda o barro; distinto de criar (ברא) e fazer (עשה). Deus 'forma' o homem e os animais (2:19).",
      "alternativas_rejeitadas": [
        {
          "opcao": "'criou'",
          "motivo": "conflaria com ברא"
        }
      ]
    },
    {
