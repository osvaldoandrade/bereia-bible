      "justificativa": "aplicação por analogia da doutrina do calque (ER-0013) ao polissíndeto grego, que soa artificial em português com 'e' repetido a cada item; 'cananeu' tratado como epíteto descritivo, não antropônimo pleno.",
      "alternativas_rejeitadas": [
        {
          "opcao": "manter todos os 'e' também no publicado",
          "motivo": "produz enumeração arrastada, contra a legibilidade em voz alta exigida por EDITORIAL §1.3"
        },
        {
          "opcao": "maiúscula 'Cananeu' como sobrenome",
          "motivo": "atribuiria estatuto de nome próprio pleno que o grego, mero epíteto adjetival, não codifica"
        }
      ]
    }
