  "decisoes": [
    {
      "questao": "συμβούλιον ἑτοιμάσαντες — idiomatismo de deliberação",
      "escolha": "'tendo se reunido em conselho'",
      "justificativa": "ἑτοιμάζω ('preparar') aplicado a συμβούλιον é idiomatismo grego para 'formar uma resolução/tomar conselho', paralelo a συμβούλιον ἔλαβον de Mt 27.1 (já traduzido 'tomaram conselho'); tradução literal palavra a palavra soaria como fabricar um objeto.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'tendo preparado um conselho' (calque pleno no publicado)",
          "motivo": "ambíguo em português, sugere montar/organizar fisicamente um órgão, não formar uma decisão"
        }
      ]
    },
    {
      "questao": "Πειλάτῳ — grafia do nome",
      "escolha": "'Pilatos'",
      "justificativa": "grafia consolidada já fixada em Mt 27.2 e seguintes (EDITORIAL §8); mantém consistência terminológica no corpus.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'Pilato' (sem -s)",
          "motivo": "forma menos usual na tradição pt-BR corrente"
        }
      ]
    }
