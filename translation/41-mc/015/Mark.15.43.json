    {
      "questao": "εὐσχήμων βουλευτής — status social/institucional",
      "escolha": "'conselheiro de posição honrosa'",
      "justificativa": "εὐσχήμων ('de boa forma/aparência', i.e. de status social elevado) qualifica βουλευτής ('membro do conselho', do Sinédrio); a tradução evita tanto 'nobre' (importa categoria social estranha ao contexto) quanto deixar βουλευτής subentendido.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'nobre conselheiro'",
          "motivo": "'nobre' converte em título hereditário europeu um termo que designa apenas prestígio social"
        }
      ]
    }
  ],
