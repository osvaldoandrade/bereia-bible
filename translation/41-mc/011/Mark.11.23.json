  "decisoes": [
    {
      "questao": "Ἄρθητι/βλήθητι — voz passiva dos imperativos",
      "escolha": "preservar a passiva no publicado ('seja erguido e atirado'), não converter para reflexivo direto",
      "justificativa": "TEOLOGIA §2 veda suavizar dificuldades do original; a passiva (possível 'passivo divino', implicando agente não expresso) é traço do texto, não artefato de tradução",
      "alternativas_rejeitadas": [
        {
          "opcao": "'Ergue-te e lança-te' (reflexivo direto)",
          "motivo": "apaga a voz passiva do grego, suprimindo a leitura de 'passivo divino'"
        }
      ]
    },
    {
      "questao": "ἀμήν — tradução",
      "escolha": "'Em verdade' (fórmula idiomática consolidada), não transliteração 'Amém'",
      "justificativa": "fórmula solene de Jesus (heb. אמן), consolidada em português como 'em verdade eu vos/lhes digo'",
      "alternativas_rejeitadas": [
        {
          "opcao": "'Amém eu lhes digo' (transliteração)",
          "motivo": "soa estranho como abertura de frase em português corrente"
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "As três referências (NTLH, ARA, NVIPT) usam voz reflexiva/ativa (“levante-se”, “ergue-te”, “atire-se”), mas o grego emprega imperativo passivo (ἄρθητι/βλήθητι), preservado na traducao_literal (“Sê levantado e sê lançado”); a BV mantém a voz passiva por fidelidade ao passivo divino do original. Divergência é simplificação das referências, não defeito da BV. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
