    {
      "questao": "Ῥαββεί — vocativo de tratamento a Jesus",
      "escolha": "transliterar \"Rabi\", sem substituir por \"Senhor\" ou \"Mestre\"",
      "justificativa": "Marcos usa aqui o empréstimo hebraico/aramaico ῥαββί (distinto de διδάσκαλε, \"Mestre\", usado em outros versos deste capítulo); a BV mantém a distinção lexical entre os dois tratamentos gregos.",
      "alternativas_rejeitadas": [
        {
          "opcao": "\"Mestre\"",
          "motivo": "colapsaria Ῥαββεί com διδάσκαλε (vv.17,38), apagando uma variação lexical do próprio Marcos"
        }
      ]
    },
    {
      "questao": "σοὶ — 2ª pessoa de discurso humano a Jesus",
      "escolha": "\"você\" (não \"tu\")",
      "justificativa": "EDITORIAL §3/D-0003: discurso entre humanos usa você/vocês; \"tu\" fica reservado à oração dirigida a Deus. O endereçamento de Pedro a Jesus na narrativa segue o mesmo padrão já fixado em Mt 17:4.",
      "alternativas_rejeitadas": []
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "As três referências (NTLH, ARA, NVIPT) traduzem por “Mestre”, mas o grego desta fala usa a forma transliterada Ῥαββεί (“Rabi”), distinta de διδάσκαλε (“Mestre”), o mesmo vocativo usado em Mc 9.17 e 9.38 deste mesmo capítulo. Manter “Rabi” preserva essa distinção lexical do original grego, também presente na traducao_literal; não é arcaísmo nem inconsistência, e sim fidelidade a dois termos distintos. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    },
