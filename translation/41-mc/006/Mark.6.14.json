      "questao": "βασιλεύς aplicado a Herodes Antipas (historicamente tetrarca, cf. Mt.14.1/Lc.3.1)",
      "escolha": "manter 'rei', tal como o grego de Marcos",
      "justificativa": "fidelidade ao termo da fonte, sem correção histórica retrospectiva; TEOLOGIA §2 proíbe suavizar/corrigir o original",
      "alternativas_rejeitadas": [
        {
          "opcao": "'tetrarca' (correção histórica)",
          "motivo": "introduziria informação ausente do texto grego de Marcos, que usa βασιλεύς"
        }
      ]
    },
    {
      "questao": "ὁ Βαπτίζων (particípio substantivado, 'o que batiza') vs. τοῦ Βαπτιστοῦ (substantivo, v.25)",
      "escolha": "'Batista' no publicado, uniformizando com a forma nominal do v.25; literal preserva a forma participial distinta ('o Batizador')",
      "justificativa": "consistência terminológica no publicado (EDITORIAL §11), sem apagar a variação formal grega na literal",
      "alternativas_rejeitadas": []
    },
