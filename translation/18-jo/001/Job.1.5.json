  "decisoes": [
    {
      "questao": "בֵּרֲכוּ אֱלֹהִים — eufemismo escriba consolidado (ברך por 'amaldiçoar')",
      "escolha": "amaldiçoado",
      "justificativa": "O uso de ברך ('abençoar') como eufemismo para 'amaldiçoar' é reconhecido pela crítica textual (tiqqun sopherim); ocorre de forma consistente em Jó 1:5, 1:11, 2:5, 2:9, sempre em contexto de possível ofensa a Deus. Não é escolha confessional, mas filológica.",
      "alternativas_rejeitadas": [
        {
          "opcao": "abençoaram (sentido lexical direto)",
          "motivo": "produz leitura sem sentido no contexto; preservado na traducao_literal e como ambiguidade"
        }
      ]
    },
    {
      "questao": "הִקִּיפוּ (hiphil de נקף) — 'completar um ciclo'",
      "escolha": "chegavam ao fim",
      "justificativa": "Sentido de 'dar a volta/completar' aplicado aos dias do banquete = terminar o ciclo de festas.",
      "alternativas_rejeitadas": []
    },
    {
      "questao": "Revisão editorial do texto_bv",
      "escolha": "os consagrava; levantava-se → os consagrava. Levantava-se",
      "justificativa": "divisão de sentença com 43 palavras (§1.3/LEN-1); ponto-e-vírgula substituído por ponto final para reduzir o período abaixo de 40 palavras — revisão de forma sem alteração de sentido (ER-0019).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
