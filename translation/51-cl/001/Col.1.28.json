  "decisoes": [
    {
      "questao": "ἄνθρωπος — 'homem' (tradicional) ou 'ser humano' (contemporâneo)?",
      "escolha": "'ser humano', registro contemporâneo inclusivo",
      "justificativa": "EDITORIAL §1.1 (português contemporâneo); ἄνθρωπος é genérico (não ἀνήρ, 'homem/varão'); 'ser humano' evita ambiguidade de gênero gramatical que 'homem' carrega em português contemporâneo",
      "alternativas_rejeitadas": [
        {
          "opcao": "'todo homem' (tradicional)",
          "motivo": "em português contemporâneo pode ser lido como restrito ao gênero masculino, o que ἄνθρωπος não implica"
        }
      ]
    },
    {
      "questao": "τέλειον — 'perfeito' ou 'maduro'?",
      "escolha": "'maduro'",
      "justificativa": "no registro de crescimento espiritual (cf. vv.9-10, 'crescendo'), τέλειος denota completude/maturidade, não impecabilidade moral; 'perfeito' em português corrente sugere ausência de falhas, sentido que o contexto paulino de crescimento não pretende",
      "alternativas_rejeitadas": [
        {
          "opcao": "'perfeito' (tradicional)",
          "motivo": "risco de conotação de ausência de pecado que o grego τέλειος não exige aqui"
        }
      ]
    }
  ],
