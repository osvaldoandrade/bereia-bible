  "decisoes": [
    {
      "questao": "Onde surge a água?",
      "escolha": "“cavidade que há em Leí”",
      "justificativa": "הַמַּכְתֵּשׁ é depressão ou cavidade e אֲשֶׁר־בַּלֶּחִי a localiza em Leí; a BV não faz necessariamente da própria queixada o reservatório.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“do crânio de Sansão”",
          "motivo": "Troca objeto."
        },
        {
          "opcao": "“dos filisteus”",
          "motivo": "Ignora o antecedente."
        }
      ]
    },
    {
      "questao": "Como preservar recuperação e nome?",
      "escolha": "“espírito voltou ... reviveu ... En-Hacoré”",
      "justificativa": "וַתָּשָׁב רוּחוֹ e וַיֶּחִי são resultados sucessivos; עֵין הַקּוֹרֵא, “fonte do que clama”, retoma a oração.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“continuou morrendo”",
          "motivo": "Inverte os resultados."
        },
        {
          "opcao": "“Ramate-Leí”",
          "motivo": "Confunde as nomeações."
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "PRO-1: os pronomes (“seu espírito”, “ele reviveu”, “deu”, “ela está”) referem-se a Sansão e à fonte, com antecedentes claros na sequência narrativa. “Fendeu a cavidade” traduz o verbo hebraico (fendeu/rachou) com precisão — NTLH “abriu um buraco” é mais coloquial, ARA “abriu a fonte” é interpretativo, NVIPT “abriu a rocha” é metonímia. A BV preserva o verbo de ação concreta do original. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
