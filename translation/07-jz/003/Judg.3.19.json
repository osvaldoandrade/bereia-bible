      "questao": "Como verter הַפְּסִילִים?",
      "escolha": "“imagens esculpidas”",
      "justificativa": "O substantivo deriva de talhar e normalmente designa imagens. A localização junto a Gilgal permanece, sem identificar sua função.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“árvores naturais”",
          "motivo": "Troca o objeto."
        },
        {
          "opcao": "“quebradas por Eúde”, sem verbo correspondente",
          "motivo": "Acrescenta ação ausente."
        }
      ]
    },
    {
      "questao": "Quem fala e quem sai?",
      "escolha": "“Eúde... disse”; “Eglom ordenou”; “todos... saíram”",
      "justificativa": "Eúde apresenta a mensagem; o rei é o sujeito natural de “Silêncio!”, e o grupo dos presentes sai em seguida.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“os servos ordenaram silêncio ao rei”",
          "motivo": "Inverte a hierarquia e o sujeito contextual."
        },
        {
          "opcao": "“Eúde saiu com todos”",
          "motivo": "Contradiz o encontro privado seguinte."
        }
      ]
    },
