    {
      "questao": "Como verter אִטֵּר יַד־יְמִינוֹ?",
      "escolha": "“um homem com a mão direita limitada”",
      "justificativa": "אִטֵּר pode indicar impedimento/restrição da mão direita e, por consequência, uso dominante da esquerda. A BV preserva a descrição corporal sem reduzi-la silenciosamente a “canhoto”.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“destro sem qualquer particularidade”",
          "motivo": "Apaga a descrição."
        },
        {
          "opcao": "“canhoto”, sem auditoria",
          "motivo": "Resolve o mecanismo corporal além da formulação hebraica."
        }
      ]
    },
    {
      "questao": "Como verter מִנְחָה?",
      "escolha": "“tributo”",
      "justificativa": "Dado por Israel ao rei dominador, o presente tem função política. A BV não o confunde com oferta de cereal cultual.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“oferta de cereal ao SENHOR”",
          "motivo": "Troca destinatário e contexto."
        },
        {
          "opcao": "“uma mensagem verbal”",
          "motivo": "Apaga o objeto levado."
        }
      ]
    },
    {
      "questao": "Quem envia e por meio de quem?",
      "escolha": "“os filhos de Israel enviaram... por meio dele”",
      "justificativa": "Israel é sujeito plural; “sua mão” retoma Eúde como portador do tributo.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“Eglom enviou Eúde a Israel”",
          "motivo": "Inverte agentes e direção."
        }
      ]
    },
    {
