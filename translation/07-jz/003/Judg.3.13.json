        {
          "opcao": "“Israel tomou a cidade”",
          "motivo": "Inverte o sujeito plural."
        },
        {
          "opcao": "usar Eglom como único sujeito do último verbo",
          "motivo": "Apaga a mudança de número."
        }
      ]
    },
