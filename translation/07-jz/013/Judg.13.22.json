        {
          "opcao": "“talvez não aconteça nada”",
          "motivo": "Apaga a intensificação."
        },
        {
          "opcao": "“somente eu morrerei”",
          "motivo": "Contraria a primeira pessoa plural."
        }
      ]
    },
    {
