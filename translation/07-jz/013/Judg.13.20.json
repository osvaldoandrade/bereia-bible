  "decisoes": [
    {
      "questao": "Como preservar os dois movimentos da chama e do mensageiro?",
      "escolha": "“a chama subiu... o mensageiro... subiu na chama”",
      "justificativa": "O verso repete עלה: primeiro a chama sobe do altar rumo ao céu; depois o mensageiro sobe בְּלַהַב, na chama do altar.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“o mensageiro desceu da chama”",
          "motivo": "Inverte a direção do segundo verbo."
        },
        {
          "opcao": "omitir a repetição de “subiu”",
          "motivo": "Apaga o paralelo verbal relevante."
        }
      ]
    },
    {
      "questao": "Quem observa e como reage?",
      "escolha": "“Manoá e sua mulher... se prostraram com o rosto em terra”",
      "justificativa": "Ambos são sujeitos plurais de ver e cair; עַל־פְּנֵיהֶם אָרְצָה descreve prostração facial até o chão.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“somente Manoá se prostrou”",
          "motivo": "Contraria os plurais."
        },
        {
          "opcao": "“ficaram de pé”",
          "motivo": "Inverte וַיִּפְּלוּ."
        }
      ]
    }
  ],
