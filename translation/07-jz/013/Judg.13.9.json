    {
      "questao": "Quem atende a oração e quem reaparece?",
      "escolha": "“Deus escutou a voz de Manoá... o mensageiro de Deus tornou a vir”",
      "justificativa": "הָאֱלֹהִים é o sujeito de ouvir a voz de Manoá; מַלְאַךְ הָאֱלֹהִים é o sujeito de וַיָּבֹא, e עוֹד marca o retorno. As duas ações e seus agentes permanecem distintos.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“Manoá ouviu Deus”",
          "motivo": "Inverte sujeito e objeto."
        },
        {
          "opcao": "“a mulher enviou o mensageiro”",
          "motivo": "Não há esse agente no texto."
        }
      ]
    },
    {
      "questao": "Quem estava presente no campo?",
      "escolha": "“ela estava sentada no campo... Manoá, marido dela, não se encontrava com ela”",
      "justificativa": "A mulher é sujeito feminino do particípio יוֹשֶׁבֶת e está localizada no campo; אֵין עִמָּהּ nega explicitamente que Manoá, seu marido, estivesse com ela.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“Manoá estava ao lado dela”",
          "motivo": "Inverte אֵין עִמָּהּ."
        }
      ]
    }
