  "decisoes": [
    {
      "questao": "A quem Sansão relata o que viu?",
      "escolha": "“contou ao pai e à mãe”",
      "justificativa": "Os dois complementos coordenados de וַיַּגֵּד mantêm pai e mãe como destinatários do relato.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“contou somente à mulher”",
          "motivo": "Eliminaria os destinatários expressos e anteciparia uma conversa posterior."
        }
      ]
    },
    {
      "questao": "Que pedido Sansão faz?",
      "escolha": "“tomem-na para mim por esposa”",
      "justificativa": "קְחוּ é imperativo plural dirigido aos pais; אוֹתָהּ é a mulher vista, לִי marca o interesse de Sansão e לְאִשָּׁה a finalidade matrimonial.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“deixem que eu a esqueça”",
          "motivo": "Negaria o imperativo e a finalidade de casamento."
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "Sem achados. BV usa “tomem-na” (você/vocês, imperativo 3ª pes.) conforme §3/D-0003, enquanto ARA usa “tomai-ma” (vós, arcaico). Discurso direto com aspas curvas preservado. Referências convergem no sentido; BV é fiel e natural. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
