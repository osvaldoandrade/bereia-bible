    {
      "questao": "Como preservar a repetição de עוּרִי?",
      "escolha": "quatro vezes “desperte”",
      "justificativa": "O imperativo feminino singular é repetido quatro vezes e dirigido a Débora. A BV mantém ritmo, gênero do destinatário e vocativo.",
      "alternativas_rejeitadas": [
        {
          "opcao": "uma única ocorrência de “acorde”",
          "motivo": "Apaga a intensificação quádrupla."
        },
        {
          "opcao": "imperativos masculinos a Débora",
          "motivo": "Contraria a morfologia."
        }
      ]
    },
    {
      "questao": "Como verter דַּבְּרִי־שִׁיר?",
      "escolha": "“entoe um cântico”",
      "justificativa": "Literalmente “fale um cântico”, a expressão pede desempenho vocal poético. “Entoe” é natural e não acrescenta instrumento.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“escreva uma lei”",
          "motivo": "Troca fala/canto por escrita jurídica."
        }
      ]
    },
    {
      "questao": "Como tratar וּשֲׁבֵה שֶׁבְיְךָ?",
      "escolha": "“Conduza seus cativos”",
      "justificativa": "O verbo e o substantivo cognato formam uma figura de captura dirigida a Baraque. A BV mantém os cativos como pertencentes ao resultado de sua vitória, sem dizer que antes o capturaram.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“seja capturado por seus inimigos”",
          "motivo": "Inverte o imperativo."
        },
        {
          "opcao": "“mate todos os cativos”",
          "motivo": "Acrescenta ação ausente."
        }
      ]
    },
