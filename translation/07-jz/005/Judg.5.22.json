      "questao": "Como verter הָלְמוּ עִקְּבֵי־סוּס?",
      "escolha": "“bateram forte os cascos dos cavalos”",
      "justificativa": "עִקְּבֵי designa calcanhares ou cascos, e הלם descreve golpes repetidos. “Bateram forte” preserva o impacto sonoro sem inserir um objeto como “chão”.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“os cavalos ficaram imóveis”",
          "motivo": "Inverte o movimento."
        },
        {
          "opcao": "“os cavaleiros bateram nos cavalos”",
          "motivo": "Troca o sujeito."
        }
      ]
    },
    {
      "questao": "Como preservar מִדַּהֲרוֹת דַּהֲרוֹת?",
      "escolha": "“ao galope, ao galope”",
      "justificativa": "O cognato é repetido para intensificar a corrida. A BV mantém a repetição em linhas sonoras.",
      "alternativas_rejeitadas": [
        {
          "opcao": "usar “galope” apenas uma vez",
          "motivo": "Apaga a intensificação."
        }
      ]
    },
    {
      "questao": "Quem são אַבִּירָיו?",
      "escolha": "“seus corcéis”",
      "justificativa": "O adjetivo substantivado com sufixo pode designar os fortes ou garanhões ligados ao inimigo. “Corcéis” mantém a esfera equina imediata.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“suas estrelas”",
          "motivo": "Mistura a imagem anterior."
        },
