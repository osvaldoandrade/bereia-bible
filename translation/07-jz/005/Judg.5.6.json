      "questao": "O que aconteceu às אֳרָחוֹת?",
      "escolha": "“as estradas ficaram desertas”",
      "justificativa": "חָדְלוּ afirma que as rotas deixaram de funcionar. A BV expressa o resultado social sem dizer que o terreno físico deixou de existir.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“as estradas foram ampliadas”",
          "motivo": "Inverte a cessação."
        },
        {
          "opcao": "“todos viajavam normalmente”",
          "motivo": "Contradiz o desvio seguinte."
        }
      ]
    },
    {
      "questao": "Como preservar a mudança de rota?",
      "escolha": "“seguiam por sendas tortuosas”",
      "justificativa": "Os viajantes de נְתִיבוֹת passam a usar אֳרָחוֹת עֲקַלְקַלּוֹת. “Tortuosas” mantém o desvio sinuoso ou indireto sem nomear a causa.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“viajavam somente por mar”",
          "motivo": "Acrescenta outro meio."
        },
        {
          "opcao": "“ficaram imóveis”",
          "motivo": "Apaga o verbo de caminhar."
        }
      ]
    }
