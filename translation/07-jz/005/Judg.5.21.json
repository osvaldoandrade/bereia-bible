    {
      "questao": "Quem é arrastado pela torrente?",
      "escolha": "“os arrastou”",
      "justificativa": "O sufixo masculino plural de גְּרָפָם retoma os combatentes inimigos no contexto. A BV preserva o objeto pronominal sem nomear novamente reis ou exército.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“arrastou as estrelas”",
          "motivo": "Troca o antecedente contextual."
        },
        {
          "opcao": "“a torrente foi arrastada”",
          "motivo": "Inverte sujeito e objeto."
        }
      ]
    },
    {
      "questao": "Como verter נַחַל קְדוּמִים?",
      "escolha": "“a torrente dos tempos antigos”",
      "justificativa": "קְדוּמִים é plural relacionado a antiguidade ou tempos anteriores. A BV conserva a expressão poética sem identificar outro curso d’água.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“uma torrente recém-criada”",
          "motivo": "Inverte a antiguidade."
        },
        {
          "opcao": "omitir a segunda designação",
          "motivo": "Apaga a aposição."
        }
      ]
    },
    {
      "questao": "Como reconstruir תִּדְרְכִי נַפְשִׁי עֹז?",
      "escolha": "“Avance, minha alma, com força!”",
      "justificativa": "O verbo feminino singular interpela נַפְשִׁי e דרך traz a imagem de pisar ou marchar. “Avance” produz um imperativo natural, e “com” supre a relação com עֹז.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“minha alma retroceda em fraqueza”",
          "motivo": "Inverte verbo e substantivo."
        },
        {
          "opcao": "dirigir o imperativo a Baraque",
          "motivo": "Apaga a primeira pessoa."
        }
      ]
    },
    {
