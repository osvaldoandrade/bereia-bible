      "questao": "Como verter תְּבֹרַךְ מִנָּשִׁים?",
      "escolha": "“Mais bendita que as mulheres”",
      "justificativa": "מִן após o passivo de ברך tem força comparativa. A BV preserva a exaltação de Jael sem afirmar uma bênção litúrgica universal.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“amaldiçoada entre as mulheres”",
          "motivo": "Inverte o verbo."
        },
        {
          "opcao": "“bendita apenas por Héber”",
          "motivo": "Reduz o grupo comparativo."
        }
      ]
    },
    {
      "questao": "Como preservar a repetição final?",
      "escolha": "repetir “mais bendita que as mulheres”",
      "justificativa": "O verso enquadra a identificação de Jael com duas declarações de bênção. A BV mantém o paralelismo e acrescenta “que vivem” apenas para naturalizar בָּאֹהֶל.",
      "alternativas_rejeitadas": [
        {
          "opcao": "omitir a segunda bênção",
          "motivo": "Apaga a moldura poética."
        }
      ]
    },
    {
      "questao": "Quem é Jael?",
      "escolha": "“mulher de Héber, o queneu”",
      "justificativa": "A relação conjugal e o gentílico de Héber são mantidos sem harmonizar outros dados narrativos.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“filha de Héber”",
          "motivo": "Troca a relação familiar."
        },
        {
          "opcao": "“israelita da tribo de Judá”",
          "motivo": "Acrescenta identificação ausente."
        }
      ]
    },
