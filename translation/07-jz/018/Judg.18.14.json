      "questao": "Quais objetos os cinco homens enumeram?",
      "escolha": "Éfode, terafins, imagem esculpida e imagem fundida",
      "justificativa": "A lista preserva os quatro itens אֵפוֹד, תְּרָפִים, פֶסֶל e מַסֵּכָה sem fundi-los num único objeto ou omitir um deles.",
      "alternativas_rejeitadas": [
        {
          "opcao": "Mencionar apenas uma imagem",
          "motivo": "Apaga éfode, terafins e a distinção entre esculpida e fundida."
        },
        {
          "opcao": "Chamar todos de armas",
          "motivo": "Muda sua natureza cultual."
        }
      ]
    },
    {
      "questao": "Como manter o apelo final?",
      "escolha": "“Agora decidam o que vão fazer”",
      "justificativa": "דְּעוּ מַה־תַּעֲשׂוּ exige consideração/decisão dos demais danitas, sem o narrador aprovar o roubo.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“Deus ordena que roubem”",
          "motivo": "Acrescenta sanção divina inexistente."
        }
      ]
    },
