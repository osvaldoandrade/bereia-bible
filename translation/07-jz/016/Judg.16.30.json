      "questao": "O que Sansão declara sobre si?",
      "escolha": "“Que eu morra com os filisteus”",
      "justificativa": "תָּמוֹת נַפְשִׁי mantém morte própria junto aos filisteus; a BV naturaliza “minha alma” como primeira pessoa sem ocultar o desfecho.",
      "alternativas_rejeitadas": [
        {
          "opcao": "que apenas os filisteus morram",
          "motivo": "Omitiria sua própria morte."
        },
        {
          "opcao": "que eu sobreviva ileso",
          "motivo": "Inverte a declaração."
        }
      ]
    },
    {
      "questao": "Qual é a sequência causal?",
      "escolha": "“empurrou ... casa caiu ... sobre governantes e todo o povo”",
      "justificativa": "Sansão aplica força; a casa é sujeito da queda; governantes e totalidade do povo são alvos.",
      "alternativas_rejeitadas": [
        {
          "opcao": "a casa caiu antes de Sansão agir",
          "motivo": "Inverte a sequência."
        },
        {
          "opcao": "caiu somente sobre Sansão",
          "motivo": "Reduz os objetos."
        }
      ]
    },
    {
      "questao": "Qual comparação final é feita?",
      "escolha": "“mais numerosos ... ao morrer ... do que ... em vida”",
      "justificativa": "O comparativo רַבִּים מֵאֲשֶׁר e os dois momentos são mantidos sem fornecer números.",
      "alternativas_rejeitadas": [
        {
          "opcao": "matou menos na morte",
          "motivo": "Inverte o comparativo."
        },
        {
          "opcao": "o mesmo número exato",
          "motivo": "Apaga a superioridade."
        }
      ]
    },
