      "questao": "Quem ocupa a casa?",
      "escolha": "“Homens e mulheres lotavam a casa ... todos os governantes”",
      "justificativa": "A casa cheia e a presença da totalidade dos governantes são afirmações distintas e mantidas.",
      "alternativas_rejeitadas": [
        {
          "opcao": "somente os governantes",
          "motivo": "Omitiria a multidão."
        },
        {
          "opcao": "nenhum governante",
          "motivo": "Contradiz כֹּל."
        }
      ]
    },
    {
      "questao": "Quantos estão no terraço?",
      "escolha": "“No terraço, cerca de três mil pessoas”",
      "justificativa": "כִּשְׁלֹשֶׁת expressa aproximação, e אֲלָפִים, três mil. A BV conserva o “cerca de”.",
      "alternativas_rejeitadas": [
        {
          "opcao": "exatamente trezentos",
          "motivo": "Altera ordem de magnitude e aproximação."
        },
        {
          "opcao": "três mil apenas dentro da casa",
          "motivo": "Troca a localização."
        }
      ]
    },
    {
      "questao": "O que a multidão observa?",
      "escolha": "“assistiam à exibição de Sansão”",
