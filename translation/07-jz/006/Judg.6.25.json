  "decisoes": [
    {
      "questao": "Quantos touros aparecem em פַּר־הַשּׁוֹר ... וּפַר הַשֵּׁנִי?",
      "escolha": "Dois: “o touro ... e o segundo touro”",
      "justificativa": "A coordenação com וּפַר e a retomada “o segundo touro” no v.26 favorecem dois animais, embora a construção inicial seja incomum.",
      "alternativas_rejeitadas": [
        {
          "opcao": "Um único touro descrito duas vezes",
          "motivo": "É possível como leitura apositiva, mas não explica tão diretamente a coordenação nem a designação “segundo”."
        },
        {
          "opcao": "Três touros",
          "motivo": "Não há terceiro sintagma animal."
        }
      ]
    },
    {
      "questao": "Glosa de אֲשֵׁרָה",
      "escolha": "“poste de Aserá”",
      "justificativa": "O verbo cortar e o uso posterior da madeira mostram um objeto cultual de madeira associado a Aserá; a BV mantém o nome próprio.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“uma árvore sem função religiosa”",
          "motivo": "Apaga a associação cultual."
        },
        {
          "opcao": "“altar de Aserá”",
          "motivo": "Troca o tipo de objeto."
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "PRO-1 (peso 1) com 4 pronomes de 3ª pessoa: todos têm antecedente claro — \"seu pai\" refere-se a Gideão (Deus falando a ele), \"dele\" refere-se ao altar de Baal. NTLH também usa \"seu pai\" 2× e \"seu\" para o poste. Sem ambiguidade real. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
  "palavras_supridas": [],
  "ambiguidades_preservadas": [
    "A construção dos touros pode ser entendida como dois animais ou como identificação apositiva do touro de sete anos; a BV segue a leitura de dois e registra a alternativa.",
    "אֲשֶׁר עָלָיו pode indicar que o poste estava sobre, junto ou associado ao altar; “junto dele” evita definir a disposição física exata."
  ],
  "justificativa": "Noite, dois touros, idade do segundo, altar paterno e Aserá são mantidos sem apagar a sintaxe difícil.",
