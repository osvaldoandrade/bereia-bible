  "decisoes": [
    {
      "questao": "Relação de Joás com os acusadores",
      "escolha": "“os que se levantaram contra ele”",
      "justificativa": "עָמְדוּ עָלָיו descreve pessoas postadas contra ou pressionando Joás; a BV preserva a hostilidade sem trocar o alvo pelo altar.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“os que dormiam longe dele”",
          "motivo": "Contradiz posição e confronto."
        },
        {
          "opcao": "“apenas seus servos leais”",
          "motivo": "Não corresponde à exigência de morte anterior."
        }
      ]
    },
    {
      "questao": "Valor temporal de עַד־הַבֹּקֶר",
      "escolha": "“ainda nesta manhã”",
      "justificativa": "A cena começou pela manhã; a expressão pode significar até a manhã ou enquanto ainda é manhã. A BV segue a leitura imediata e registra a dificuldade.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“daqui a muitos anos”",
          "motivo": "Apaga o prazo."
        },
        {
          "opcao": "“ontem à noite”",
          "motivo": "Contradiz a orientação temporal."
        }
      ]
    },
    {
      "questao": "Argumento sobre Baal",
      "escolha": "“Se ele é um deus, que contenda por si mesmo”",
      "justificativa": "Joás desloca a defesa aos poderes atribuídos a Baal e preserva os verbos contender/salvar.",
      "alternativas_rejeitadas": [
        {
          "opcao": "Joás promete reconstruir pessoalmente o altar",
          "motivo": "Não aparece na fala."
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "PRO-1 (peso 1) com 4 pronomes de 3ª pessoa: todos referem-se a Baal, antecedente inequívoco no contexto do discurso de Joás. A BV emprega corretamente o paradigma vocês (§3/D-0003: discurso humano↔humano), enquanto ARA usa paradigma vós (\"Contendereis vós...livrá-lo-eis vós?\") — a normalização da BV está correta. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
