          "motivo": "Não corresponde ao lexema nem à função."
        },
        {
          "opcao": "“mão vazia”",
          "motivo": "Apaga o instrumento."
        }
      ]
    },
    {
      "questao": "Valor de הָלַךְ מֵעֵינָיו",
      "escolha": "“desapareceu da vista de Gideão”",
      "justificativa": "O idioma afirma que o mensageiro deixou de estar visível; a BV não acrescenta direção ou mecanismo.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“caminhou lentamente até outra cidade”",
          "motivo": "Especifica um modo de saída ausente."
        },
        {
          "opcao": "“permaneceu visível”",
          "motivo": "Inverte a expressão."
        }
      ]
    },
