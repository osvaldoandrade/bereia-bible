      "questao": "Como preservar o agente e o critério da prova?",
      "escolha": "o SENHOR prova o povo e determina individualmente quem irá",
      "justificativa": "O singular sufixado em וְאֶצְרְפֶנּוּ trata o povo como coletivo; as fórmulas demonstrativas distinguem os aprovados dos rejeitados sem revelar antecipadamente o critério.",
      "alternativas_rejeitadas": [
        {
          "opcao": "Gideão escolhe por preferência pessoal",
          "motivo": "Transfere a decisão que o SENHOR reivindica."
        },
        {
          "opcao": "todos irão depois da prova",
          "motivo": "Contraria a dupla determinação “irá/não irá”."
        }
      ]
    },
