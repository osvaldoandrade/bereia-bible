  "decisoes": [
    {
      "questao": "Como preservar a lista e בְּנוֹתֶיהָ?",
      "escolha": "cinco centros, cada um com suas cidades dependentes",
      "justificativa": "“Filhas” é uma metáfora territorial para núcleos subordinados. A repetição do sufixo feminino é mantida em cada entrada sem fundir os conjuntos.",
      "alternativas_rejeitadas": [
        {
          "opcao": "filhas humanas das cidades",
          "motivo": "Lê literalmente a metáfora e quebra a taxonomia geográfica."
        },
        {
          "opcao": "somente Bete-Seã e Megido",
          "motivo": "Omite Taanaque, Dor e Ibleão."
        }
      ]
    },
    {
      "questao": "Como verter וַיּוֹאֶל?",
      "escolha": "“insistiram em permanecer”",
      "justificativa": "O hifil de יאל exprime disposição resoluta ou insistência do coletivo cananeu em habitar a terra.",
      "alternativas_rejeitadas": [
        {
          "opcao": "foram expulsos imediatamente",
          "motivo": "Contradiz a permanência."
        },
        {
          "opcao": "Manassés decidiu sair",
          "motivo": "Troca o sujeito."
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "RED-1 flagra a repetição de “cidades dependentes” (5×), mas o hebraico repete וְאֶת־בְּנֹתֶיהָ (“e suas filhas/cidades”) para cada localidade — é lista formular do original, não redundância espúria. PRO-1 flagra pronomes “suas”, mas cada um tem antecedente claro (a cidade imediatamente anterior). Ambos são falsos-positivos. ARA também repete a fórmula (“suas vilas” para cada cidade). (ER-0019 v2).",
