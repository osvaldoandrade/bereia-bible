    {
      "questao": "Quais elementos compõem a confissão?",
      "escolha": "“Pecamos contra ti: abandonamos nosso Deus e servimos aos baalins”",
      "justificativa": "A confissão geral חָטָאנוּ לָךְ é seguida por duas ações concretas: abandono do próprio Deus e serviço aos baalins. Os dois-pontos apresentam a especificação sem eliminar a coordenação.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“Não pecamos”",
          "motivo": "Inverte a confissão."
        },
        {
          "opcao": "“abandonamos os baalins para servir ao SENHOR”",
          "motivo": "Troca os objetos dos dois verbos."
        }
      ]
    },
    {
      "questao": "Como tratar a mudança entre SENHOR e ‘nosso Deus’ no discurso?",
      "escolha": "Manter “ao SENHOR” na moldura e “nosso Deus” na confissão",
      "justificativa": "O narrador nomeia o destinatário como יהוה, enquanto os israelitas dizem אֱלֹהֵינוּ. A BV preserva a autoidentificação pactual dentro da confissão.",
      "alternativas_rejeitadas": [
        {
          "opcao": "substituir “nosso Deus” por “os deuses”",
          "motivo": "Altera número, posse e referente."
        }
      ]
    },
