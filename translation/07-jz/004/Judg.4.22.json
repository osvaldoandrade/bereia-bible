      "questao": "Quem procura Sísera e quem sai ao encontro?",
      "escolha": "Baraque persegue; Jael sai ao encontro dele",
      "justificativa": "O particípio masculino identifica Baraque como perseguidor; o verbo feminino identifica Jael como quem o recebe.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“Sísera perseguia Baraque”",
          "motivo": "Inverteria perseguidor e procurado."
        }
      ]
    },
    {
      "questao": "O que Jael promete mostrar?",
      "escolha": "“o homem que você procura”",
      "justificativa": "A expressão mantém o referente humano sem antecipar dentro da fala a declaração de morte.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“um exército que você não procura”",
          "motivo": "Mudaria objeto e número."
        }
      ]
    },
    {
      "questao": "Qual cena Baraque encontra?",
      "escolha": "“Sísera caído, morto, com a estaca na têmpora”",
      "justificativa": "Os particípios e o sintagma corporal retomam diretamente o resultado do verso anterior, preservando a ironia da busca encerrada por Jael.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“Sísera vivo e armado”",
          "motivo": "Contradiria a cena."
        }
      ]
    },
