  "decisoes": [
    {
      "questao": "Como preservar שָׁכֹחַ תִּשְׁכַּח e אָבֹד תֹּאבֵדוּן?",
      "escolha": "“realmente se esquecer” e “certamente perecerão”",
      "justificativa": "Os infinitivos absolutos intensificam os verbos finitos; advérbios enfáticos reproduzem a força sem calque impossível.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“esquecendo esquecerá” e “perecendo perecerão”",
          "motivo": "Preserva a forma, mas é inaceitavelmente artificial no texto publicado."
        },
        {
          "opcao": "“talvez se esqueça” e “poderão perecer”",
          "motivo": "Enfraquece ambas as intensificações."
        }
      ]
    },
    {
      "questao": "Como tratar a mudança de singular para plural?",
      "escolha": "“se você ... testemunho contra vocês ... perecerão”",
      "justificativa": "Os verbos de esquecer, seguir, servir e curvar-se são singulares; בָכֶם e תֹאבֵדוּן são plurais.",
      "alternativas_rejeitadas": [
        {
          "opcao": "uniformizar no singular",
          "motivo": "Apaga a responsabilização coletiva no anúncio da consequência."
        },
        {
          "opcao": "uniformizar no plural",
          "motivo": "Apaga o endereço singular que estrutura a advertência individual-coletiva."
        }
      ]
    }
