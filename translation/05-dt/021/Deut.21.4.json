  "decisoes": [
    {
      "questao": "Como verter נַחַל אֵיתָן?",
      "escolha": "“vale de corrente perene”",
      "justificativa": "A escolha combina a feição de vale de curso d’água com a noção de permanência de אֵיתָן, sem modernizar sua geografia.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“rio canalizado”",
          "motivo": "Importa uma obra hidráulica ausente."
        },
        {
          "opcao": "“vale rochoso”",
          "motivo": "É possível, mas fixa a alternativa de terreno áspero em vez da permanência."
        }
      ]
    },
    {
      "questao": "Como verter וְעָרְפוּ?",
      "escolha": "“quebrarão o pescoço”",
      "justificativa": "O verbo descreve quebra da nuca; não deve ser substituído por linguagem sacrificial genérica.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“oferecerão no altar”",
          "motivo": "Acrescenta altar e categoria sacrificial ausentes."
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "BV opta pela compressão nominal 'vale de corrente perene' em vez das formas expandidas das referências ('vale de águas correntes' ARA, 'vale onde haja um ribeiro de águas perenes' NVIPT, 'vale onde haja um ribeirão que nunca seca' NTLH). A escolha é legítima: 'corrente perene' transmite o sentido de curso d'água permanente e não configura arcaísmo nem inconsistência; trata-se de concisão estilística. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
  "palavras_supridas": [
    "a terra"
  ],
  "ambiguidades_preservadas": [
    "נַחַל אֵיתָן pode descrever corrente perene, vale de solo firme ou vale inculto; a BV escolhe a primeira leitura e registra as demais."
