      "alternativas_rejeitadas": [
        {
          "opcao": "usar somente “vocês” em todo o verso",
          "motivo": "Apaga a passagem ao singular coletivo."
        },
        {
          "opcao": "usar somente “você”",
          "motivo": "Apaga o plural inicial."
        }
      ]
    },
    {
      "questao": "Como verter וְשַׂדְתָּ ... בַּשִּׂיד?",
