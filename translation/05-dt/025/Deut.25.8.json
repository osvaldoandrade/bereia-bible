    {
      "questao": "Como verter וְעָמַד neste diálogo?",
      "escolha": "“Ele se apresentará”",
      "justificativa": "O verbo descreve o homem tomando posição diante dos anciãos para declarar sua recusa. “Apresentará” preserva a postura processual sem criar uma nova condição.",
      "alternativas_rejeitadas": [
        {
          "opcao": "ele foge dos líderes",
          "motivo": "Acrescenta movimento ausente."
        },
        {
          "opcao": "ele aceita o casamento",
          "motivo": "Contradiz sua fala."
        }
      ]
    },
    {
      "questao": "Qual é a declaração do homem?",
      "escolha": "“Não quero tomá-la por esposa”",
      "justificativa": "A primeira pessoa preserva a recusa do próprio homem; “por esposa” recupera o sentido marital do contexto.",
      "alternativas_rejeitadas": [
        {
          "opcao": "os líderes não querem tomá-la",
          "motivo": "Troca o falante."
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "NTLH/ARA/NVIPT incluem nuance de persistência (“se ele insistir/persistir”), enquanto a BV diz “Ele se apresentará”. A traducao_literal apoia a BV (“e ficará de pé e dirá”); a divergência é de interpretação do hebraico, não de forma. Mudar exigiria alteração de sentido — vedada ao revisor editorial. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
