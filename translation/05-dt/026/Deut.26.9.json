  "decisoes": [
    {
      "questao": "Como verter זָבַת חָלָב וּדְבָשׁ?",
      "escolha": "“terra que produz leite e mel em abundância”",
      "justificativa": "A BV naturaliza a metáfora de fluxo sem retirar os dois produtos.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“terra literalmente feita de leite”",
          "motivo": "Materializa indevidamente a imagem."
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "ARA e NVIPT usam o verbo “manar” (“terra que mana leite e mel” / “terra onde manam leite e mel”), enquanto a BV optou por “produz…em abundância”. A divergência é de escolha tradutória (imagem de fluir vs. produzir), não de forma defeituosa: “produzir em abundância” é pt-BR natural e transmite o mesmo conteúdo semântico. NTLH também diverge (“terra boa e rica”). Substituir o verbo seria alteração de sentido (troca de imagem), o que excede o escopo da revisão de forma. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
