      "questao": "Como verter הַחֶסֶד e לְאֶלֶף דּוֹר?",
      "escolha": "“amor leal” e “por mil gerações”",
      "justificativa": "חֶסֶד expressa bondade comprometida no âmbito da aliança. O numeral אֶלֶף com דּוֹר explicita mil gerações, não apenas “milhares” sem referente.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“sentimento passageiro”",
          "motivo": "Não corresponde à lealdade de aliança."
        },
        {
          "opcao": "“algumas gerações”",
          "motivo": "Reduz o numeral expresso."
        }
      ]
    },
