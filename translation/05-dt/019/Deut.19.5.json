      "questao": "וְנָשַׁל הַבַּרְזֶל מִן־הָעֵץ",
      "escolha": "“o ferro se solta do cabo”",
      "justificativa": "“O ferro” é a cabeça do machado, e “a madeira” funciona naturalmente como o cabo de que ela se desprende. O texto BV explicita esses referentes para tornar o acidente compreensível.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“o machado escapa da árvore”",
          "motivo": "Confunde a lâmina com a ferramenta inteira e a origem do desprendimento."
        },
        {
          "opcao": "“ele lança o ferro contra o próximo”",
          "motivo": "Transforma acidente em ação intencional."
        }
      ]
    },
    {
      "questao": "וּמָצָא אֶת־רֵעֵהוּ",
      "escolha": "“atinge seu próximo”",
      "justificativa": "מצא literalmente “encontra”, mas com objeto pessoal no encadeamento do acidente descreve a lâmina alcançando ou acertando a vítima.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“encontra o próximo na floresta”",
          "motivo": "Desliga o verbo do ferro e não explica a morte."
        }
      ]
    }
