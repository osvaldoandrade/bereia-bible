      "escolha": "“pelo depoimento de duas ou três testemunhas”",
      "justificativa": "“Sobre a boca” é idioma de prova oral; os números dois e três são preservados, sem generalizar para maioria indeterminada.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“por várias testemunhas”",
          "motivo": "Apaga os números legais expressos."
        },
        {
          "opcao": "“por duas testemunhas apenas”",
          "motivo": "Exclui a alternativa explícita de três."
        }
      ]
    },
