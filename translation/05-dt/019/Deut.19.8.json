        {
          "opcao": "“que falou dar”",
          "motivo": "Calque preservado na literal, mas agramatical no publicado."
        },
        {
          "opcao": "“que já entregou”",
          "motivo": "Antecipa como consumada a condição futura do verso."
        }
      ]
    },
