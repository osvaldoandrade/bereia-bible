  "decisoes": [
    {
      "questao": "גֹּאֵל הַדָּם",
      "escolha": "“vingador do sangue”",
      "justificativa": "גאל normalmente envolve resgate ou reivindicação familiar; neste contexto o parente reivindica o sangue da vítima. A glosa jurídica tradicional distingue seu papel do homicida.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“redentor do sangue”",
          "motivo": "Calque lexical obscurece a função de perseguição e morte descrita."
        },
        {
          "opcao": "“carrasco estatal”",
          "motivo": "Transfere a ação para uma instituição não nomeada."
        }
      ]
    },
    {
      "questao": "כִּי־יֵחַם לְבָבוֹ e וְהִכָּהוּ נָפֶשׁ",
      "escolha": "“com o coração inflamado” e “tirando-lhe a vida”",
      "justificativa": "O primeiro idioma descreve ardor emocional; o segundo indica golpe mortal. A BV não suaviza a violência nem atribui legitimidade ao ato.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“em legítima defesa”",
          "motivo": "Não aparece no texto."
        },
        {
          "opcao": "“ferindo-o levemente”",
          "motivo": "Contradiz נֶפֶשׁ e a ausência de sentença de morte que torna a morte injusta."
        }
      ]
    },
    {
      "questao": "Revisão editorial do texto_bv",
      "escolha": "embora o homicida não mereça → embora não mereça",
      "justificativa": "Eliminação de redundância do sujeito (“o homicida” já mencionado na oração principal) para reduzir sentença de 41 para 39 palavras, abaixo do limite de §1.3. Referente inequívoco. — revisão de forma sem alteração de sentido (ER-0019).",
