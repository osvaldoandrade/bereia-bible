  "decisoes": [
    {
      "questao": "Como representar אִשָּׁה חֲדָשָׁה?",
      "escolha": "“tiver se casado recentemente”",
      "justificativa": "O adjetivo qualifica a condição matrimonial recém-iniciada, não a idade da mulher nem necessariamente uma esposa adicional.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“tomar uma mulher jovem”",
          "motivo": "חָדָשׁ significa nova/recente, não jovem."
        },
        {
          "opcao": "“adquirir outra esposa”",
          "motivo": "Introduz poligamia não afirmada no verso."
        }
      ]
    },
    {
      "questao": "Quem deve alegrar quem em וְשִׂמַּח אֶת־אִשְׁתּוֹ?",
      "escolha": "“[ele] alegrará a mulher com quem se casou”",
      "justificativa": "O marido é o agente do piel e a esposa é o objeto. A BV não transforma a frase apenas em felicidade mútua ou benefício individual do homem.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“será feliz com sua mulher”",
          "motivo": "Troca a transitividade e apaga a responsabilidade do marido."
        },
        {
          "opcao": "“a mulher o alegrará”",
          "motivo": "Inverte agente e objeto."
        }
      ]
    }
  ],
  "palavras_supridas": [
