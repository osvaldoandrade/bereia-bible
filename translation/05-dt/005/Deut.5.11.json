    {
      "questao": "Como verter לֹא תִשָּׂא אֶת־שֵׁם־יְהוָה?",
      "escolha": "“Não use o nome do SENHOR”",
      "justificativa": "נָשָׂא significa levantar, carregar ou tomar. No idioma do mandamento, “usar” comunica a aplicação do nome sem restringi-la à mera pronúncia.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“não escreva o nome”",
          "motivo": "Restringe o verbo a uma ação não indicada."
        },
        {
          "opcao": "“não pronuncie jamais”",
          "motivo": "Transforma uso falso ou vazio em proibição absoluta de fala."
        }
      ]
    },
    {
      "questao": "Como preservar שָׁוְא?",
      "escolha": "“em falsidade ou de modo vazio”",
      "justificativa": "שָׁוְא abrange falsidade, inutilidade, vazio e fraude. A dupla formulação portuguesa mantém a amplitude sem escolher apenas juramento falso ou banalidade.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“somente por engano acidental”",
          "motivo": "Estreita o campo sem base."
        },
        {
          "opcao": "“para qualquer finalidade”",
          "motivo": "Apaga a qualificação negativa."
        }
      ]
    }
  ],
