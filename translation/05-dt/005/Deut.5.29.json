    {
      "questao": "Como verter מִי־יִתֵּן?",
      "escolha": "“Quem dera”",
      "justificativa": "A fórmula idiomática expressa desejo intenso, não uma pergunta informativa sobre a identidade de um doador. A BV mantém o anseio divino.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“quem lhes venderá”",
          "motivo": "Transforma o idioma em transação."
        },
        {
          "opcao": "“não desejo que tenham esse coração”",
          "motivo": "Inverte a vontade expressa."
        }
      ]
    },
    {
      "questao": "O que caracteriza “um coração assim”?",
      "escolha": "Temer o SENHOR e guardar todos os mandamentos sempre",
      "justificativa": "O verso define o coração pela disposição duradoura de reverência e obediência, com benefício para o povo e seus filhos.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“emoção momentânea sem obediência”",
          "motivo": "Separa o coração das finalidades explicitadas."
        },
        {
          "opcao": "“benefício somente para a geração presente”",
          "motivo": "Omite os filhos e “para sempre”."
        }
      ]
    },
