    {
      "questao": "Quem é abrangido pela cessação do trabalho?",
      "escolha": "O destinatário, sua família, servos, animais e estrangeiro residente",
      "justificativa": "A BV conserva todos os membros da lista e não limita o descanso ao chefe da casa.",
      "alternativas_rejeitadas": [
        {
          "opcao": "omitir servos ou estrangeiro residente",
          "motivo": "Apaga grupos explicitamente incluídos."
        },
        {
          "opcao": "omitir boi, jumento ou demais animais",
          "motivo": "Reduz a abrangência da ordem."
        }
      ]
    },
    {
      "questao": "Como preservar לְמַעַן יָנוּחַ ... כָּמוֹךָ?",
      "escolha": "“para que ... descansem como você”",
      "justificativa": "A finalidade social do sábado é explícita: servo e serva recebem descanso comparável ao do destinatário.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“para que trabalhem por você”",
          "motivo": "Inverte יָנוּחַ."
        },
        {
          "opcao": "“para que somente você descanse”",
          "motivo": "Exclui os beneficiários nomeados."
        }
      ]
    },
    {
