      "questao": "Como verter וְעָנְתָה ... לְעֵד?",
      "escolha": "“responderá diante dele como testemunha”",
      "justificativa": "O cântico personificado dá resposta ou depoimento quando chegam as calamidades. A BV mantém a ação verbal e sua função testemunhal.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“ficará em silêncio e sem valor”",
          "motivo": "Inverte resposta e testemunho."
        }
      ]
    },
    {
      "questao": "Como verter לֹא תִשָּׁכַח מִפִּי זַרְעוֹ?",
      "escolha": "“continuará na boca de seus descendentes”",
      "justificativa": "A negativa passiva é reestruturada positivamente: o cântico não desaparecerá da recitação da descendência. “Boca” permanece explícita.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“será esquecido por todos”",
          "motivo": "Inverte a negativa."
        },
        {
          "opcao": "“ficará apenas num arquivo, nunca recitado”",
          "motivo": "Apaga a boca dos descendentes."
        }
      ]
    },
    {
      "questao": "Como verter יִצְרוֹ?",
      "escolha": "“a inclinação”",
      "justificativa": "יֵצֶר é formação, disposição ou inclinação interior. O contexto aponta para a tendência já demonstrada pelo povo.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“um objeto físico construído”",
          "motivo": "Ignora o referente comportamental."
        },
        {
          "opcao": "“arrependimento futuro certo”",
          "motivo": "Inverte a previsão."
        }
      ]
    }
