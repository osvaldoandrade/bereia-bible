      "questao": "Como preservar as mudanças singular/plural?",
      "escolha": "“contra ele”; “os abandonarei... deles”; “ele... o alcançarão”",
      "justificativa": "O povo aparece primeiro no singular, passa ao plural como grupo de pessoas e retorna ao singular personificado. A BV mantém cada mudança.",
      "alternativas_rejeitadas": [
        {
          "opcao": "uniformizar tudo em “eles”",
          "motivo": "Apaga o singular coletivo."
        },
        {
          "opcao": "uniformizar tudo em “ele”",
          "motivo": "Apaga os objetos plurais de abandono e ocultação."
        }
      ]
    },
    {
      "questao": "Como verter וְהָיָה לֶאֱכֹל?",
      "escolha": "“ficará exposto para ser devorado”",
      "justificativa": "A construção “será para comer” apresenta o povo como presa entregue ao consumo. A BV mantém a violência da imagem.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“será alimentado e protegido”",
          "motivo": "Inverte o sentido."
        },
        {
          "opcao": "“terá apenas fome leve”",
          "motivo": "Reduz a metáfora de devoração."
        }
      ]
    }
  ],
