  "decisoes": [
    {
      "questao": "Como verter לֵרָאוֹת אֶת־פְּנֵי יְהוָה?",
      "escolha": "“comparecer diante do SENHOR”",
      "justificativa": "O infinitivo nifal expressa apresentar-se ou ser visto diante da face do SENHOR, não contemplá-lo fisicamente.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“ver fisicamente o rosto de Deus”",
          "motivo": "Lê o nifal como qal e cria afirmação não exigida."
        },
        {
          "opcao": "“não comparecer”",
          "motivo": "Inverte a finalidade da peregrinação."
        }
      ]
    },
    {
      "questao": "Como verter בְּאָזְנֵיהֶם?",
      "escolha": "“para que todos a ouçam”",
      "justificativa": "“Nos ouvidos deles” é idioma de leitura audível. A BV mantém a audiência integral como destinatária.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“ler secretamente para si”",
          "motivo": "Contradiz a leitura diante de todo Israel."
        }
      ]
    },
    {
      "questao": "Revisão editorial do texto_bv",
      "escolha": "leia esta Torá → leiam esta Torá",
      "justificativa": "Consistência de número no imperativo: o destinatário é coletivo (sacerdotes + anciãos + líderes, verso 9), e o imperativo do verso seguinte é plural (“Reúnam”, v.12). NTLH e NVIPT usam “leiam”; ARA usa “lereis”. Normalizado para plural (vocês) conforme D-0003. — revisão de forma sem alteração de sentido (ER-0019).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    },
