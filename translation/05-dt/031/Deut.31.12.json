  "decisoes": [
    {
      "questao": "Como preservar o destinatário singular e o possessivo plural?",
      "escolha": "“Reúna”; “o Deus de vocês”",
      "justificativa": "O imperativo e “suas cidades” dirigem-se a um responsável singular; depois אֱלֹהֵיכֶם trata a assembleia no plural. A BV mantém a mudança.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“Reúnam”",
          "motivo": "Apaga o imperativo singular."
        },
        {
          "opcao": "“seu Deus” na cláusula final",
          "motivo": "Apaga o sufixo plural."
        }
      ]
    },
    {
      "questao": "Quem deve ser reunido?",
      "escolha": "“homens, mulheres, crianças e o estrangeiro residente”",
      "justificativa": "As quatro categorias são explicitamente coordenadas sob “o povo”. טַף inclui os pequenos, e גֵּר é o estrangeiro residente nas cidades; os verbos seguintes mantêm audição, aprendizagem, temor e prática como ações distintas.",
      "alternativas_rejeitadas": [
        {
          "opcao": "omitir mulheres ou crianças",
          "motivo": "Reduz a assembleia."
        },
        {
          "opcao": "“visitante ocasional fora da comunidade”",
          "motivo": "Enfraquece a residência de גֵּר."
        }
      ]
    },
    {
      "questao": "Revisão editorial do texto_bv",
      "escolha": "Reúna o povo → Reúnam o povo",
      "justificativa": "Consistência de número no imperativo: os destinatários são os líderes coletivos (v.9); os imperativos subsequentes no verso são plurais (“ouçam”, “aprendam”, “tenham”). NTLH e NVIPT usam “Reúnam”; ARA usa “Congregai”. Normalizado para plural (vocês) conforme D-0003. — revisão de forma sem alteração de sentido (ER-0019).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
