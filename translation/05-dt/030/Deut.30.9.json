        {
          "opcao": "deixará você abandonado",
          "motivo": "Confunde יתר com abandono."
        },
        {
          "opcao": "prosperará somente o solo",
          "motivo": "Omitiria trabalho, ventre e animais."
        }
      ]
    },
    {
      "questao": "Como preservar a alegria do SENHOR?",
      "escolha": "“voltará a se alegrar em fazer bem a você”",
      "justificativa": "שוב marca renovação, שוש atribui alegria ao SENHOR, e לְטוֹב liga essa alegria ao benefício de Israel.",
      "alternativas_rejeitadas": [
        {
          "opcao": "Israel se alegra em fazer bem ao SENHOR",
          "motivo": "Inverte sujeito e beneficiário."
        }
      ]
