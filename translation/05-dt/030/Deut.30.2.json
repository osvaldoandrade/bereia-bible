    {
      "questao": "Como preservar retorno e obediência como ações distintas?",
      "escolha": "“retornar ao SENHOR ... e obedecer à voz dele”",
      "justificativa": "שוב marca a volta ao SENHOR, e שמע בקול marca escutar com resposta obediente. Nenhum dos dois verbos é omitido.",
      "alternativas_rejeitadas": [
        {
          "opcao": "apenas retornar geograficamente",
          "motivo": "O objeto do retorno é o SENHOR."
        },
        {
          "opcao": "ouvir sem obedecer",
          "motivo": "Enfraquece o idioma שמע בקול."
        }
      ]
    },
    {
      "questao": "Quem participa e com qual disposição?",
      "escolha": "“você e seus filhos ... de todo o coração e de toda a alma”",
      "justificativa": "O singular coletivo é ampliado pelos filhos, e as duas expressões de totalidade são mantidas sem uniformizar os referentes.",
      "alternativas_rejeitadas": [
        {
          "opcao": "somente a geração presente",
          "motivo": "Omitiria וּבָנֶיךָ."
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "Achado PRO-1 (4 pronomes de 3ª pessoa): todos os pronomes têm referência inequívoca — “dele” refere-se a Deus, “lhe” a Moisés falando ao povo, “seus filhos” é possessivo de “você”. Uso padrão do paradigma você (§3). NTLH/NVIPT usam plural; BV segue o singular do hebraico, coerente com o capítulo. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
