      "questao": "Como verter יַד הָעֵדִים ... וְיַד כָּל־הָעָם?",
      "escolha": "“As testemunhas serão as primeiras... depois... todo o povo”",
      "justificativa": "“Mão” representa participação ativa na execução. A BV mantém a ordem dos agentes sem acrescentar um gesto não repetido neste verso.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“as testemunhas não participam”",
          "motivo": "Inverte a responsabilidade expressa."
        },
        {
          "opcao": "nomear apenas o povo",
          "motivo": "Apaga a precedência das testemunhas."
        }
      ]
    },
    {
      "questao": "Como verter וּבִעַרְתָּ הָרָע?",
      "escolha": "“eliminará o mal”",
      "justificativa": "בער no piel é fórmula jurídica de remover completamente o mal do corpo social. A literal conserva o calque “queimará”.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“tolerará o mal”",
          "motivo": "Inverte o verbo."
        }
      ]
