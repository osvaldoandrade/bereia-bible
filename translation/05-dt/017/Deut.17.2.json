      "questao": "Como verter בְּאַחַד שְׁעָרֶיךָ?",
      "escolha": "“em uma das cidades” no texto BV; “em um dos portões” na literal",
      "justificativa": "“Portões” funciona metonimicamente para os assentamentos sob jurisdição local. A BV evita situar a pessoa apenas na estrutura física do portão.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“fora de todas as cidades”",
          "motivo": "Inverte a localização."
        }
      ]
    },
    {
      "questao": "Como verter לַעֲבֹר בְּרִיתוֹ?",
      "escolha": "“violando a aliança dele”",
      "justificativa": "עבר com בְּרִית descreve transgredir ou ultrapassar os termos da aliança. “Violar” mantém o caráter jurídico-relacional.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“renovando a aliança”",
          "motivo": "Inverte a transgressão."
        }
      ]
    },
