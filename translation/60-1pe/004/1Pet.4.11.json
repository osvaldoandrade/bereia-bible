  "decisoes": [
    {
      "questao": "λόγια Θεοῦ — glosa",
      "escolha": "\"oráculos de Deus\"",
      "justificativa": "λόγιον é termo técnico para os ditos/revelações divinas (cf. Rm 3.2, At 7.38), distinto do λόγος comum; \"oráculos\" preserva esse peso técnico.",
      "alternativas_rejeitadas": [
        {
          "opcao": "palavras de Deus",
          "motivo": "nivela λόγια a λόγος, apagando o termo técnico específico"
        }
      ]
    },
    {
      "questao": "εἴ τις λαλεῖ / εἴ τις διακονεῖ — elipse do verbo principal",
      "escolha": "suprir \"que fale\"/\"que sirva\"",
      "justificativa": "O grego é elíptico (condicional sem apódose expressa, subentendendo um imperativo de 3ª pessoa); o português exige verbo explícito para não soar agramatical.",
      "alternativas_rejeitadas": []
    },
    {
      "questao": "εἰς τοὺς αἰῶνας τῶν αἰώνων — fórmula doxológica",
      "escolha": "\"para todo o sempre\"",
      "justificativa": "Fórmula litúrgica fixa; \"para todo o sempre\" é o equivalente idiomático consolidado em português, preservando o sentido de duração sem soar artificial na leitura corrente.",
      "alternativas_rejeitadas": [
        {
          "opcao": "pelos séculos dos séculos",
          "motivo": "calque tradicional válido, mantido na traducao_literal; no publicado optou-se pela forma mais corrente em prosa"
        }
      ]
    }
  ],
  "palavras_supridas": [
    "que fale (elipse de λαλείτω, subentendido pelo condicional)",
    "que sirva (elipse de διακονείτω, subentendido pelo condicional)"
  ],
  "ambiguidades_preservadas": [],
  "justificativa": "Estrutura paralela εἴ τις...ὡς / εἴ τις...ὡς preservada; doxologia final (ᾧ ἐστιν ἡ δόξα...) mantida como unidade litúrgica fechada por ἀμήν.",
