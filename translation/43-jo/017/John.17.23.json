      "alternativas_rejeitadas": []
    },
    {
      "questao": "Glosa de 'τετελειωμένοι' (τελειόω)",
      "escolha": "'completados', mantendo a mesma raiz lexical já fixada para τελειόω em Jo 4:34 ('completar')",
      "justificativa": "EDITORIAL §11: consistência terminológica com a glosa já usada no Evangelho de João para este verbo, em vez da tradução tradicional 'aperfeiçoados'.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'aperfeiçoados' (tradição Almeida/ARA)",
          "motivo": "quebra a consistência lexical com a glosa 'completar' já fixada para τελειόω em Jo 4:34"
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "As três referências divergem da BV na expressão τετελειωμένοι εἰς ἕν: NTLH \"completamente unidos\", ARA \"perfeitos em unidade\", NVIPT \"levados à plena unidade\". A BV \"completados em um\" preserva a construção grega εἰς ἕν (\"em um\") de forma mais literal e é leitura válida. Alternativas exigiriam escolher metáfora diferente (perfeição vs completude vs união), o que é decisão semântica. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
