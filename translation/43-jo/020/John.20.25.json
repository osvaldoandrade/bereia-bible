  "decisoes": [
    {
      "questao": "οὐ μὴ πιστεύσω — negação enfática dupla (subjuntivo aoristo + οὐ μή).",
      "escolha": "'de forma alguma crerei' no publicado, preservando a força enfática",
      "justificativa": "οὐ μή + subjuntivo é a negação mais forte disponível em grego koiné; 'de forma alguma' capta essa ênfase melhor que um simples 'não'.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'não crerei' (negação simples)",
          "motivo": "perde a ênfase retórica da dupla negação grega"
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "RED-1: a dupla ocorrência de \"pregos\" e de \"puser\" reproduz a estrutura condicional tripla do grego (três cláusulas ἐὰν μὴ); é paralelismo formular do original, não redundância acidental — NVIPT também repete \"pregos\" duas vezes. PRO-1: os pronomes de 3ª pessoa (\"suas mãos\", \"dele\") têm antecedentes inequívocos (Jesus) no contexto imediato da fala de Tomé; não há ambiguidade referencial. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "RED-1: “puser” aparece duas vezes em cláusulas paralelas (“puser o meu dedo… puser a minha mão”), reproduzindo o paralelismo condicional da fala de Tomé no grego — fórmula intencional mantida por NVIPT (“não colocar…não puser”) e ARA. PRO-1: os pronomes “suas/dele/meu” são semanticamente necessários para distinguir as mãos de Jesus (“suas”), o lado de Jesus (“dele”) e as ações do próprio Tomé (“meu dedo/minha mão”); todas as referências usam pronomes equivalentes sem ambiguidade. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    },
