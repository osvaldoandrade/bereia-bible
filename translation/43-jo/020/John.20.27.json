    {
      "questao": "Imperativos de Jesus a Tomé (2ª pessoa singular) — registro 'você' ou 'tu'?",
      "escolha": "'você' no publicado, conforme ER-0003 (discurso de Jesus a um humano, fora de oração)",
      "justificativa": "Mantém a coerência de registro do capítulo (vv. 15, 17, 21); a traducao_literal usa 'tu/teu' para espelhar a morfologia singular grega.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'tu' no publicado (tradição consolidada)",
          "motivo": "contraria o registro ratificado editorialmente para discurso não-orante"
        }
      ]
    },
    {
      "questao": "πιστός (adjetivo, 'fiel/crente') em paralelo com ἄπιστος ('incrédulo').",
      "escolha": "'creia' (verbo) no publicado, para fluência",
      "justificativa": "O par adjetival grego soa redundante em tradução direta ('incrédulo... crente'); o verbo final dá clareza de exortação. A literal preserva o par adjetival 'incrédulo... crente'.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'crente' (adjetivo, calque direto)",
          "motivo": "mantém o paralelismo formal, mas soa menos natural como desfecho da exortação"
        }
      ]
    }
