  "decisoes": [
    {
      "questao": "Repetição enfática de ἡ ἐμή (possessivo pospositivo) três vezes no verso",
      "escolha": "preservar a repetição na traducao_literal ('o reino, o meu'); normalizar para 'o meu reino' no publicado",
      "justificativa": "Aplicação ao grego do mesmo princípio da doutrina do calque (ER-0013, formulada para o hebraico mas extensível a repetição formular greco-joanina): a camada literal carrega a ênfase repetida do original; o publicado normaliza para soar natural em português.",
      "alternativas_rejeitadas": [
        {
          "opcao": "repetir 'o meu reino' três vezes também no publicado",
          "motivo": "soaria artificial e redundante em português contemporâneo, sem ganho de sentido — a ênfase possessiva já é clara com uma repetição"
        }
      ]
    },
    {
      "questao": "ὑπηρέται ('meus guardas/servos') — mesma glosa dos guardas que prendem Jesus (vv.3,12,18,22)?",
      "escolha": "manter 'guardas', preservando o eco lexical irônico",
      "justificativa": "O mesmo termo grego usado para os guardas do templo/da coorte que prendem Jesus é usado aqui para os hipotéticos defensores de Jesus, contraste retórico proposital do texto (guardas que prendem vs. guardas que 'lutariam').",
      "alternativas_rejeitadas": [
        {
          "opcao": "'servos'",
          "motivo": "perderia o eco lexical com ὑπηρέται das cenas de prisão anteriores no mesmo capítulo"
        }
      ]
    },
