  "decisoes": [
    {
      "questao": "Fórmula ἀμὴν ἀμήν (hebraísmo transliterado, marcado HEB no packet).",
      "escolha": "Glosa semântica \"em verdade, em verdade\" em vez de transliteração \"amém, amém\".",
      "justificativa": "Em pt-BR contemporâneo, \"amém\" funciona como resposta litúrgica de concordância do ouvinte, não como fórmula introdutória do próprio falante; a glosa evita esse desvio de sentido.",
      "alternativas_rejeitadas": [
        {
          "opcao": "Transliterar \"amém, amém, eu digo a vocês\"",
          "motivo": "Preserva a sonoridade solene do hebraísmo, mas arrisca leitura equivocada como interjeição responsiva."
        }
      ]
    },
    {
