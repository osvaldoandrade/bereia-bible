      "escolha": "\"morada\" (lugar de permanência).",
      "justificativa": "μονή deriva de μένω (\"permanecer\"); \"morada\" capta o sentido de lugar de permanência sem a conotação de luxo.",
      "alternativas_rejeitadas": [
        {
          "opcao": "\"mansão\" (tradição Almeida)",
          "motivo": "Falso cognato semântico em pt-BR contemporâneo, que sugere luxo/opulência ausente do grego."
        }
      ]
    },
    {
      "questao": "Função de ὅτι após \"εἶπον ἂν ὑμῖν\".",
      "escolha": "Recitativo/completivo (\"que\"), ligando ao verbo \"dizer\" anterior.",
      "justificativa": "A pontuação da fonte (ponto médio, não ponto final) sugere continuidade sintática, não uma nova asserção causal independente.",
      "alternativas_rejeitadas": [
        {
          "opcao": "ὅτι causal (\"porque\")",
          "motivo": "Tornaria a oração uma justificativa autônoma, menos coerente com o ponto médio de transição do grego."
