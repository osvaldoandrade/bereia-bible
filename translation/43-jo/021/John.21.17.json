  "decisoes": [
    {
      "questao": "οἶδας ('saber' por conhecimento pleno) vs. γινώσκεις ('saber/conhecer' por percepção) na resposta de Pedro",
      "escolha": "normalizar ambos como 'você sabe' no texto publicado, preservando os dois verbos distintos ('sabes'/'conheces') na traducao_literal",
      "justificativa": "par sinonímico joanino paralelo ao ἀγαπάω/φιλέω do mesmo episódio; a mesma lógica do teste de refutação aplicada em v.15 evita importar distinção técnica não exigida pela gramática.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'você sabe tudo; você reconhece que eu o amo'",
          "motivo": "introduziria matiz técnico ('reconhecer' como saber por evidência) que soa artificial em português corrente e não é exigido pelo grego"
        }
      ]
    }
  ],
