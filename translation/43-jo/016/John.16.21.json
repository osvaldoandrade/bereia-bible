    {
      "questao": "τίκτῃ (durativo, trabalho de parto) vs. γεννήσῃ/ἐγεννήθη (ato de gerar/nascer)",
      "escolha": "'está para dar à luz' / 'a criança nasce' / 'nasceu', preservando a diferença de aspecto verbal",
      "justificativa": "τίκτω descreve o processo (dores de parto em curso); γεννάω e seu passivo ἐγεννήθη marcam o evento pontual do nascimento em si — distinção significativa para a metáfora (dor do processo vs. alegria do resultado).",
      "alternativas_rejeitadas": [
        {
          "opcao": "usar 'dar à luz' para os três verbos indistintamente",
          "motivo": "apaga a distinção de aspecto (processo em curso vs. evento pontual) relevante para a comparação de v.20-22"
        }
      ]
    },
    {
      "questao": "ἄνθρωπος — 'ser humano' vs. 'homem'",
      "escolha": "'um ser humano'",
      "justificativa": "ἄνθρωπος é genérico de espécie (não especifica sexo, ao contrário de ἀνήρ); 'homem' em português tende a soar mais restrito ao sexo masculino, o que o grego não codifica aqui.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'um homem'",
          "motivo": "restringe a um sentido de gênero que ἄνθρωπος não especifica"
        }
      ]
    },
