  "decisoes": [
    {
      "questao": "ὕδωρ ζῶν — 'água viva'",
      "escolha": "tradução literal mantida, sem glosar o duplo sentido (água corrente/nascente vs. dom espiritual)",
      "justificativa": "ὕδωρ ζῶν era expressão corrente para 'água corrente/de nascente' (em oposição à água parada de cisterna); Jesus explora esse sentido literal para apontar a um dom espiritual, sem que o grego marque a mudança — a ambiguidade é o próprio recurso retórico do texto.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'água viva' com nota explicativa no texto",
          "motivo": "importaria exegese para dentro do texto (TEOLOGIA §2), antecipando o sentido que o diálogo só revela progressivamente"
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "PRO-1 adjudicado: a cadeia pronominal espelha o original e tem antecedentes claros (Jesus × a mulher); a NVIPT usa estrutura quase idêntica (\"você lhe teria pedido e ele lhe teria dado água viva\"). (ER-0019 v2).",
