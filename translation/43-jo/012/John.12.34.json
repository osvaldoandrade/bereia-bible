    {
      "questao": "segunda pessoa no discurso da multidão a Jesus ('λέγεις σύ')",
      "escolha": "'você' (não 'tu'), conforme ER-0003 — discurso humano dirigido a Jesus não é oração",
      "justificativa": "embora Jesus seja o referente divino do Evangelho, a fala da multidão é diálogo ordinário (pergunta polêmica), não oração/salmo; ER-0003 reserva 'tu' apenas ao discurso dirigido a Deus em oração — critério aplicado de forma consistente com o diálogo humano-a-Jesus já traduzido em Mt 27:11",
      "alternativas_rejeitadas": [
        {
          "opcao": "'tu' (por reconhecer a divindade do interlocutor)",
          "motivo": "introduziria critério teológico na escolha gramatical de pessoa, que ER-0003 não prevê; a regra é sobre o tipo de discurso, não sobre quem é o interlocutor"
        }
      ]
    }
