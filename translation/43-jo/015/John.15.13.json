    {
      "questao": "ψυχή — 'vida' ou 'alma'",
      "escolha": "vida",
      "justificativa": "No idiomatismo 'dar a ψυχή por alguém', o sentido é 'entregar a vida', não a alma como parte imaterial; 'vida' é a glosa que evita ambiguidade estranha ao português corrente.",
      "alternativas_rejeitadas": [
        {
          "opcao": "alma",
          "motivo": "preserva a ambiguidade lexical grega ψυχή (alma/vida), mas 'dar a alma por alguém' soa obscuro e alheio ao idiomatismo pt-BR, ferindo EDITORIAL §1.3"
        }
      ]
    },
    {
      "questao": "ἵνα + subjuntivo (θῇ) — cláusula final vs. infinitivo",
      "escolha": "infinitivo ('dar a vida')",
      "justificativa": "Reduz a cláusula final de sujeito genérico ('que alguém dê') a um infinitivo apositivo, forma idiomática de máxima gnômica em português.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'que alguém dê a vida por seus amigos'",
          "motivo": "mais literal, mas burocratiza a sentença-máxima, perdendo o efeito aforístico do original"
        }
      ]
    },
