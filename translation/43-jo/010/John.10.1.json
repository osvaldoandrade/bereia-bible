      "escolha": "aprisco",
      "justificativa": "Termo tradicional em português bíblico para o cercado de ovelhas, distinto de 'curral' (mais genérico, usado para gado bovino); mantém registro formal-neutro sem soar arcaico.",
      "alternativas_rejeitadas": [
        {
          "opcao": "curral",
          "motivo": "genérico demais, perde a especificidade ovina de αὐλὴ τῶν προβάτων"
        }
      ]
    },
