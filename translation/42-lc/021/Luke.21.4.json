  "decisoes": [
    {
      "questao": "Como verter πάντα τὸν βίον ὃν εἶχεν (\"todo o βίος que tinha\")?",
      "escolha": "\"tudo o que tinha para viver\" — dinâmico, evita ambiguidade com \"vida\" biológica (ζωή).",
      "justificativa": "βίος designa aqui recursos/sustento, não a vida em si; a glosa dinâmica evita confusão lexical em português.",
      "alternativas_rejeitadas": [
        {
          "opcao": "\"toda a sua vida\"",
          "motivo": "ambíguo em português, sugere ζωή (existência) em vez de meio de subsistência."
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "ARA e NVIPT convergem em \"pobreza\", mas a traducao_literal já registra \"escassez\" para ὑστέρημα (v.4), termo grego distinto de πτωχή/\"pobre\" usado no v.3 (\"a pobre\"). A BV preserva essa distinção lexical do original (duas palavras gregas diferentes, duas soluções em português); trocar por \"pobreza\" apagaria a nuance e quebraria a auditabilidade com a traducao_literal. Sem alteração. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
  "palavras_supridas": [],
  "ambiguidades_preservadas": [],
  "justificativa": "περισσεύοντος (particípio substantivado, \"o que sobra/excede\") contrasta com ὑστέρημα (\"falta, escassez\") — terceiro termo de pobreza no parágrafo, distinto de πτωχός/πενιχρός. βίος aqui = \"meio de vida, sustento\", não ζωή (\"vida\" biológica).",
