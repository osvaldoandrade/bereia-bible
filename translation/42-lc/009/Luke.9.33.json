  "decisoes": [
    {
      "questao": "Ἐπιστάτα — glosa para o vocativo lucano exclusivo",
      "escolha": "'Mestre'",
      "justificativa": "ἐπιστάτης (só em Lucas, 7x) designa quem tem autoridade/supervisão; 'Mestre' é a glosa mais estável em português, embora o mesmo termo português também traduza διδάσκαλε (v. 38, termo grego distinto) — a distinção lexical grega fica documentada aqui para rastreio",
      "alternativas_rejeitadas": [
        {
          "opcao": "'Senhor'",
          "motivo": "colide com a glosa fixa de κύριος (NOMES-DIVINOS.md), apagando a distinção entre os três vocativos usados no capítulo (Ἐπιστάτα, Διδάσκαλε, Κύριε)"
        }
      ]
    },
    {
      "questao": "Segunda pessoa no discurso de Pedro a Jesus (σοί)",
      "escolha": "'você' (não 'tu')",
      "justificativa": "ER-0003: 'tu' reservado a oração/salmo dirigido a Deus; este é discurso narrativo espontâneo, não oração — aplica-se a partir daqui uniformemente aos demais endereçamentos diretos a Jesus no capítulo (vv. 38,40,54,57,61)",
      "alternativas_rejeitadas": [
        {
          "opcao": "'tu', por Jesus ser divino",
          "motivo": "a política distingue por tipo de discurso (oração vs. conversa), não pela identidade do interlocutor"
        }
      ]
    },
    {
      "questao": "Revisão editorial do texto_bv",
      "escolha": "E aconteceu que, ao se separarem eles dele, → Ao se separarem dele,",
      "justificativa": "Normalização de calque paratático 'e aconteceu que' (ἐγένετο) conforme ER-0013/§6.2; remoção do pronome 'eles' redundante com o sujeito já identificável pelo contexto. — revisão de forma sem alteração de sentido (ER-0019).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    },
