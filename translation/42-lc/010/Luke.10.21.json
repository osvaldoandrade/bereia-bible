  "decisoes": [
    {
      "questao": "Registro de 2ª pessoa — Jesus dirigindo-se ao Pai",
      "escolha": "'tu/teu' (não 'você')",
      "justificativa": "D-0003: oração/salmo dirigido a Deus usa 'tu'. Esta é oração explícita de Jesus ao Pai, marcada por Ἐξομολογοῦμαί σοι, Πάτερ — critério estrutural claro para o registro litúrgico.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'você' uniforme",
          "motivo": "quebraria a distinção D-0003 justamente no caso paradigmático de oração"
        }
      ]
    },
    {
      "questao": "τῷ Πνεύματι τῷ Ἁγίῳ — maiúscula em 'Espírito Santo'",
      "escolha": "maiúscula, por decisão exegética documentada (título consolidado da terceira pessoa da Trindade)",
      "justificativa": "EDITORIAL §10 permite maiúscula em 'Espírito' mediante decisão exegética registrada (cf. TEOLOGIA §4); aqui θεός-Πνεῦμα Ἅγιον é fórmula titular consolidada no NT, distinta de 'espírito' comum.",
      "alternativas_rejeitadas": [
        {
          "opcao": "minúscula uniforme",
          "motivo": "perderia a distinção entre o Espírito de Deus e 'espíritos' comuns (cf. v. 20, τὰ πνεύματα, mantido minúsculo)"
        }
      ]
    },
    {
      "questao": "Ἐξομολογοῦμαί σοι — 'confessar' ou 'louvar'?",
      "escolha": "'eu te louvo' no publicado",
      "justificativa": "ἐξομολογέω no NT em contexto de oração tem sentido de louvor/agradecimento público, não de confissão de pecado.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'eu te confesso'",
          "motivo": "em português contemporâneo sugere confissão de culpa, sentido ausente aqui"
        }
      ]
    },
    {
      "questao": "οὕτως εὐδοκία ἐγένετο ἔμπροσθέν σου — calque literal 'assim boa vontade aconteceu diante de ti'",
      "escolha": "normalizar para 'assim foi do teu agrado' no publicado",
      "justificativa": "ER-0013 (aplicada ao grego): normaliza construção nominal com verbo 'acontecer' para expressão idiomática equivalente em português.",
      "alternativas_rejeitadas": []
    },
