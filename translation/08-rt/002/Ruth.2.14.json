      "escolha": "“pão ... vinagre ... grãos tostados”",
      "justificativa": "לֶחֶם é pão ou alimento, חֹמֶץ é líquido ácido/vinagre para mergulhar o pedaço, e קָלִי designa grão tostado.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“carne e vinho”",
          "motivo": "Substitui os alimentos nomeados."
        },
        {
          "opcao": "“grão cru”",
          "motivo": "Inverte o preparo de קָלִי."
        }
      ]
    },
    {
      "questao": "Quem serve e qual é o resultado da refeição?",
      "escolha": "“Boaz lhe serviu ... comeu até ficar satisfeita e deixou uma sobra”",
      "justificativa": "וַיִּצְבָּט־לָהּ tem Boaz como sujeito e Rute como beneficiária. Os três verbos finais mantêm Rute como agente de comer, saciar-se e deixar parte da comida.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“Rute serviu Boaz e permaneceu faminta”",
          "motivo": "Inverte agentes e resultados."
        },
        {
          "opcao": "“os ceifeiros consumiram a sobra”",
          "motivo": "Acrescenta destinatário não expresso."
        }
      ]
    },
