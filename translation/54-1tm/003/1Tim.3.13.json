      "questao": "βαθμόν — glosa de termo raro (único uso no NT)",
      "escolha": "posição",
      "justificativa": "βαθμός (lit. 'degrau') é hapax legomenon no NT; 'posição' comunica o sentido metafórico de avanço/reconhecimento sem forçar a imagem arquitetônica do grego.",
      "alternativas_rejeitadas": [
        {
          "opcao": "grau (calque literal)",
          "motivo": "reservado à traducao_literal; no texto publicado 'grau' soa ambíguo em português (grau acadêmico, grau de parentesco)"
        }
      ]
    },
    {
      "questao": "παρρησίαν — glosa",
      "escolha": "confiança",
      "justificativa": "παρρησία (lit. 'franqueza de fala') no contexto denota a confiança/ousadia adquirida diante de Deus e da comunidade pelo serviço fiel.",
      "alternativas_rejeitadas": [
        {
          "opcao": "ousadia",
          "motivo": "mais próxima etimologicamente, mas 'confiança' comunica melhor o registro contextual sem perda de sentido"
        }
      ]
