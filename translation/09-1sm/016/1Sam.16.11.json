  "decisoes": [
    {
      "questao": "Quem ainda falta e o que faz?",
      "escolha": "“o caçula... pastoreando o rebanho”",
      "justificativa": "הַקָּטָן identifica o menor/caçula, שָׁאַר sua ausência do grupo e רֹעֶה בַּצֹּאן sua atividade pastoral.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“o primogênito está no palácio”",
          "motivo": "Troca idade e atividade."
        }
      ]
    },
    {
      "questao": "Qual ordem suspende a refeição ou reunião?",
      "escolha": "“Mande buscá-lo. Não nos sentaremos até que ele chegue”",
      "justificativa": "שִׁלְחָה וְקָחֶנּוּ ordena enviá-lo e trazê-lo; לֹא־נָסֹב mantém a primeira pessoa plural e a espera até sua chegada.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“comecem sem ele”",
          "motivo": "Inverte a condição temporal."
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "BV usa “rapazes” onde NTLH/ARA/NVIPT convergem em “filhos”. A BV segue a literal (heb. ‘ne’arim’ = jovens/rapazes); “rapazes” é mais preciso ao original que “filhos”, e não é arcaico nem inconsistente — divergência legítima baseada na fidelidade ao surface hebraico. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
