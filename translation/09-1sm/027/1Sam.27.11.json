      "questao": "Por que Davi não deixa sobreviventes nem os leva a Gate?",
      "escolha": "Davi não os deixa vivos para levá-los a Gate, pois poderiam denunciá-lo",
      "justificativa": "Davi permanece como sujeito de לֹא־יְחַיֶּה e como agente implícito ativo de לְהָבִיא, cujo objeto são o homem e a mulher. פֶּן introduz prevenção: sobreviventes poderiam testemunhar contra Davi e seu grupo, revelando a Aquis ou a outros o que ele realmente fazia.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“para receberem tratamento em Gate”",
          "motivo": "Inverte a finalidade."
        },
        {
          "opcao": "“porque Aquis ordenara poupar testemunhas”",
          "motivo": "Acrescenta ordem inexistente."
        }
      ]
    },
    {
      "questao": "Como preservar a política reiterada?",
      "escolha": "“Esse foi o procedimento ... durante todo o tempo”",
      "justificativa": "כה משפטו descreve seu costume ou procedimento; כל הימים amplia a prática por toda a permanência no território filisteu.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“ocorreu uma única vez”",
          "motivo": "Contradiz a formulação habitual."
        },
        {
          "opcao": "“era procedimento de Aquis”",
          "motivo": "Troca o possuidor do sufixo."
        }
      ]
    }
