        {
          "opcao": "somente Saul merece morrer",
          "motivo": "Troca o alvo da censura."
        },
        {
          "opcao": "todos guardaram o rei",
          "motivo": "Inverte a negação."
        }
      ]
    },
    {
      "questao": "Que prova Davi apresenta?",
      "escolha": "ausência da lança e do jarro que estavam à cabeceira",
      "justificativa": "Os dois objetos demonstram a penetração no acampamento.",
