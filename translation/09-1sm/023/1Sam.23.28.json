  "decisoes": [
    {
      "questao": "Como se encerra a perseguição e por que o lugar é nomeado?",
      "escolha": "Saul deixa Davi, vai contra os filisteus e o local recebe o nome Pedra das Separações",
      "justificativa": "מִרְדֹף marca afastamento da perseguição; לִקְרַאת dirige Saul aos filisteus. O nome סֶלַע הַמַּחְלְקוֹת associa a rocha à separação dos grupos.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“Saul capturou Davi ali”",
          "motivo": "Contradiz a interrupção."
        },
        {
          "opcao": "“Pedra da União”",
          "motivo": "Inverte o valor de מחלקות."
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "A BV traduz o topônimo סלע המחלקת (“Pedra das Separações”), enquanto ARA/NVIPT transliteram (“Selá-Hamalecote”) e NTLH traduz (“Rocha da Separação”). A escolha de traduzir é legítima; “Pedra” e “Rocha” são sinônimos válidos para סלע, e “Separações” (plural) interpreta המחלקת. Divergência de estilo, não defeito de forma. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
