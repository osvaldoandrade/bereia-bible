  "decisoes": [
    {
      "questao": "Qual é a objeção inicial dos comandantes?",
      "escolha": "“O que fazem estes hebreus aqui?”",
      "justificativa": "מָה הָעִבְרִים הָאֵלֶּה é uma pergunta nominal abrupta; “fazem ... aqui” explicita sua força pragmática sem alterar o grupo questionado.",
      "alternativas_rejeitadas": [
        {
          "opcao": "quem são estes egípcios",
          "motivo": "Troca a identificação."
        },
        {
          "opcao": "os hebreus são bem-vindos",
          "motivo": "Inverte a suspeita."
        }
      ]
    },
    {
      "questao": "Como Aquis identifica e defende Davi?",
      "escolha": "servo de Saul, rei de Israel; longa permanência e nenhuma falta desde a deserção",
      "justificativa": "Os títulos permanecem encadeados. זֶה יָמִים אוֹ־זֶה שָׁנִים conserva a formulação dias/anos, e מִיּוֹם נָפְלוֹ descreve a mudança de lealdade como queda/deserção.",
      "alternativas_rejeitadas": [
        {
          "opcao": "Davi nunca serviu Saul",
          "motivo": "Contradiz a identificação."
        },
        {
          "opcao": "Aquis encontrou muitas faltas",
          "motivo": "Inverte a negação."
        }
      ]
    },
    {
      "questao": "Revisão editorial do texto_bv",
      "escolha": "Aquis respondeu aos comandantes dos filisteus: → Aquis respondeu:",
      "justificativa": "RED-1: repetição de “comandantes dos filisteus” no mesmo verso. NTLH e NVIPT omitem a segunda ocorrência. Redundância interna eliminada (§1.4/EDITORIAL §4 — repetir o que o original não repete é defeito). — revisão de forma sem alteração de sentido (ER-0019).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
