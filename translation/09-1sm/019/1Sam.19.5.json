  "decisoes": [
    {
      "questao": "Como verter וַיָּשֶׂם אֶת־נַפְשׁוֹ בְכַפּוֹ?",
      "escolha": "“arriscou a própria vida”",
      "justificativa": "A expressão “pôs sua vida na palma” é um idiomatismo de expor a vida a perigo; a literal conserva a imagem corporal.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“guardou a vida sem risco algum”",
          "motivo": "Inverte o idiomatismo."
        },
        {
          "opcao": "“tomou a vida de outra pessoa”",
          "motivo": "Troca o sufixo reflexivo."
        }
      ]
    },
    {
      "questao": "Quem realizou a salvação e qual é a acusação final?",
      "escolha": "“O SENHOR realizou ... pecaria contra sangue inocente, matando Davi sem motivo”",
      "justificativa": "יהוה é sujeito de עשה תשועה. Jônatas liga a morte injustificada de Davi ao pecado contra sangue inocente.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“Davi realizou sozinho a salvação”",
          "motivo": "Apaga a agência do SENHOR."
        },
        {
          "opcao": "“Davi merece morrer por culpa comprovada”",
          "motivo": "Contradiz דם נקי e חנם."
        }
      ]
    },
