    {
      "questao": "Como interpretar אִם após o juramento e verter יִתְכַּפֵּר?",
      "escolha": "“jamais será expiada”",
      "justificativa": "Após נִשְׁבַּעְתִּי, אִם introduz a negação enfática própria de fórmula de juramento. O hitpael de כפר é passivo-reflexivo: a iniquidade não receberá expiação.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“talvez seja expiada amanhã”",
          "motivo": "Enfraquece a negação juramentada."
        },
        {
          "opcao": "“a casa fará expiação por outra família”",
          "motivo": "Troca o sujeito da culpa."
        }
      ]
    },
    {
      "questao": "Como representar זֶבַח וּמִנְחָה?",
      "escolha": "“sacrifício ou oferta”",
      "justificativa": "זֶבַח é sacrifício; מִנְחָה pode designar oferta, inclusive oferta de cereal. A coordenação é preservada como meios cultuais incapazes de expiar essa iniquidade.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“somente oração privada”",
          "motivo": "Substitui os dois meios nomeados."
        },
        {
          "opcao": "“sacrifício e oferta certamente expiarão”",
          "motivo": "Inverte a negação."
        }
      ]
    },
