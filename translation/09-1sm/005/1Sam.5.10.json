  "decisoes": [
    {
      "questao": "Qual é o novo destino da arca?",
      "escolha": "“para Ecrom”",
      "justificativa": "O topônimo segue diretamente o verbo de envio e volta a ocorrer na chegada.",
      "alternativas_rejeitadas": [
        {
          "opcao": "para Gate",
          "motivo": "Gate é o local anterior."
        },
        {
          "opcao": "para Israel",
          "motivo": "A devolução ainda não foi executada."
        }
      ]
    },
    {
      "questao": "Como preservar a mudança para o singular na fala coletiva?",
      "escolha": "“até mim ... a mim e ao meu povo”",
      "justificativa": "Embora os ecronitas clamem no plural, os sufixos são primeira pessoa singular. A BV mantém a voz singular representativa.",
      "alternativas_rejeitadas": [
        {
          "opcao": "até nós ... nós e nossos povos",
          "motivo": "Regulariza os pronomes contra a morfologia."
        },
        {
          "opcao": "até ele ... o povo dele",
          "motivo": "Troca a pessoa da fala."
        }
      ]
    },
    {
      "questao": "A quem a intenção mortal é atribuída?",
      "escolha": "“a arca ... para matar”",
      "justificativa": "A construção filisteia liga a chegada da arca à morte temida, preservando sua percepção sem afirmar intenção psicológica da arca.",
      "alternativas_rejeitadas": [
        {
          "opcao": "os ecronitas queriam matar Israel",
          "motivo": "Inverte vítima e agente percebido."
        },
        {
          "opcao": "Dagom foi levado para matar",
          "motivo": "Troca o objeto transportado."
        }
      ]
    },
    {
