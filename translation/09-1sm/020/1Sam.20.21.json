      "questao": "Qual sinal indica segurança?",
      "escolha": "O rapaz recolhe as flechas aquém; Davi entende o sinal e pode vir",
      "justificativa": "A localização “deste lado” contrasta com o verso seguinte. A ordem de recolher pertence à fala ao rapaz; a ordem de vir e a garantia de paz dirigem-se a Davi.",
      "alternativas_rejeitadas": [
        {
          "opcao": "Flechas além significam segurança",
          "motivo": "Inverteria os sinais."
        }
      ]
    },
    {
      "questao": "Como preservar o juramento?",
      "escolha": "“tão certo como vive o SENHOR”",
      "justificativa": "חַי־יְהוָה sela a garantia de segurança sem transformá-la em fala do rapaz.",
      "alternativas_rejeitadas": [
        {
          "opcao": "O rapaz faz o juramento",
          "motivo": "Jônatas continua como falante."
        }
      ]
    }
