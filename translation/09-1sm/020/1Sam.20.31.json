    {
      "questao": "Qual ameaça Saul vê em Davi?",
      "escolha": "Enquanto Davi viver, Jônatas e seu reino não se consolidarão",
      "justificativa": "O plural coordenado “você e seu reino” é preservado, embora o verbo hebraico esteja no singular.",
      "alternativas_rejeitadas": [
        {
          "opcao": "A vida de Davi garante o reino de Jônatas",
          "motivo": "Inverteria a negação."
        }
      ]
    },
    {
      "questao": "Como preservar שְׁלַח וְקַח אֹתוֹ אֵלַי?",
      "escolha": "“mande buscá-lo e traga-o até mim”",
      "justificativa": "שְׁלַח ordena o envio, וְקַח mantém a tomada ou busca de Davi, e אֵלַי conserva a direção até Saul; a redação evita introduzir a prisão como ação lexicalmente explícita.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“mande prendê-lo”",
          "motivo": "“Prender” especificaria uma ação não expressa por שְׁלַח וְקַח."
        }
      ]
    },
    {
      "questao": "O que significa בֶּן־מָוֶת?",
      "escolha": "“está condenado à morte”",
      "justificativa": "O idioma “filho da morte” expressa alguém destinado ou condenado a morrer; a BV comunica essa sentença em português natural.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“filho biológico da morte”",
          "motivo": "Tomaria literalmente um idioma de condenação."
        }
      ]
    },
