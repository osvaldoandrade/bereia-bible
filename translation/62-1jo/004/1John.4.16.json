  "decisoes": [
    {
      "questao": "'ἣν ἔχει ὁ Θεὸς ἐν ἡμῖν' — locativo ἐν ἡμῖν após 'o amor que Deus tem'.",
      "escolha": "'que Deus tem por nós' no publicado (relacional); a literal preserva 'em nós'.",
      "justificativa": "'O amor que Deus tem em nós' soa locativo estranho em português (como se o amor estivesse fisicamente dentro de nós) e colide com as duas ocorrências seguintes de 'permanece em' na mesma frase, repetindo a preposição com sentidos diferentes.",
      "alternativas_rejeitadas": [
        {
          "opcao": "Manter 'em nós' no publicado",
          "motivo": "Ambiguidade de referência pronominal/espacial dentro do mesmo período — EDITORIAL §1.3 pede evitar isso quando o original permite divisão sem perda sintática."
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "O achado RED-1 ('deus deus') sinaliza a recorrência de 'Deus' em curto espaço, mas é refrão teológico intencional do original ('Deus é amor... permanece em Deus, e Deus... nele'), reproduzido com a mesma repetição por NTLH, ARA e NVIPT. Repetir o que o original repete é fidelidade (EDITORIAL — item 4); achado é falso-positivo, texto mantido. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
