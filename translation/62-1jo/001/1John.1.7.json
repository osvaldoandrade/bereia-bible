  "decisoes": [
    {
      "questao": "μετ' ἀλλήλων (recíproco 'uns com os outros') vs μεθ' ἡμῶν de 1:3 ('conosco'): preservar distinção",
      "escolha": "'uns com os outros' (não 'conosco')",
      "justificativa": "ἀλλήλων é pronome recíproco distinto de ἡμῶν; aqui a comunhão é entre os próprios crentes que andam na luz, não especificamente com os apóstolos como em 1:3 — distinção lexical preservada.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'conosco'",
          "motivo": "colapsaria a distinção gramatical grega entre pronome pessoal (ἡμῶν, 1:3) e recíproco (ἀλλήλων, 1:7)"
        }
      ]
    },
    {
      "questao": "ὡς αὐτός ἐστιν ἐν τῷ φωτί ('como ele está na luz'): 'está' ou 'é'?",
      "escolha": "'está' (locativo)",
      "justificativa": "Construção com ἐν + dativo é locativa ('está na luz'), diferente da predicação nominal de 1:5 (φῶς ἐστιν, 'é luz'); a BV distingue as duas construções gregas.",
