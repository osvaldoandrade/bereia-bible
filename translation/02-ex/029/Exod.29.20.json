  "decisoes": [
    {
      "questao": "Como verter תְּנוּךְ e בֹּהֶן quando aplicado ao pé?",
      "escolha": "“lóbulo” e “dedão do pé”",
      "justificativa": "תְּנוּךְ refere-se à extremidade carnosa da orelha; בֹּהֶן designa o dedo principal, que no pé corresponde ao dedão.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“ponta da orelha” e “polegar do pé”",
          "motivo": "A primeira é menos anatômica e a segunda não é expressão natural em português."
        }
      ]
    },
    {
      "questao": "Revisão editorial do texto_bv",
      "escolha": "deles; depois aspergirás → deles. Depois, aspergirás",
      "justificativa": "Sentença com 48 palavras excede o limite de 40 (§1.3); divisão no ponto natural (ponto e vírgula) sem perda sintática nem adição de sentido. — revisão de forma sem alteração de sentido (ER-0019).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "PRO-1: os pronomes 'dele' (carneiro) e 'deles' (Arão e seus filhos, ×3) têm todos antecedente claro e imediato. A sentença já está dividida em duas; a primeira (~39 palavras) descreve um ritual unitário difícil de fracionar sem perda sintática. Achado é falso-positivo. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    },
