    {
      "questao": "Como verter a expressão וּמִלֵּאתָ יַד?",
      "escolha": "“investirás”",
      "justificativa": "“Encher a mão” é o idioma técnico da instalação no ofício sacerdotal; “investir” comunica a função no texto publicado, enquanto o calque permanece na literal.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“consagrarás”",
          "motivo": "É possível no contexto, mas apaga a distinção lexical entre מלא יד e קדש."
        }
      ]
    },
