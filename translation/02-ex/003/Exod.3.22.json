  "decisoes": [
    {
      "questao": "וְנִצַּלְתֶּם אֶת־מִצְרָיִם",
      "escolha": "e despojareis o Egito",
      "justificativa": "נצל (piel) 'despojar/resgatar'. Não é roubo: é reparação pela escravidão não paga e cumprimento de Gn 15:14 ('sairão com grande riqueza'). O metal precioso servirá ao santuário (Êx 25) — e ao bezerro de ouro (32).",
      "alternativas_rejeitadas": []
    },
    {
      "questao": "Revisão editorial do texto_bv",
      "escolha": "poreis sobre vossos filhos e sobre vossas filhas; e despojareis → porão sobre seus filhos e sobre suas filhas; e despojarão",
      "justificativa": "Normalização do paradigma vós→vocês (§3/D-0003): poreis→porão, vossos/vossas→seus/suas, despojareis→despojarão. — revisão de forma sem alteração de sentido (ER-0019).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "PRO-1 (4 pronomes de 3ª) avaliado: todos os possessivos (sua vizinha, sua casa, seus filhos, suas filhas) referem inequivocamente a “cada mulher”. Falso-positivo do marcador. BV aplica corretamente o paradigma “vocês” (D-0003) onde a literal tem “vós” (poreis/vossos/despojareis). (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
