    {
      "questao": "Quem é o sujeito de וַיִּכְתֹּב?",
      "escolha": "Usar a passiva “foram registradas”",
      "justificativa": "O sujeito imediato da narrativa é Moisés, mas 34.1 atribui ao SENHOR a escrita nas tábuas; como o verbo não nomeia o agente, a passiva preserva a indeterminação local.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“Moisés escreveu”",
          "motivo": "Segue o sujeito narrativo mais próximo, mas entra em tensão com a promessa explícita de 34.1."
        },
        {
          "opcao": "“o SENHOR escreveu”",
          "motivo": "Harmoniza com 34.1, mas introduz no verso um sujeito que o verbo não expressa."
        }
      ]
    },
    {
      "questao": "Como verter עֲשֶׂרֶת הַדְּבָרִים?",
      "escolha": "“as dez palavras”",
      "justificativa": "דְּבָרִים é repetido no verso e significa “palavras”; a designação tradicional “Dez Mandamentos” é interpretativa, embora contextualizada pela aliança.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“os Dez Mandamentos”",
          "motivo": "É tradicional e semanticamente adequada, mas troca o lexema “palavras” por sua função normativa."
        }
      ]
    },
