  "decisoes": [
    {
      "questao": "ἀπειθήσαντες (aoristo ptc. de ἀπειθέω, lit. 'desobedecer/recusar-se a crer')",
      "escolha": "'que não creram'",
      "justificativa": "no contraste direto com πιστεῦσαι do v.1, ἀπειθέω assume o sentido de recusa de fé, leitura padrão no corpus lucano-joanino (cf. Jo 3:36).",
      "alternativas_rejeitadas": [
        {
          "opcao": "os judeus desobedientes",
          "motivo": "mantém o sentido literal de 'desobedecer', mas obscurece o contraste direto com 'crer' do v.1"
        }
      ]
    },
    {
      "questao": "τὰς ψυχάς (lit. 'as almas') τῶν ἐθνῶν",
      "escolha": "'o ânimo dos gentios'",
      "justificativa": "ψυχή aqui denota a disposição/mente, não a alma em sentido antropológico-teológico; 'ânimo' capta o sentido idiomático de κακόω τὰς ψυχάς.",
      "alternativas_rejeitadas": [
        {
          "opcao": "as almas dos gentios",
          "motivo": "literal, mas sugere leitura teológica que o contexto não pede"
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "Sem achados. \"Envenenaram o ânimo\" diverge de ARA/NVIPT (\"irritaram/excitaram os ânimos\"), mas é escolha estilística legítima para κακώσαντες τὰς ψυχὰς (lit. \"maltrataram as almas\"); registro formal-neutro preservado. (ER-0019 v2).",
