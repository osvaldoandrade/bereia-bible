  "decisoes": [
    {
      "questao": "κύριος em citação direta de Salmo 2:2, onde o hebraico traz יְהוָה (YHWH)",
      "escolha": "SENHOR (maiúsculas)",
      "justificativa": "Política NOMES-DIVINOS (ER-0002) prevê avaliação caso a caso para citações do AT no NT com YHWH subjacente; Sl 2:2 TM tem 'עַל־יְהוָה וְעַל־מְשִׁיחוֹ', vertido pela LXX como κύριος — a BV mantém a convenção SENHOR para marcar o Tetragrama subjacente à citação.",
      "alternativas_rejeitadas": [
        {
          "opcao": "Senhor (minúsculas, como referência a Jesus)",
          "motivo": "obscureceria que o κύριος do Salmo citado é o Tetragrama, e não Jesus (o 'Cristo' da mesma oração é distinto)"
        }
      ]
    },
    {
      "questao": "Revisão editorial do texto_bv",
      "escolha": "“Levantaram-se os reis da terra, e as autoridades se ajuntaram, contra o SENHOR e contra o seu Cristo.”” → ‘Levantaram-se os reis da terra, e as autoridades se ajuntaram, contra o SENHOR e contra o seu Cristo.’",
      "justificativa": "Continuação da citação do Salmo 2 (iniciada no v.25) dentro do discurso dos discípulos: aspas simples de abertura e fechamento (EDITORIAL §5/ER-0004). Removida aspa dupla espúria de fechamento (o discurso continua nos vv.27-30). — revisão de forma sem alteração de sentido (ER-0019).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
