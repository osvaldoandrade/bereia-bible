    {
      "questao": "ἐνέτυχόν μοι",
      "escolha": "'me procurou' — sentido de petição/apelo formal",
      "justificativa": "ἐντυγχάνω no registro jurídico significa 'peticionar/recorrer a alguém'; 'me procurou' comunica isso de forma natural sem tecnicismo.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'me interpelou'",
          "motivo": "registro mais formal que dificulta leitura em voz alta"
        }
      ]
    },
    {
      "questao": "μὴ δεῖν αὐτὸν ζῆν μηκέτι (dupla negação enfática)",
      "escolha": "'que ele não deveria viver mais'",
      "justificativa": "A dupla negação grega (μὴ...μηκέτι) é enfática, não gramaticalmente cumulativa; o publicado normaliza para uma única negação natural em português, preservando a ênfase na literal.",
      "alternativas_rejeitadas": []
    },
    {
      "questao": "Revisão editorial do texto_bv",
      "escolha": "vocês vedes este homem → vocês vejam este homem",
      "justificativa": "D-0003/§3: 'vedes' é forma do paradigma vós (2ª pessoa plural arcaica); normalizado para 'vejam' (3ª pessoa plural do paradigma vocês), coerente com o uso de 'vocês' no mesmo vocativo. — revisão de forma sem alteração de sentido (ER-0019). O vocativo dirige-se a 'Rei Agripa e todos os homens' com 'vocês' (paradigma §3), mas o verbo 'vedes' pertencia ao paradigma vós — paradigma misto no mesmo vocativo. Normalizado para 'vejam' (vocês), coerente com ARA/NVIPT que usam 'vedes/vejam' e com o padrão §3 do capítulo.",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
