    {
      "questao": "διακονία (serviço) — escolha lexical",
      "escolha": "'serviço diário' (não 'distribuição diária' nem 'assistência diária')",
      "justificativa": "O grego repete διακονία em v.1 (serviço diário), v.2 (διακονεῖν, servir às mesas) e v.4 (serviço da palavra); manter a mesma raiz em português preserva o jogo retórico do capítulo.",
      "alternativas_rejeitadas": [
        {
          "opcao": "distribuição diária",
          "motivo": "mais idiomático isoladamente, mas rompe a raiz comum com vv.2 e 4"
        }
      ]
    },
    {
      "questao": "Ἑλληνιστῶν / Ἑβραίους — maiúscula ou minúscula",
      "escolha": "helenistas / hebreus, minúsculas",
      "justificativa": "São designações de grupo (judeus de fala grega vs. judeus de fala aramaica/hebraica), não antropônimos nem topônimos plenos (EDITORIAL §10).",
      "alternativas_rejeitadas": [
        {
          "opcao": "Helenistas / Hebreus maiúsculos",
          "motivo": "atribuiria estatuto de nome próprio que o grego não codifica para esses substantivos de grupo"
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "NTLH/ARA/NVIPT usam “esquecidas na distribuição diária”; BV usa “negligenciadas no serviço diário”. “Negligenciadas” é sinônimo aceitável de “esquecidas” e “serviço diário” traduz διακονίᾳ de forma mais literal. “Multiplicando-se” é alternativa válida a “crescendo o número” (ARA/NVIPT). Texto em bom português formal-neutro, sem arcaísmos. (ER-0019 v2).",
