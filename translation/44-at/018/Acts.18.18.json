  "decisoes": [
    {
      "questao": "κειράμενος (particípio nominativo singular) — concorda com Paulo ou com Áquila?",
      "escolha": "concordância gramatical com ὁ Παῦλος (sujeito nominativo da oração principal); é Paulo quem corta o cabelo",
      "justificativa": "Πρίσκιλλα καὶ Ἀκύλας são introduzidos por 'σὺν αὐτῷ' (com ele), não como sujeitos nominativos; o particípio nominativo singular só pode concordar com o sujeito principal da frase, Paulo. Decisão gramatical, não teológica (teste de refutação: qualquer leitor competente em grego chega à mesma análise sintática).",
      "alternativas_rejeitadas": [
        {
          "opcao": "atribuir o corte de cabelo a Áquila",
          "motivo": "Áquila não está em caso nominativo; o particípio não pode concordar com ele sintaticamente"
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "BV divide em duas sentenças, melhorando a legibilidade (grego tem uma sentença participial longa). ‘Cortado o cabelo’ traduz o grego keiras (raspar/cortar). ARA usa ‘rapado a cabeça’ (mais específico); NTLH também ‘rapou a cabeça’. BV é adequada e natural. (ER-0019 v2).",
