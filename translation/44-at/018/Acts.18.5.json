  "decisoes": [
    {
      "questao": "συνείχετο τῷ λόγῳ (voz passiva, dativo instrumental, 'era tomado/constrangido pela palavra')",
      "escolha": "'dedicava-se inteiramente à palavra' no publicado",
      "justificativa": "a passiva grega expressa absorção total na pregação; normalizada para construção ativa idiomática em português. A literal preserva a passiva.",
      "alternativas_rejeitadas": [
        {
          "opcao": "manter a passiva 'era constrangido pela palavra' no publicado",
          "motivo": "soa artificial e obscurece o sentido de dedicação total"
        }
      ]
    },
    {
      "questao": "εἶναι τὸν Χριστὸν Ἰησοῦν (infinitivo com acusativo, predicado 'o Cristo' antes do sujeito 'Jesus')",
      "escolha": "'que Jesus era o Cristo' no publicado, ordem normalizada",
      "justificativa": "construção grega de acusativo+infinitivo com ordem predicado-sujeito; o publicado normaliza para sujeito-predicado natural em português. A literal preserva a ordem original ('ser o Cristo Jesus').",
      "alternativas_rejeitadas": []
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "BV usa imperfeito ‘se dedicava’ (grego syneicheto — era constrangido/tomado pela palavra), captando a ação em progresso. ARA usa perfeito (‘dedicou-se’), NVIPT similar. BV preserva o aspecto imperfectivo do grego. Texto fluido. (ER-0019 v2).",
