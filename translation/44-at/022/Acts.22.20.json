        }
      ]
    },
    {
      "questao": "Revisão editorial do texto_bv",
      "escolha": "sua testemunha → tua testemunha",
      "justificativa": "Paradigma de 2ª pessoa (§3/D-0003): Paulo continua a oração ao Senhor (v. 19). O possessivo de 2ª pessoa dirigida a Deus é 'tua', não 'sua'. ARA/NVIPT usam 'tua testemunha'. — revisão de forma sem alteração de sentido (ER-0019). Continuação da fala de Paulo ao Senhor (oração, §3/D-0003). 'Sua' é ambíguo em pt-BR (pode significar 'dele'); 'tua' é inequívoco e consistente com o paradigma de oração. Todas as referências (NTLH: 'a respeito de ti'; ARA: 'tua testemunha'; NVIPT: 'tua testemunha') confirmam.",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    },
