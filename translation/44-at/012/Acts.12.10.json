    {
      "questao": "φυλακή (3ª ocorrência do capítulo) — sentido 'posto de guarda' vs. 'prisão'",
      "escolha": "posto de guarda",
      "justificativa": "No plural distributivo ('primeiro e segundo posto'), φυλακή designa os postos sucessivos de sentinela que Pedro atravessa, não a prisão física já nomeada em vv.4-6; glosa contextual distinta.",
      "alternativas_rejeitadas": [
        {
          "opcao": "guarda",
          "motivo": "ambíguo entre o posto e a(s) pessoa(s) que guardam, em português"
        }
      ]
    },
    {
      "questao": "αὐτομάτη — abertura espontânea do portão",
      "escolha": "se abriu sozinho",
      "justificativa": "αὐτόματος qualifica a abertura como não operada por mão humana; 'sozinho' comunica a espontaneidade sem inserir a categoria interpretativa 'milagrosamente', que o advérbio grego não lexicaliza (TEOLOGIA §2).",
      "alternativas_rejeitadas": [
        {
          "opcao": "milagrosamente",
          "motivo": "insere no texto uma categoria interpretativa que o advérbio grego não lexicaliza"
        }
      ]
