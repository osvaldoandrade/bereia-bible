    {
      "questao": "Ὁδόν — autodesignação técnica do movimento cristão primitivo, recorrente em Atos (cf. At 9.2; 19.9,23; 22.4; 24.22)",
      "escolha": "Caminho (maiúscula, como termo técnico)",
      "justificativa": "Uso consistente em todo o livro de Atos; a maiúscula sinaliza estatuto de autodesignação, não substantivo comum.",
      "alternativas_rejeitadas": [
        {
          "opcao": "caminho (minúscula)",
          "motivo": "apaga o estatuto de termo técnico/autodesignação do movimento, presente também no v.22"
        }
      ]
    },
    {
      "questao": "πατρῴῳ Θεῷ — adjetivo 'ancestral/pátrio' qualificando o Deus de Israel, na boca do próprio Paulo (1ª pessoa)",
      "escolha": "Deus de meus pais",
      "justificativa": "Explicita o índice pessoal (Paulo fala de si mesmo, não da nação coletivamente) de forma natural em português.",
      "alternativas_rejeitadas": [
        {
          "opcao": "Deus pátrio",
          "motivo": "soa estranho/arcaico em português contemporâneo"
        },
        {
          "opcao": "Deus de nossos pais",
          "motivo": "muda o índice pessoal do discurso, que é de primeira pessoa do singular"
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "NTLH/ARA/NVIPT convergem em \"nossos pais\"/\"nossos antepassados\" onde a BV usa \"meus pais\". O grego τῷ πατρῴῳ θεῷ não traz possessivo explícito; a BV optou por \"meus\" (identificação pessoal de Paulo), as referências por \"nossos\" (inclusão do auditório). Alterar de \"meus\" para \"nossos\" mudaria a nuance retórica — toque de forma que toca no sentido —, portanto mantido. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
