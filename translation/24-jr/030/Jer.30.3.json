  "decisoes": [
    {
      "questao": "שְׁבוּת עַמִּי (raiz שוב \"voltar\" ou שבה \"cativeiro\"?)",
      "escolha": "\"restaurarei a sorte\" (sentido amplo de reversão de condição)",
      "justificativa": "O idiomatismo שוב שבות ocorre também fora de contextos de exílio literal (cf. Jó 42:10), sugerindo sentido mais amplo de ‘reverter a situação’ do que ‘trazer de volta cativos’ estritamente.",
      "alternativas_rejeitadas": [
        {
          "opcao": "\"restaurarei o cativeiro\"/\"farei voltar os cativos\"",
          "motivo": "fixa a etimologia em שבה (cativeiro), reduzindo a amplitude semântica documentada do idiomatismo bíblico"
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "CAL-2: “eis que” mantido por ser fórmula profética com força dêitica forte (“eis que vêm dias”); ARA também preserva “eis que” neste contexto. NVIPT substitui por “Certamente”, mas a BV segue a tradição formal. Fórmula intencional do original. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
