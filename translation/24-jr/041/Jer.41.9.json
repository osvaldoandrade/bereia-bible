  "decisoes": [
    {
      "questao": "בְּיַד־גְּדַלְיָהוּ — 'pela mão de Gedalias': Gedalias como agente, motivo ou ocasião/companhia da matança?",
      "escolha": "'ao lado de Gedalias' — os homens mortos na mesma ocasião do assassinato de Gedalias, não por mão dele.",
      "justificativa": "Gedalias é vítima, não agente, no relato (vv.2-3); ler 'pela mão de' como agência ativa contradiria a narrativa. 'Yad' com sentido de proximidade/ocasião resolve a tensão sem forçar a tradução.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'pela mão de Gedalias' (literal, agência)",
          "motivo": "contradiz a narrativa — Gedalias não matou ninguém, foi assassinado"
        },
        {
          "opcao": "'por causa de Gedalias' (motivo)",
          "motivo": "possível, mas menos apoiada pelo uso idiomático de יד como 'lado/companhia'"
        }
      ]
    },
    {
      "questao": "Revisão editorial do texto_bv",
