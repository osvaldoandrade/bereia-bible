  "decisoes": [
    {
      "questao": "לְבָמוֹת יָעַר ('alturas/lugares altos de floresta') — imagem de colina arruinada tomada pela vegetação",
      "escolha": "'uma colina coberta de mato'",
      "justificativa": "בָּמָה no plural aqui não denota culto idolátrico, mas elevação natural tomada pela mata; tradução dinâmica preserva a imagem de abandono sem soar como termo técnico cúltico.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'lugares altos de floresta'",
          "motivo": "em português soa como termo técnico de culto, obscurecendo a imagem de ruína natural pretendida"
        }
      ]
    },
    {
      "questao": "הָיָה נִבָּא — perífrase durativa (qatal de היה + particípio Nifal)",
      "escolha": "'profetizava' (aspecto durativo em português)",
      "justificativa": "paralelo à mesma perífrase já tratada em Gn 1:6-8 (ER-0015); a literal preserva 'estava profetizando'.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'profetizou' (pontual)",
          "motivo": "perderia o aspecto durativo marcado pela perifrase hebraica"
        }
      ]
    },
    {
      "questao": "Revisão editorial do texto_bv",
      "escolha": "e disse a todo o povo de Judá: Assim disse → e disse a todo o povo de Judá; assim disse",
      "justificativa": "LEN-1 (47 palavras, limiar 40); ponto e vírgula introduz pausa forte entre a introdução histórica e a fórmula do oráculo, melhorando legibilidade sem alterar palavras nem sentido (§1.3). — revisão de forma sem alteração de sentido (ER-0019).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
