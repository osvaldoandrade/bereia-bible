  "decisoes": [
    {
      "questao": "מֹטוֹת מִצְרַיִם — 'jugos/varas de jugo do Egito' (símbolo de domínio)",
      "escolha": "\"os jugos do Egito\"",
      "justificativa": "מוֹטָה designa a vara/barra do jugo, imagem de sujeição imposta por um poder sobre outros; 'jugos' preserva a metáfora de dominação quebrada.",
      "alternativas_rejeitadas": [
        {
          "opcao": "\"as varas do Egito\"",
          "motivo": "mais literal, mas obscurece a imagem de dominação que 'jugo' carrega em português"
        }
      ]
    },
    {
      "questao": "הִיא (pronome fronteado enfático) עָנָן יְכַסֶּנָּה",
      "escolha": "\"quanto a ela, uma nuvem a cobrirá\"",
      "justificativa": "O pronome enfático fronteado marca mudança/ênfase de foco para a cidade (Tapanes); 'quanto a ela' reproduz esse realce em português sem soar como mero pleonasmo.",
      "alternativas_rejeitadas": [
        {
          "opcao": "\"ela será coberta por uma nuvem\"",
          "motivo": "voz passiva perde a topicalização enfática do pronome hebraico fronteado"
        }
      ]
    },
