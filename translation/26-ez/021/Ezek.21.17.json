  "decisoes": [
    {
      "questao": "מְגוּרֵי אֶל־חֶרֶב — substantivo raro (מָגוֹר), sentido 'terror/pavor' ou 'entregues/moradores' junto à espada.",
      "escolha": "'Estão entregues à espada'",
      "justificativa": "HALOT registra מָגוֹר I como 'terror' (cognato de מגור־מסביב em Jeremias); a leitura 'entregues ao terror da espada' encaixa no contexto de lamento, mas a tradução final optou por simplificar para clareza de leitura corrida.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'são moradores/peregrinos da espada'",
          "motivo": "Sentido de מָגוֹר como 'lugar de peregrinação' (raiz גור) é filologicamente possível mas semanticamente menos ajustado ao tom de terror do lamento."
        }
      ]
    }
