    {
      "questao": "רַב־לָכֶם — idiomatismo de repreensão",
      "escolha": "'Basta, príncipes de Israel!'",
      "justificativa": "Expressão idiomática (cf. Dt 1:6; Nm 16:3) de exasperação/repreensão, não tradução literal palavra a palavra de 'muito para vocês'.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'Muito vos basta'",
          "motivo": "soa arcaizante, contra EDITORIAL §1.2"
        }
      ]
    },
    {
      "questao": "גְּרֻשֹׁתֵיכֶם — 'vossas expulsões'",
      "escolha": "'as suas expulsões'",
      "justificativa": "H1646, substantivo derivado de גרשׁ (expulsar); refere-se ao ato de expulsar/despejar o povo de suas terras.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'vossas opressões' (genérico)",
          "motivo": "perde a especificidade lexical de expulsão/despejo de terra"
        }
      ]
    },
