  "decisoes": [
    {
      "questao": "בֵּית הַמֶּרִי (\"casa da rebeldia\", epíteto recorrente de Israel em Ezequiel)",
      "escolha": "\"casa rebelde\" (adjetivo), não \"casa da rebeldia\" (genitivo nominal)",
      "justificativa": "idiomatização padrão em português para o epíteto hebraico recorrente, mais natural que o genitivo calcado.",
      "alternativas_rejeitadas": [
        {
          "opcao": "\"casa da rebeldia\" no publicado",
          "motivo": "soa mais artificial que a forma adjetival, sem perda de sentido; preservado como opção na literal."
        }
      ]
    },
    {
      "questao": "Revisão editorial do texto_bv",
      "escolha": "Dize (2 ocorrências) → Diga | Não sabeis → Vocês não sabem",
      "justificativa": "§3/D-0003: normalização tu→você no imperativo (discurso Deus→humano); aplicado nas duas ocorrências do verso | §3/D-0003: normalização vós→vocês no discurso Deus→humano; original emprega 2ª pessoa plural, mantida a distinção de número com \"vocês\" — revisão de forma sem alteração de sentido (ER-0019). \"Eis que\" mantido: introduz evento histórico concreto (a vinda do rei da Babilônia) com força dêitica no original.",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
