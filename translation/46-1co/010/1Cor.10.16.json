    {
      "questao": "κοινωνία (+ genitivo objetivo) — 'comunhão do sangue' (calco) ou 'comunhão com o sangue'?",
      "escolha": "'comunhão com o sangue/corpo', suprindo a preposição 'com' para expressar o genitivo objetivo (comunhão CUJO OBJETO é o sangue/corpo) de forma natural.",
      "justificativa": "O genitivo grego κοινωνία τοῦ αἵματος não é possessivo ('comunhão que pertence ao sangue') mas objetivo ('participação NO sangue'); 'com' comunica isso sem ambiguidade em português.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'comunhão do sangue' (calco do genitivo)",
          "motivo": "soa possessivo em português, obscurecendo o sentido de participação"
        },
        {
          "opcao": "'participação no sangue'",
          "motivo": "termo lexicalmente válido e próximo, mas 'comunhão' é o termo consolidado na tradição teológica pt-BR para κοινωνία eucarística; preservado como glosa principal"
        }
      ]
    },
