    {
      "questao": "ψυχικός, adjetivo de ψυχή ('alma/vida natural'), correlato de πνευματικός",
      "escolha": "'natural' no publicado",
      "justificativa": "ψυχικός não significa 'animal' no sentido de bicho, mas 'da esfera da ψυχή' — a vida natural, terrena, animada; 'natural' comunica esse sentido evitando confusão com 'animal' e sem exigir o tecnicismo 'psíquico'.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'animal' (tradição Almeida, calco do latim animalis)",
          "motivo": "em português contemporâneo sugere 'bicho', confundindo o leitor"
        },
        {
          "opcao": "'psíquico' (transliteração conceitual)",
          "motivo": "carrega hoje conotação de psicologia moderna, estranha ao par corpo-natural/corpo-espiritual paulino"
        }
      ]
    },
