      "questao": "ἰδιώτου — glosa de ἰδιώτης",
      "escolha": "'leigo'",
      "justificativa": "no contexto, ἰδιώτης designa quem não domina o fenômeno em discussão (fala em línguas) e por isso não consegue responder 'Amém'; 'leigo' comunica isso sem o falso cognato pejorativo.",
      "alternativas_rejeitadas": [
        {
          "opcao": "idiota",
          "motivo": "falso cognato — em português tem sentido depreciativo de deficiência mental, ausente no grego"
        },
        {
          "opcao": "não iniciado",
          "motivo": "perífrase correta, mas menos natural para recorrência (vv.23,24)"
        }
      ]
    },
