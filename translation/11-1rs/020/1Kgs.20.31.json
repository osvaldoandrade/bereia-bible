  "decisoes": [
    {
      "questao": "Como verter מַלְכֵי חֶסֶד?",
      "escolha": "reis de amor leal",
      "justificativa": "חֶסֶד conserva a ideia relacional de lealdade e benevolência; a literal mantém o mesmo termo já adotado no projeto.",
      "alternativas_rejeitadas": [
        {
          "opcao": "reis fracos",
          "motivo": "Inverteria a qualidade atribuída pelos servos."
        }
      ]
    },
    {
      "questao": "Revisão editorial do texto_bv",
      "escolha": "“Eis que ouvimos que → “Ouvimos que",
      "justificativa": "Normalização de calque paratático (§6.2/ER-0013): ‘eis que’ (hinneh) com força dêitica fraca no discurso de conselheiros — função meramente presentativa, sem carga profética ou formular. O português contemporâneo veicula a mesma informação com ‘Ouvimos que’, sem perda de sentido. — revisão de forma sem alteração de sentido (ER-0019).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "PRO-1 mecânico: pronomes com referência clara no contexto (servos→Ben-Hadade; “ele” = rei de Israel; “sua vida” = de Ben-Hadade, interlocutor do discurso). “Amor leal” traduz חסד (chesed), termo teológico com glosa consistente na BV; NTLH/ARA/NVIPT usam sinônimos genéricos (“bondosos/clementes/misericordiosos”), mas a escolha da BV é legítima e mais precisa. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    },
