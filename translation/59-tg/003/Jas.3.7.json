  "decisoes": [
    {
      "questao": "δαμάζεται (presente) e δεδάμασται (perfeito) — dois tempos verbais distintos para 'domar', lado a lado.",
      "escolha": "é domada... e já foi domada",
      "justificativa": "O par presente/perfeito marca ação habitual (é domada, em geral) seguida de estado resultante consumado (já foi domada, com efeito permanente); o português marca a distinção com advérbio 'já' mais tempo composto.",
      "alternativas_rejeitadas": [
        {
          "opcao": "é e tem sido domada",
          "motivo": "gramaticalmente literal, mas soa pesado e menos natural em pt-BR corrente (EDITORIAL §1.2)"
        }
      ]
    }
