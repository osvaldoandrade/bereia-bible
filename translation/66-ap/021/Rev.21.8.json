  "decisoes": [
    {
      "questao": "Rendição da lista de vícios: ἐβδελυγμένοις, πόρνοις, φαρμάκοις",
      "escolha": "\"abomináveis\", \"imorais\", \"feiticeiros\"",
      "justificativa": "ἐβδελυγμένοι (part. perfeito de βδελύσσομαι) são os que se tornaram abomináveis; πόρνοι cobre imoralidade sexual genérica (não só adultério); φάρμακοι é o praticante de feitiçaria/sorteios por drogas, glosa consolidada.",
      "alternativas_rejeitadas": [
        {
          "opcao": "\"devassos\" para πόρνοις",
          "motivo": "arcaizante (EDITORIAL §1.2)"
        },
        {
          "opcao": "\"adúlteros\" para πόρνοις",
          "motivo": "estreita demais o lexema (moicheia é que é adultério)"
        },
        {
          "opcao": "\"envenenadores\" para φαρμάκοις",
          "motivo": "no NT o termo designa magia/feitiçaria (cf. φάρμακον em Ap 9:21; 18:23)"
        }
      ]
    },
    {
      "questao": "τὸ μέρος αὐτῶν (cláusula sem verbo)",
      "escolha": "\"a parte deles será no lago...\" — calque de μέρος e copulativa suprida",
      "justificativa": "μέρος é \"parte/quinhão\"; manter o calque conserva o contraste com a herança dos vitoriosos (v.7: κληρονομήσει ταῦτα).",
      "alternativas_rejeitadas": [
        {
          "opcao": "\"o lugar deles será...\"",
          "motivo": "interpretativo; lugar não está no léxico de μέρος"
        }
      ]
    },
    {
      "questao": "λίμνῃ τῇ καιομένῃ πυρὶ καὶ θείῳ",
      "escolha": "\"lago que arde com fogo e enxofre\"",
      "justificativa": "Presente passivo καιομένη é \"que arde/queima\"; πυρὶ καὶ θείῳ são dativos instrumentais (\"com fogo e enxofre\"). \"Lago\" para λίμνη em toda a fórmula apocalíptica.",
      "alternativas_rejeitadas": [
        {
          "opcao": "\"lago de fogo e enxofre\"",
          "motivo": "fundiria o particípio \"que arde\" na preposição; fica como variante consagrada, não como tradução do texto pinado"
        }
      ]
    },
    {
