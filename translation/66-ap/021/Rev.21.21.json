      "questao": "Construção distributiva ἀνὰ εἷς ἕκαστος τῶν πυλώνων",
      "escolha": "\"cada um dos portões\"; literal preserva o calque \"um cada um\"",
      "justificativa": "ἀνά + numeral é construção distributiva (\"um de cada vez/cada qual\"); ἦν ἐξ ἑνὸς μαργαρίτου → \"era de uma pérola\"; \"única\" vertido para marcar a ênfase de ἑνός em pt-BR.",
      "alternativas_rejeitadas": [
        {
          "opcao": "\"cada qual dos portões\"",
          "motivo": "aceitável, mas \"cada um\" é mais neutro"
        },
        {
          "opcao": "omitir \"única\"",
          "motivo": "o numeral ἑνός carrega a ênfase de singularidade que o pt-BR precisa marcar"
        }
      ]
    },
    {
      "questao": "πλατεῖα e διαυγής",
      "escolha": "\"praça\" e \"transparente\"",
      "justificativa": "πλατεῖα (substantivado de πλατύς, \"larga\") é a rua/avenida principal da cidade; διαυγής é o que é límpido/transparente (só aqui no NT).",
      "alternativas_rejeitadas": [
        {
          "opcao": "\"rua principal\"",
          "motivo": "possível; \"praça\" é a glosa consolidada para a praça/ágora da cidade antiga"
        },
        {
          "opcao": "\"límpido\" para διαυγής",
          "motivo": "aceitável; \"transparente\" é mais imediato e paralelo ao ὕαλος de v.18"
        }
      ]
    },
