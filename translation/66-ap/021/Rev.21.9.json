  "decisoes": [
    {
      "questao": "Referência de τῶν γεμόντων",
      "escolha": "as taças (não os anjos) estão cheias das pragas — \"taças cheias das sete últimas pragas\"",
      "justificativa": "A morfologia pinada traz γεμόντων como V-PAP-GPF (genitivo feminino plural), concordando com φιάλας; γέμω rege genitivo do conteúdo.",
      "alternativas_rejeitadas": [
        {
          "opcao": "\"anjos cheios das sete últimas pragas\"",
          "motivo": "contradiz a morfologia pinada (feminino plural); além disso, em Ap 16 as taças é que contêm as pragas"
        }
      ]
    },
    {
      "questao": "Termos φιάλη e πληγή",
      "escolha": "\"taças\" e \"pragas\"",
      "justificativa": "φιάλη é a taça/bacia do culto (as sete taças da ira, Ap 16:1); πληγή é praga/flagelo; glosas uniformes com Ap 15-16.",
      "alternativas_rejeitadas": [
        {
          "opcao": "\"tigelas\"/\"flagelos\"",
          "motivo": "\"tigelas\" rebaixa o registro cultual; \"flagelos\" duplicaria o lexema sem ganho"
        }
      ]
    },
    {
      "questao": "Δεῦρο + δείξω e a segunda pessoa",
      "escolha": "\"Venha, e eu lhe mostrarei\" (você)",
      "justificativa": "D-0003: anjo falando ao vidente humano → você; δείξω futuro com valor exortativo na construção δεῦρο + futuro.",
      "alternativas_rejeitadas": [
        {
          "opcao": "\"Vem, mostrar-te-ei\"",
          "motivo": "arcaizante fora de registro litúrgico (EDITORIAL §1.2)"
        }
      ]
    },
    {
      "questao": "τὴν νύμφην τὴν γυναῖκα τοῦ ἀρνίου",
      "escolha": "\"a noiva, a esposa do Cordeiro\"",
      "justificativa": "γυνή em aposição a νύμφη é \"esposa\"; ἀρνίον como título cristológico leva maiúscula, consistente em todo o capítulo (vv.14,22,23,27).",
      "alternativas_rejeitadas": [
        {
          "opcao": "\"a noiva, a mulher do cordeiro\"",
          "motivo": "\"mulher\" ambíguo (poderia ler-se feminino genérico); minúscula apagaria o título"
        }
      ]
    },
