    {
      "questao": "O texto pinado (Nestle 1904) traz ἐδόξασεν αὐτήν (não ἑαυτήν). Como verter o pronome acusativo?",
      "escolha": "'glorificou a si mesma', com valor reflexivo de αὐτός.",
      "justificativa": "αὐτός em posição de objeto com sujeito correferente tem força reflexiva em grego helenístico; segue-se o texto pinado (ER-0018) sem criar aparato.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'glorificou a ela' (não reflexivo)",
          "motivo": "o contexto (Κάθημαι βασίλισσα, diz no coração dela) exige correferência"
        },
        {
          "opcao": "'foi glorificada' (passiva)",
          "motivo": "a voz é ativa (V-AAI-3S)"
        }
      ]
    },
    {
      "questao": "Como verter Κάθημαι βασίλισσα (predicativo sem marcador)?",
      "escolha": "'Estou assentada como rainha', suprindo 'como'.",
      "justificativa": "O predicativo nominativo em pt-BR pede marcador; 'como rainha' expressa o estatuto pretendido sem adicionar sentido.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'Estou assentada, rainha'",
          "motivo": "aposto ambíguo em pt-BR (vocativo ou predicativo)"
        },
        {
          "opcao": "'Sento-me rainha'",
          "motivo": "registro arcaizante"
        }
      ]
    },
    {
