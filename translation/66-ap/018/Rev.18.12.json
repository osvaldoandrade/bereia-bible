        }
      ]
    },
    {
      "questao": "Como verter ξύλον θύϊνον?",
      "escolha": "'madeira cítria'.",
      "justificativa": "θύϊνος é adjetivo do citrino (Tetraclinis articulata), madeira aromática de luxo; 'cítria' preserva o lexema sem identificar a espécie errada.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'madeira de cedro' (tradição Almeida)",
          "motivo": "identificação botânica incorreta do lexema"
        },
        {
          "opcao": "'madeira de tuia'",
          "motivo": "a tuia (Thuja) é planta diversa"
        }
      ]
    },
    {
      "questao": "Como verter χαλκός na lista de materiais?",
      "escolha": "'bronze'.",
      "justificativa": "χαλκός em listas de materiais do NT/AT (LXX) cobre o bronze/cobre trabalhado; 'bronze' é a glosa consolidada.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'cobre'",
          "motivo": "possível, mas menos usual para objetos lavorados no registro bíblico pt-BR"
        }
      ]
    }
