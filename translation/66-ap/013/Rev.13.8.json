      "questao": "τοῦ Ἀρνίου: capitalização",
      "escolha": "'Cordeiro' com maiúscula",
      "justificativa": "Ἀρνίον funciona como nome próprio/título cristológico em Apocalipse; ER-0012 reserva maiúscula a nomes próprios plenos. O particípio ἐσφαγμένου remete a σφάζω → 'imolado' (decisão de capítulo, 13:3).",
      "alternativas_rejeitadas": [
        {
          "opcao": "'cordeiro' minúsculo",
          "motivo": "Trata como substantivo comum um título que no livro é nome próprio funcional."
        }
      ]
    },
    {
      "questao": "γέγραπται (perfeito)",
      "escolha": "'está escrito'",
      "justificativa": "Perfeito grego expressa estado presente resultante; 'foi escrito' apagaria o valor estativo.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'foi escrito'",
          "motivo": "Aoristo/português pontual; perde o estado presente do perfeito."
        }
      ]
    },
    {
      "questao": "παντες ... οὗ ... αὐτοῦ (plural × singular distributivo)",
      "escolha": "'todos aqueles cujo nome' (relativo singular distributivo)",
      "justificativa": "O relativo singular οὗ distribui sobre πάντες (cada um cujo nome); o português 'cujo nome' faz o mesmo sem estranheza.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'cujos nomes não estão escritos'",
          "motivo": "Nivela o singular distributivo do grego (οὗ ... τὸ ὄνομα αὐτοῦ)."
        }
      ]
    }
