  "decisoes": [
    {
      "questao": "Glosa de ποιμανεῖ com ῥάβδῳ σιδηρᾷ",
      "escolha": "“regerá” (literal preserva o calque “pastoreará”)",
      "justificativa": "ποιμαίνω cobre reger/pastorear; com vara de ferro o valor de governo é o ativo no contexto (eco de Sl 2.9).",
      "alternativas_rejeitadas": [
        {
          "opcao": "“pastoreará” no publicado",
          "motivo": "choca com vara de ferro em pt-BR vivo"
        },
        {
          "opcao": "“governará”",
          "motivo": "perde o campo semântico pastoral do verbo"
        }
      ]
    },
    {
      "questao": "Cadeia genitiva θυμοῦ τῆς ὀργῆς",
      "escolha": "“do furor da ira”, distinguindo θυμός de ὀργή",
      "justificativa": "os dois lexemas recebem glosas distintas (furor/ira), preservando a gradação do original.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“da ira furiosa”",
          "motivo": "condensa dois lexemas em um"
        }
      ]
    },
    {
      "questao": "πατεῖ (presente) entre futuros",
      "escolha": "“pisa” no presente",
      "justificativa": "preserva o tempo verbal grego sem nivelar com ποιμανεῖ (futuro).",
      "alternativas_rejeitadas": [
        {
          "opcao": "“pisará”",
          "motivo": "nivela o presente histórico ao futuro"
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "Achado PRO-1 (4 pronomes de 3ª pessoa): todos com antecedente claro (o cavaleiro/as nações), estrutura equivalente à da ARA — falso positivo. Verbo 'regerá' avaliado contra as referências: ARA usa a mesma forma; NTLH/NVIPT preferem 'governará' — divergência não unânime e 'reger' não é arcaísmo (não consta em EDITORIAL §1.2), mantido. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
