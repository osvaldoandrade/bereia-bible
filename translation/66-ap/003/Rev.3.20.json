    {
      "questao": "εἰσελεύσομαι πρὸς αὐτόν — sem objeto explícito ('casa')",
      "escolha": "'entrarei para junto dele' (sem suprir 'casa')",
      "justificativa": "o grego não menciona 'casa'; πρός + acusativo indica direção pessoal ('a ele/para junto dele'), não espacial-doméstica; evita acréscimo interpretativo comum em traduções tradicionais.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'entrarei em sua casa' (tradição Almeida)",
          "motivo": "acréscimo não presente no grego (πρὸς αὐτόν é pessoal, não εἰς τὸν οἶκον αὐτοῦ)"
        }
      ]
    },
    {
      "questao": "δειπνήσω — refeição principal do dia",
      "escolha": "'cearei'",
      "justificativa": "δεῖπνον é a refeição principal, geralmente noturna, na cultura greco-romana; 'ceia' preserva o registro e a ressonância bíblica pt-BR.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'jantarei'",
          "motivo": "'cearei' tem maior peso na tradição bíblica pt-BR sem perder naturalidade"
        }
      ]
    },
