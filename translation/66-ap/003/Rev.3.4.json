    {
      "questao": "ὀλίγα ὀνόματα — idiotismo 'nomes' = pessoas",
      "escolha": "'umas poucas pessoas' (sentido idiomático)",
      "justificativa": "ὄνομα no sentido de indivíduo contado nominalmente é uso atestado (cf. At 1:15); a tradução literal preserva 'nomes' para auditoria.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'poucos nomes' no publicado",
          "motivo": "soaria como lista de apelidos em português, obscurecendo o sentido de 'pessoas'"
        }
      ]
    },
    {
      "questao": "ἐν λευκοῖς — elipse do substantivo 'vestes'",
      "escolha": "'vestidas de branco' (substantivo suprido)",
      "justificativa": "o grego elipsa ἱματίοις, retomado do contexto (ἱμάτια αὐτῶν); suprido no publicado por exigência do português (EDITORIAL §4).",
      "alternativas_rejeitadas": []
    },
    {
      "questao": "Revisão editorial do texto_bv",
      "escolha": "não sujaram as suas vestes → não contaminaram as suas vestes",
      "justificativa": "A tradução literal e ARA/NVIPT usam 'contaminaram' (defilement ritual/moral); 'sujaram' é sinônimo de registro mundano que perde a conotação própria do gênero apocalíptico. Mesmo sentido, registro restaurado (EDITORIAL §1.4/piso de naturalidade). — revisão de forma sem alteração de sentido (ER-0019).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
