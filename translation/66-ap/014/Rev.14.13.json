      "questao": "τὸ Πνεῦμα — capitalização",
      "escolha": "'o Espírito' (maiúscula)",
      "justificativa": "Decisão exegética documentada (EDITORIAL §10): sujeito pessoal divino de λέγει que confirma a bem-aventurança; o grego traz Πνεῦμα capitalizado.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'espírito' (minúscula)",
          "motivo": "Inadequado para o sujeito pessoal que fala e valida a palavra profética."
        }
      ]
    },
    {
      "questao": "Γράψον (imperativo dirigido ao vidente)",
      "escolha": "'Escreva' (você); literal 'Escreve'",
      "justificativa": "ER-0003: discurso celestial dirigido a humano usa você; a forma tu fica na camada literal.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'Escreve' no publicado",
          "motivo": "Registro tu fora de oração litúrgica (ER-0003/D-0003)."
        }
      ]
    },
    {
      "questao": "ἤκουσα φωνῆς (genitivo partitivo)",
      "escolha": "'ouvi uma voz'",
      "justificativa": "Genitivo partitivo naturalizado; o mesmo em v.2 ('φωνήν' acusativo) mantém 'uma voz' uniforme.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'ouvi de uma voz'",
          "motivo": "Agramatical em pt-BR."
        }
      ]
    },
    {
      "questao": "ἵνα ἀναπαήσονται",
      "escolha": "'para que descansem'",
      "justificativa": "ἵνα mantido como conjunção; a oscilação final/consecutiva fica registrada como ambiguidade.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'pois descansarão'",
          "motivo": "Resolve a ambiguidade de ἵνα contra a política de preservação (TEOLOGIA §1.5)."
        }
      ]
    },
    {
      "questao": "ἀκολουθεῖ singular com sujeito plural τὰ ἔργα",
      "escolha": "'acompanham' (plural em português)",
      "justificativa": "Impossível preservar a anomalia de número em pt-BR sem agramaticalidade; registrada na justificativa; a literal mantém o calque 'acompanham com eles' (μετ᾽ αὐτῶν).",
      "alternativas_rejeitadas": [
        {
          "opcao": "'a obra ... acompanha'",
          "motivo": "Corrigiria o número alterando o original (plural ἔργα)."
        }
      ]
    }
