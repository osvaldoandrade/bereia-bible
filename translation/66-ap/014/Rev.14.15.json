  "decisoes": [
    {
      "questao": "πέμπω (G3992)",
      "escolha": "'Envie' ('Envie a sua foice')",
      "justificativa": "Valor lexical de πέμπω (enviar); distinto de βάλλω ('lançar') usado na execução (v.16) — distinção lexical mantida.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'Lance' / 'Mete'",
          "motivo": "Antecipa o verbo do v.16 e colapsa πέμπω/βάλλω."
        }
      ]
    },
    {
      "questao": "θερισμός / θερίζω",
      "escolha": "'seara' (θερισμός) e 'ceifar' (θερίζω)",
      "justificativa": "θερισμός aqui é a lavoura em pé que seca; 'seara' cobre esse referente; ὥρα θερίσαι → 'hora de ceifar'.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'colheita' para θερισμός",
          "motivo": "Sugere o ato/resultado, não a lavoura que 'está seca'."
        }
      ]
    },
    {
      "questao": "Dois ὅτι consecutivos",
      "escolha": "'porque... pois...'",
      "justificativa": "O segundo ὅτι é explicativo do primeiro; pt-BR pede diferenciação; a literal repete 'porque' (calque).",
      "alternativas_rejeitadas": [
        {
          "opcao": "'porque... porque...' no publicado",
          "motivo": "Cacofonia/repetição evitável (EDITORIAL §1.3)."
        }
      ]
    },
    {
      "questao": "Segunda pessoa no discurso entre figuras celestiais",
      "escolha": "'Envie/ceife' (você); literal 'Envia/ceifa' (tua)",
      "justificativa": "ER-0003 por extensão: discurso não-oracional entre interlocutores; tu apenas em oração a Deus.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'Envia tu' no publicado",
          "motivo": "Fora do registro litúrgico previsto em D-0003."
        }
      ]
    },
    {
      "questao": "ἐξηράνθη (ξηραίνω)",
      "escolha": "'está seca'",
      "justificativa": "Valor lexical (secar = ponto de colheita); a implicação de madureza não é verbalizada no texto.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'está madura'",
          "motivo": "Importa a implicação exegética para o texto (TEOLOGIA §2)."
        }
      ]
    }
  ],
