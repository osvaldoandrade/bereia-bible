    {
      "questao": "anacoluto grego (πᾶν κτίσμα... ἤκουσα λέγοντας): sujeito nominativo seguido de particípio acusativo",
      "escolha": "reordenar para 'E ouvi toda criatura... dizendo' no publicado, preservando a ordem grega original na literal",
      "justificativa": "ἀκούω + acusativo/particípio é construção grega regular ('ouvir [alguém] dizendo'); a ordem original, com o sujeito antecipado antes do verbo principal, soa deslocada em português corrido.",
      "alternativas_rejeitadas": [
        {
          "opcao": "manter a ordem grega estrita no publicado",
          "motivo": "produz um anacoluto artificial em português, sem equivalente natural na sintaxe alvo"
        }
      ]
    },
    {
      "questao": "κράτος: 'poder' ou 'domínio'",
      "escolha": "domínio",
      "justificativa": "Evita colisão com a glosa já fixada para δύναμις em 5:12, preservando distinção lexical entre os termos gregos ao longo da perícope (EDITORIAL §11).",
      "alternativas_rejeitadas": [
        {
          "opcao": "poder",
          "motivo": "colidiria com a glosa já fixada para δύναμις (5:12), perdendo a distinção lexical entre os dois termos"
        }
      ]
    },
    {
      "questao": "εἰς τοὺς αἰῶνας τῶν αἰώνων: 'para todo o sempre' ou 'pelos séculos dos séculos'",
      "escolha": "para todo o sempre",
      "justificativa": "Fórmula idiomática consolidada em português bíblico contemporâneo; a forma mais literal ('pelos séculos dos séculos') é preservada na tradução literal.",
      "alternativas_rejeitadas": [
        {
          "opcao": "pelos séculos dos séculos",
          "motivo": "mais literal, mas soa arcaizante como fórmula fixa no texto publicado (EDITORIAL §1.2)"
        }
      ]
    }
  ],
