  "decisoes": [
    {
      "questao": "Discurso direto (λέγουσαν + conteúdo que se estende pelos vv. 10–12).",
      "escolha": "Dois-pontos + aspas duplas curvas (ER-0004); as aspas abrem no v. 10 e fecham no fim do v. 12; os vv. 11–12 continuam a citação sem reabertura.",
      "justificativa": "Padrão editorial de discurso direto; a voz narrativa retorna no v. 13 (Καὶ ὅτε εἶδεν...).",
      "alternativas_rejeitadas": [
        {
          "opcao": "reabrir aspas nos vv. 11–12",
          "motivo": "ruído de remarcação fora da prática editorial padronizada"
        }
      ]
    },
    {
      "questao": "Ἄρτι ἐγένετο ἡ σωτηρία.",
      "escolha": "'Agora chegou a salvação'.",
      "justificativa": "ἐγένετο com valor advento/estabelecimento; 'chegou' é natural e fiel ao sentido de consumação inaugurada.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'aconteceu a salvação'",
          "motivo": "achatado; perde a nuance adventícia"
        },
        {
          "opcao": "'realizou-se a salvação'",
          "motivo": "expansão interpretativa"
        }
      ]
    },
    {
      "questao": "Paronomásia κατήγωρ (G2725, forma ática) / κατηγορῶν (G2723).",
      "escolha": "Preservar 'acusador... que os acusa', sem nivelamento.",
      "justificativa": "O original repete a raiz; harmonização artificial é proibida (TEOLOGIA §2); ambos os lexemas ficam auditáveis.",
      "alternativas_rejeitadas": [
        {
          "opcao": "variar para 'denunciador/denuncia'",
          "motivo": "desvia da glosa lexical natural e da tradição consolidada"
        }
      ]
    },
    {
      "questao": "ἐβλήθη sem destino expresso (cf. v. 9, εἰς τὴν γῆν).",
      "escolha": "'foi lançado' simples — não suprir 'fora'.",
      "justificativa": "O grego não codifica destino aqui; suprimento seria expansão (EDITORIAL §4; TEOLOGIA §2).",
      "alternativas_rejeitadas": [
        {
          "opcao": "'foi lançado fora'",
          "motivo": "supre partícula ausente do grego, embora sugerida pelo contexto"
        }
      ]
    }
  ],
