    {
      "questao": "ἐξουσία",
      "escolha": "autoridade",
      "justificativa": "Valor lexical próprio (direito/poder legítimo de ação), distinto de δύναμις ('poder' como capacidade).",
      "alternativas_rejeitadas": [
        {
          "opcao": "poder",
          "motivo": "colapsaria com δύναμις caso este ocorresse no contexto"
        },
        {
          "opcao": "domínio",
          "motivo": "não é o valor do lexema"
        }
      ]
    },
    {
      "questao": "μακάριος καὶ ἅγιος ὁ ἔχων (sem cópula)",
      "escolha": "suprir 'é' no publicado: 'Bem-aventurado e santo é aquele que tem parte...'",
      "justificativa": "Cópula exigida pelo português (EDITORIAL §4); o participio ὁ ἔχων vira 'aquele que tem'.",
      "alternativas_rejeitadas": [
        {
          "opcao": "bem-aventurado e santo, o que tem parte...",
          "motivo": "fragmento nominal ambíguo em leitura em voz alta"
        }
      ]
    },
    {
      "questao": "τὰ χίλια ἔτη (acusativo de duração com artigo)",
      "escolha": "'mil anos' no publicado; literal preserva 'os mil anos'",
      "justificativa": "O artigo grego de duração não tem correspondente natural em pt-BR; ER-0013: o calque fica na literal.",
      "alternativas_rejeitadas": [
        {
          "opcao": "durante os mil anos",
          "motivo": "expansão preposicional não exigida"
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "Duas das três referências (NTLH, NVIPT) usam 'felizes' em vez de 'bem-aventurado', mas ARA converge com a BV; 'bem-aventurado' é registro formal-litúrgico vivo em português contemporâneo, não arcaísmo funcionalmente morto (não consta em EDITORIAL §1.2-tabela). Quanto a 'autoridade' — as três referências usam 'poder' — a BV preserva o termo mais preciso para ἐξουσία, coerente com a traducao_literal; ambos são palavras contemporâneas. Mantido sem alteração. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
