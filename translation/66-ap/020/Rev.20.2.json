    {
      "questao": "Distinção lexical κρατέω × δέω no mesmo verso",
      "escolha": "κρατέω → 'agarrou'; δέω → 'prendeu' (literal: 'amarrou')",
      "justificativa": "Dois atos distintos (capturar × amarrar); nivelar ambos como 'prendeu' apagaria a sequência do original.",
      "alternativas_rejeitadas": [
        {
          "opcao": "segurou / prendeu",
          "motivo": "'segurou' é fraco para κρατέω+acusativo; repetir 'prendeu' colapsa com ἔδησεν"
        },
        {
          "opcao": "atou",
          "motivo": "arcaísmo funcionalmente morto (EDITORIAL §1.2)"
        }
      ]
    },
    {
      "questao": "ὁ ὄφις ὁ ἀρχαῖος",
      "escolha": "a antiga serpente",
      "justificativa": "Ordem adjetivo-substantivo natural em pt-BR; a ordem substantivo-adjetivo permanece na literal (ER-0013).",
      "alternativas_rejeitadas": [
        {
          "opcao": "a serpente antiga",
          "motivo": "equivalente pleno; a escolha pela ordem natural não altera sentido"
        }
      ]
    },
    {
      "questao": "Artigo grego em Ὁ Σατανᾶς e Διάβολος",
      "escolha": "o Diabo e Satanás",
      "justificativa": "Nomes consolidados pt-BR (EDITORIAL §8); o artigo diante de Satanás não é vertido, pois o uso pt-BR é anartro.",
      "alternativas_rejeitadas": [
