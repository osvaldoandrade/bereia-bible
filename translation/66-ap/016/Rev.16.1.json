      ]
    },
    {
      "questao": "φιάλη (G5357)",
      "escolha": "taça",
      "justificativa": "Vaso largo de libação; glosa única para todo o ciclo das sete taças (16:1-21); registro contemporâneo.",
      "alternativas_rejeitadas": [
        {
          "opcao": "salva",
          "motivo": "Arcaísmo da tradição Almeida, funcionalmente morto (EDITORIAL 1.2)."
        },
        {
          "opcao": "tigela",
          "motivo": "Rebaixa o registro cultual do termo."
        }
      ]
    },
    {
      "questao": "θυμός (G2372)",
      "escolha": "furor",
      "justificativa": "Distingue de ὀργή ('ira', v.19), que ocorre na mesma cadeia genitiva ('vinho do furor da sua ira'); glosa fixa para θυμός no capítulo.",
      "alternativas_rejeitadas": [
        {
          "opcao": "ira",
          "motivo": "Colapsaria os dois lexemas em 16:19."
        }
      ]
    },
    {
      "questao": "Imperativos 2P Ὑπάγετε καὶ ἐκχέετε dirigidos aos anjos",
      "escolha": "Vão e derramem (vocês)",
      "justificativa": "ER-0003/D-0003 (provisória) aplicada por analogia a interlocutor plural celeste; vós é arcaísmo funcionalmente morto; distinção de número preservada no plural.",
      "alternativas_rejeitadas": [
        {
          "opcao": "Ide e derramai",
          "motivo": "Vós funcionalmente morto fora do registro litúrgico dirigido a Deus (EDITORIAL 1.2)."
        },
        {
          "opcao": "Vá cada um e derrame",
          "motivo": "Dissolve o plural do imperativo."
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "As três referências (NTLH/ARA/NVIPT) usam 'ira' aqui, mas o grego distingue θυμός (furor) de ὀργή (ira); a BV usa 'furor' para θυμός e 'ira' para ὀργή de forma consistente no capítulo (cf. Rev.16.19 'furor da sua ira' = θυμοῦ τῆς ὀργῆς, onde as três referências também usam 'furor'). Não é arcaísmo nem inconsistência: é distinção lexical proposital mantida (§1.4). (ER-0019 v2).",
