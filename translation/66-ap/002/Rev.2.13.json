  "decisoes": [
    {
      "questao": "καὶ ἐν ταῖς ἡμέραις Ἀντιπᾶς...: anacoluto grego",
      "escolha": "'nem mesmo nos dias de Antipas...' (suprido conector)",
      "justificativa": "A sintaxe grega é quebrada aqui (falta verbo principal claro); o português exige conector para ser gramatical. A literal preserva a quebra sintática.",
      "alternativas_rejeitadas": [
        {
          "opcao": "reescrever como oração subordinada temporal plena",
          "motivo": "normaliza demais, apagando o anacoluto como dado do texto"
        }
      ]
    },
    {
      "questao": "μάρτυς: 'testemunha' ou 'mártir'?",
      "escolha": "testemunha",
      "justificativa": "μάρτυς no grego do séc. I significa 'testemunha' (jurídica/pública); o sentido técnico de 'mártir' é desenvolvimento eclesiástico posterior (TEOLOGIA proíbe retroprojetar).",
      "alternativas_rejeitadas": [
        {
          "opcao": "mártir",
          "motivo": "retroprojeta sentido pós-apostólico consolidado só depois do séc. II"
        }
      ]
    },
    {
      "questao": "ὑμῖν (plural) em παρ' ὑμῖν",
      "escolha": "'entre vocês' (plural preservado)",
      "justificativa": "Mesmo padrão do v.10: o texto muda para plural ao mencionar a comunidade mais ampla, voltando ao singular no restante.",
      "alternativas_rejeitadas": []
    },
