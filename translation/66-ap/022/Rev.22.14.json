  "decisoes": [
    {
      "questao": "ἐξουσία αὐτῶν ἐπὶ τὸ ξύλον τῆς ζωῆς",
      "escolha": "Publicado 'tenham direito à árvore da vida'; literal 'seja a autoridade deles sobre a árvore da vida'",
      "justificativa": "ἐξουσία aqui denota direito de acesso (não domínio sobre a árvore); a forma literal fica preservada (ER-0013).",
      "alternativas_rejeitadas": [
        {
          "opcao": "'autoridade sobre a árvore' no publicado",
          "motivo": "Sugeriria domínio sobre a árvore, sentido que o contexto de acesso não sustenta."
        }
      ]
    },
    {
      "questao": "στολή",
      "escolha": "'vestes'",
      "justificativa": "Glosa consolidada para as vestes dos santos no Apocalipse.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'roupas'",
          "motivo": "Rebaixa o registro do símbolo."
        }
      ]
    },
    {
      "questao": "πυλῶσιν",
      "escolha": "'portões'",
      "justificativa": "πυλών é o portão monumental da cidade (cf. 21.12-25); distinto de θύρα (porta comum).",
      "alternativas_rejeitadas": [
        {
          "opcao": "'portas'",
          "motivo": "Perderia a distinção lexical πυλών × θύρα presente no livro."
        }
      ]
    },
    {
      "questao": "ἵνα + futuro/ subjuntivo (ἔσται / εἰσέλθωσιν)",
      "escolha": "'para que tenham... e entrem' (subjuntivo pt)",
      "justificativa": "Oração final vertida com subjuntivo, exigência gramatical do pt; valor de propósito mantido.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'para que será...'",
          "motivo": "Agramatical em pt-BR."
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "ARA e NVIPT usam 'portas', mas a BV segue a decisão lexical já registrada no capítulo 21 (Ap 21.12/13/15/21/25: πυλών → 'portão/portões', reservando 'porta' para θύρα, evitando colapso de termos); NTLH também usa 'portões'. Manter garante consistência lexical intra-livro (§1.4). (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
