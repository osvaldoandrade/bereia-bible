    {
      "questao": "Manutenção do texto_bv (revisão ER-0024 v2)",
      "escolha": "texto mantido",
      "justificativa": "Ap 22.19 é outro lócus clássico de variante textual: a KJV traz 'out of the book of life' (TR: βίβλου, 'livro'), mas o Nestle 1904 pinado tem ξύλου ('árvore') — a BV segue corretamente 'árvore da vida', não a leitura da KJV. A relativa 'que estão escritas' concorda no plural feminino com o conjunto 'a árvore da vida e da cidade santa', sem ambiguidade de antecedente. (ER-0024 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0024"
    }
