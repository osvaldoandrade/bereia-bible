  "decisoes": [
    {
      "questao": "Ordem τοῦ βιβλίου τῆς προφητείας ταύτης",
      "escolha": "'do livro desta profecia' (distinto de 'da profecia deste livro' nos vv.7,10,18)",
      "justificativa": "O grego inverte a ordem em relação aos outros versos; a BV preserva a distinção em vez de harmonizar (TEOLOGIA §2).",
      "alternativas_rejeitadas": [
        {
          "opcao": "'da profecia deste livro'",
          "motivo": "Harmonização artificial entre fórmulas que o grego diferencia."
        }
      ]
    },
    {
      "questao": "τῶν γεγραμμένων ἐν τῷ βιβλίῳ τούτῳ (genitivo neutro plural)",
      "escolha": "Ler como aposição a 'árvore da vida e cidade santa'; publicado 'que estão escritas neste livro'",
      "justificativa": "O genitivo neutro plural remete às realidades descritas (árvore e cidade); a aposição é a leitura sintática mais direta.",
      "alternativas_rejeitadas": [
        {
          "opcao": "Ligar τῶν γεγραμμένων a 'a sua parte'",
          "motivo": "A parte (μέρος) não é 'as coisas escritas'; a ligação com os dois substantivos precedentes é mais próxima."
        }
      ]
    },
    {
      "questao": "ἀφέλῃ sem objeto expresso",
      "escolha": "Suprir 'algo'",
      "justificativa": "Exigência do português (EDITORIAL §4), como no v.18.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'se alguém tirar das palavras'",
          "motivo": "Agramatical sem objeto direto."
        }
      ]
    },
