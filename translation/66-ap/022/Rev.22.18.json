      "questao": "Ausência de marcador de citação após Μαρτυρῶ",
      "escolha": "Dois-pontos sem aspas; o conteúdo segue como complemento direto",
      "justificativa": "O grego não traz ὅτι recitativo nem λέγων; política uniforme: aspas só onde há verbo de fala explícito (TEOLOGIA §2).",
      "alternativas_rejeitadas": [
        {
          "opcao": "Aspas no conteúdo",
          "motivo": "Inseriria fronteira de discurso que a fonte não codifica."
        }
      ]
    },
    {
      "questao": "ἐάν τις ἐπιθῇ ἐπ' αὐτά (sem objeto expresso)",
      "escolha": "Suprir 'algo' e 'lhes' no publicado",
      "justificativa": "Português exige objeto para 'acrescentar' (EDITORIAL §4); o grego o deixa implícito.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'se alguém acrescentar sobre elas'",
          "motivo": "Agramatical sem objeto em pt-BR."
        }
      ]
    },
    {
      "questao": "Repetição de ἐπιτίθημι (ἐπιθῇ... ἐπιθήσει)",
      "escolha": "Manter 'acrescentar... acrescentará'",
      "justificativa": "A ironia léxica do original (mesmo verbo para o ato e para a pena) é preservada.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'acrescentar... lançará sobre ele'",
          "motivo": "Apagaria o jogo verbal com o mesmo lexema."
        }
      ]
    },
