  "decisoes": [
    {
      "questao": "τὸ Πνεῦμα (capitalizado na fonte)",
      "escolha": "'o Espírito' com maiúscula",
      "justificativa": "A fonte traz Πνεῦμα capitalizado; o referente é pessoal e divino (par com 'a noiva', sujeito plural de 'dizem'); decisão exegética documentada (EDITORIAL §10), paralela à jurisprudência de Gn 1.2.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'o espírito' minúsculo",
          "motivo": "Ignoraria a marcação da fonte e a pessoalidade do sujeito que fala."
        }
      ]
    },
    {
      "questao": "Ἔρχου (imperativo 2ª singular, duas vezes)",
      "escolha": "'Vem' (registro de tu, oração)",
      "justificativa": "D-0003: oração dirigida a Deus usa tu; o grito 'Vem' ecoa a prece do v.20 ('Vem, Senhor Jesus').",
      "alternativas_rejeitadas": [
        {
          "opcao": "'Venha'",
          "motivo": "Forma de você caberia apenas se o alvo fosse humano; a leitura primária é prece a Cristo."
        }
      ]
    },
    {
      "questao": "ἐρχέσθω / λαβέτω (imperativos de 3ª pessoa)",
      "escolha": "'venha' / 'receba' (forma de você)",
      "justificativa": "Convite aos sedentos/quem quiser: imperativo de 3ª pessoa vertido na forma de você (D-0003).",
      "alternativas_rejeitadas": [
        {
          "opcao": "'venha ele'/'receba ele'",
          "motivo": "Pronome pleonástico desnecessário."
        }
      ]
    },
    {
      "questao": "δωρεάν",
      "escolha": "'de graça'",
      "justificativa": "Locução viva e natural.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'gratuitamente'",
          "motivo": "Mais pesado; sem ganho de sentido."
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "Achado VOS-1 é falso-positivo: o marcador mecânico casa 'sede' com a forma imperativa de vós ('sede' = 'sejam'), mas aqui 'sede' é o substantivo comum ('quem tem sede' = thirst) — não há paradigma vós no verso, como confirma a quase identidade com a ARA. Nenhuma normalização aplicável. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
  "palavras_supridas": [],
  "ambiguidades_preservadas": [
    "Destinatário do 'Vem' do Espírito e da noiva: prece a Cristo (leitura primária, coerente com v.20) ou convite aos ouvintes; a forma imperativa singular é idêntica nos dois casos e o grego não resolve."
  ],
  "justificativa": "νύμφη → 'noiva' (cf. 21.2,9). Discursos marcados por λέγουσιν/εἰπάτω recebem aspas (ER-0004).",
