  "decisoes": [
    {
      "questao": "ξύλον (G3586) no singular, embora ἐντεῦθεν καὶ ἐκεῖθεν sugira dois lados do rio",
      "escolha": "'árvore da vida' no singular, preservando a forma do grego",
      "justificativa": "O grego traz ξύλον singular (e τὰ φύλλα τοῦ ξύλου na sequência); a leitura coletiva não é decidida no texto (TEOLOGIA §1.5).",
      "alternativas_rejeitadas": [
        {
          "opcao": "'árvores da vida'",
          "motivo": "Harmonização com uma interpretação espacial que o grego não explicita."
        }
      ]
    },
    {
      "questao": "ἐντεῦθεν καὶ ἐκεῖθεν",
      "escolha": "'de um lado e do outro'",
      "justificativa": "Locução viva e espacialmente neutra.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'de cá e de lá'",
          "motivo": "Arcaizante (EDITORIAL §1.2)."
        }
      ]
    },
    {
      "questao": "Cláusulas sem verbo (ξύλον...; φύλλα... εἰς θεραπείαν)",
      "escolha": "Suprir 'estava' e 'são' no publicado; literal mantém a ausência verbal",
      "justificativa": "Português exige verbo finito (EDITORIAL §4); a literal preserva a cláusula nominal.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'havia'/'existia'",
          "motivo": "Verbo existencial adicionaria matiz não presente na descrição."
        }
      ]
    },
    {
      "questao": "τῶν ἐθνῶν",
      "escolha": "'das nações'",
      "justificativa": "Em Ap 21–22 ἔθνος são as nações redimidas que caminham à luz da cidade (21.24-26).",
      "alternativas_rejeitadas": [
        {
          "opcao": "'dos gentios'",
          "motivo": "Sentido paulino estranho ao contexto da nova Jerusalém."
        }
      ]
    }
  ],
  "palavras_supridas": [
    "estava",
    "são",
    "que (relativo)"
  ],
  "ambiguidades_preservadas": [
    "A sintaxe espacial da primeira cláusula (a árvore 'no meio da praça e do rio, de um lado e do outro') é mantida formalmente como no grego, sem resolver se a árvore está na praça e nas duas margens ou entre a praça e o rio."
  ],
  "justificativa": "Verso de sintaxe comprimida; a BV conserva a ordem e a ausência de verbo na literal e registra a ambiguidade espacial em vez de resolvê-la (TEOLOGIA §1.5). Numeral 'doze' por extenso (EDITORIAL §7).",
