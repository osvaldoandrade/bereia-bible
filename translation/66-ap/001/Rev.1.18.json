      "questao": "ὁ Ζῶν — maiúscula como título",
      "escolha": "o Vivente (maiúsculo)",
      "justificativa": "Particípio articular substantivado, capitalizado na fonte grega, funcionando como autodesignação divina em continuidade com 'Eu sou o primeiro e o último' (v.17); tratado como título por paralelismo com as demais autodesignações do livro.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'o que vive' (minúsculo)",
          "motivo": "perde o caráter de título/autodesignação sinalizado pela articulação e pela capitalização da fonte"
        }
      ]
    },
    {
      "questao": "τοῦ Ἅιδου — 'Hades' vs 'inferno'",
      "escolha": "Hades (transliterado)",
      "justificativa": "Ἅιδης é termo grego específico para o reino/personificação dos mortos, distinto de Γέεννα ('geena', usualmente traduzido 'inferno' como lugar de castigo final); manter a transliteração evita conflacionar os dois conceitos gregos distintos sob um único termo português.",
      "alternativas_rejeitadas": [
        {
          "opcao": "inferno",
          "motivo": "tradução tradicional (Almeida), mas conflaciona Ἅιδης com Γέεννα, apagando distinção lexical relevante do original"
        }
      ]
    }
