        {
          "opcao": "Resumir como “os levitas”",
          "motivo": "Omitiria cinco unidades genealógicas."
        },
        {
          "opcao": "Substituir coraítas por coatitas",
          "motivo": "Apagaria o clã específico de Corá."
        }
      ]
    },
    {
