    {
      "questao": "Como verter רַב/מְעַט e פְקֻדָיו?",
      "escolha": "“grupo maior/menor” e “número de seus recenseados”",
      "justificativa": "רב e מעט contrastam grupos numerosos e menos numerosos; פקודיו são os registrados de cada unidade. A BV torna explícito o referente coletivo sem mudar o princípio.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“ao rico e ao pobre”",
          "motivo": "Muda quantidade populacional para condição econômica."
        },
        {
          "opcao": "“a todos a mesma extensão”",
          "motivo": "Contradiz a proporcionalidade."
        }
      ]
    },
    {
      "questao": "Como tratar o singular אִישׁ?",
      "escolha": "“cada grupo”",
      "justificativa": "O singular distributivo aplica a regra a cada unidade recenseada; “grupo” evita sugerir lotes pessoais a cada homem antes da distribuição tribal.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“cada indivíduo escolherá sua terra”",
          "motivo": "Acrescenta escolha pessoal não expressa."
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "RED-1 (“menor… herança”) é falso positivo: o paralelismo antitético “maior… maior / menor… menor” é estrutura retórica intencional do hebraico, preservada por ARA (“maior… maior… menor… menor”) e NVIPT (idem). Fórmula intencional mantida (EDITORIAL, item 4). (ER-0019 v2).",
      "alternativas_rejeitadas": [],
