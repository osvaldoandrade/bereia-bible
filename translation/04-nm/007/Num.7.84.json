  "decisoes": [
    {
      "questao": "Como relacionar חֲנֻכָּה e os totais?",
      "escolha": "“ofertas de consagração do altar”",
      "justificativa": "O resumo identifica o conjunto dos objetos apresentados como a dedicação inaugural do altar. O plural português concorda com os itens enumerados, enquanto a literal mantém o singular abstrato.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“utensílios permanentes do altar”",
          "motivo": "O verso os resume como dádivas da consagração, sem definir aqui seu uso posterior."
        },
        {
          "opcao": "“doze ofertas no total”",
          "motivo": "Cada oferta continha três recipientes e animais; o verso totaliza por tipo."
        }
      ]
    },
    {
      "questao": "Como manter os três totais?",
      "escolha": "“doze pratos ... doze bacias ... doze colheres”",
      "justificativa": "Cada tipo aparece uma vez por líder durante doze dias. A repetição do número para cada classe é preservada.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“trinta e seis utensílios” apenas",
          "motivo": "A soma é correta, mas omite a distribuição por tipo."
        },
        {
          "opcao": "“doze utensílios”",
          "motivo": "Confunde o número de cada classe com o total geral."
        }
      ]
    },
    {
      "questao": "Revisão editorial do texto_bv",
      "escolha": "doze pratos e doze bacias de prata → doze pratos de prata e doze bacias de prata",
      "justificativa": "Clareza de referência (§1.3): a construção original era ambígua quanto à distribuição do modificador 'de prata' (aplicava-se apenas a 'bacias' ou a ambos?). Especificação de material para cada item, alinhando com ARA ('doze salvas de prata, doze bacias de prata') e NVIPT ('doze pratos de prata, doze bacias de prata'). — revisão de forma sem alteração de sentido (ER-0019).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
