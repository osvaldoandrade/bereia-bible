      "questao": "Como verter נְשִׂיאִים e רָאשֵׁי?",
      "escolha": "“líderes” e “chefes”",
      "justificativa": "נָשִׂיא designa os representantes tribais já nomeados; רֹאשׁ caracteriza sua posição à frente das casas paternas. A diferenciação evita usar dois títulos portugueses como se fossem cargos distintos e desconhecidos.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“príncipes” para נְשִׂיאִים",
          "motivo": "Pode sugerir monarquia hereditária não indicada."
        },
        {
          "opcao": "“reis das tribos”",
          "motivo": "Acrescenta estatuto real ausente."
        }
      ]
    },
    {
      "questao": "Como verter הָעֹמְדִים עַל־הַפְּקֻדִים?",
      "escolha": "“responsáveis pelos recenseados”",
      "justificativa": "A expressão descreve supervisão sobre os homens contados no censo. Não afirma que os líderes eram apenas funcionários de registro.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“em pé sobre os cadáveres”",
          "motivo": "Lê literalmente a preposição fora do contexto censitário."
        },
        {
          "opcao": "“responsáveis por toda a população”",
          "motivo": "Amplia além do grupo recenseado."
        }
      ]
    },
