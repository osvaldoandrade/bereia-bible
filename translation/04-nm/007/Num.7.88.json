        {
          "opcao": "“sessenta novilhos”",
          "motivo": "Ignora que cada líder ofereceu dois, não cinco."
        }
      ]
    },
    {
      "questao": "Como fechar חֲנֻכַּת הַמִּזְבֵּחַ?",
