    {
      "questao": "Como verter וַיִּרְאוּ ... כִּי גָוַע?",
      "escolha": "“percebeu que Arão havia morrido”",
      "justificativa": "ראה com כי pode indicar ver ou reconhecer um fato. Como a morte ocorreu no topo e dois homens desceram, “percebeu” evita afirmar visão direta do momento da morte.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“assistiu à morte no topo”",
          "motivo": "Exige percepção visual direta não declarada."
        },
        {
          "opcao": "“imaginou falsamente que morreu”",
          "motivo": "Enfraquece o fato narrado."
        }
      ]
    },
    {
      "questao": "Como preservar o luto de trinta dias?",
      "escolha": "“toda a casa de Israel chorou por ele durante trinta dias”",
      "justificativa": "בכה com objeto marca lamentação por Arão; a duração e o sujeito abrangente são explícitos. “Casa de Israel” é mantida como designação coletiva.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“alguns choraram por três dias”",
          "motivo": "Reduz sujeito e duração."
        },
        {
          "opcao": "“celebraram por trinta dias”",
          "motivo": "Inverte o caráter do luto."
        }
      ]
    },
