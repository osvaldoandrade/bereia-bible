    {
      "questao": "Como preservar a exclusão do grupo de Corá?",
      "escolha": "“não fazia parte ... do grupo de Corá”",
      "justificativa": "As filhas negam explicitamente que seu pai tenha integrado a reunião rebelde contra o SENHOR. A BV não apaga essa defesa jurídica nem declara que ele era sem pecado.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“ele pertencia ao grupo de Corá”",
          "motivo": "Inverte a alegação das filhas."
        },
        {
          "opcao": "“ele nunca pecou”",
          "motivo": "Contradiz a frase seguinte."
        }
      ]
    },
    {
      "questao": "Como verter כִּי־בְחֶטְאוֹ מֵת?",
      "escolha": "“morreu por seu próprio pecado”",
      "justificativa": "A expressão atribui a morte ao pecado dele sem identificar qual foi. A BV não inventa delito, punição específica ou ligação secreta com Corá.",
      "alternativas_rejeitadas": [
        {
          "opcao": "nomear um pecado específico",
          "motivo": "Vai além do hebraico."
        },
        {
          "opcao": "“morreu pelo pecado de outro”",
          "motivo": "Troca o possessivo."
        }
      ]
    },
    {
      "questao": "Como verter וּבָנִים לֹא־הָיוּ לוֹ?",
      "escolha": "“não teve filhos homens”",
      "justificativa": "בָּנִים contrasta juridicamente com as filhas que falam; “filhos homens” evita que o português genérico sugira ausência de descendentes de ambos os sexos.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“não teve descendente algum”",
          "motivo": "Apaga as cinco filhas presentes."
        },
        {
          "opcao": "“teve vários filhos homens”",
          "motivo": "Inverte o dado sucessório."
        }
      ]
    },
