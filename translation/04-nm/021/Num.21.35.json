      "questao": "Como preservar עַד־בִּלְתִּי הִשְׁאִיר־לוֹ שָׂרִיד?",
      "escolha": "“até não lhe restar sobrevivente algum”",
      "justificativa": "A negação e o substantivo שריד afirmam ausência de sobreviventes no grupo atingido. A BV não suaviza nem amplia para povos não nomeados.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“venceram sem baixas”",
          "motivo": "Refere a sobrevivência a Israel, não ao povo de Ogue."
        },
        {
          "opcao": "“alguns escaparam”",
          "motivo": "Contradiz a negação."
        },
        {
          "opcao": "“eliminaram toda a população de Basã para sempre”",
          "motivo": "Amplia temporal e geograficamente além do grupo e da terra do relato."
        }
      ]
    },
    {
      "questao": "Como verter וַיִּירְשׁוּ?",
      "escolha": "“tomaram posse”",
      "justificativa": "ירש descreve adquirir e ocupar a terra após a derrota; “tomaram posse” mantém a sequência militar e territorial.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“apenas atravessaram”",
          "motivo": "Apaga a posse."
        },
        {
          "opcao": "“receberam por compra”",
          "motivo": "Acrescenta transação não narrada."
        }
      ]
    },
