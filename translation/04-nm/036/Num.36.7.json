  "decisoes": [
    {
      "questao": "Como verter תִסֹּב no princípio jurídico?",
      "escolha": "“passará de uma tribo para outra”",
      "justificativa": "סב descreve a herança mudando de vínculo tribal. “Passar” preserva a transferência sem transformá-la em compra, confisco ou divisão moderna.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“será vendida livremente entre tribos”",
          "motivo": "Acrescenta uma transação."
        },
        {
          "opcao": "“será extinta”",
          "motivo": "Muda transferência para desaparecimento."
        }
      ]
    },
    {
      "questao": "Como preservar אִישׁ ... יִדְבְּקוּ?",
      "escolha": "“os israelitas, cada um, permanecerão ligados”",
      "justificativa": "O singular distributivo אִישׁ ocorre com o verbo plural cujo sujeito é “os israelitas”. A BV mantém o conjunto e a obrigação individual de aderir à herança ancestral.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“somente um israelita ficará ligado”",
          "motivo": "Ignora o plural do sujeito."
        },
        {
          "opcao": "“as tribos poderão abandonar suas heranças”",
          "motivo": "Inverte דבק."
        }
      ]
    },
    {
      "questao": "Revisão editorial do texto_bv",
      "escolha": "os israelitas, cada um, permanecerão ligados → os israelitas, cada um, permanecerá ligado",
      "justificativa": "Correção de concordância: o núcleo do sujeito é “cada um” (singular), exigindo verbo no singular (“permanecerá”) e particípio concordando no singular (“ligado”). ARA igualmente usa o singular: “os filhos de Israel se apegarão cada um à herança”. Mudança puramente gramatical, sem alteração de sentido. — revisão de forma sem alteração de sentido (ER-0019).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
