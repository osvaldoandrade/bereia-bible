  "decisoes": [
    {
      "questao": "Quem executa o ritual de expiação?",
      "escolha": "Arão, seguindo a ordem de Moisés",
      "justificativa": "Moisés dá cinco ordens no singular a Arão: pegar, pôr fogo do altar, pôr incenso, levar e fazer expiação. A BV mantém Arão como agente ritual e Moisés como instrutor.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“Moisés leva o incensário”",
          "motivo": "Troca o agente dos imperativos."
        },
        {
          "opcao": "“a comunidade faz expiação por si”",
          "motivo": "Elimina a mediação sacerdotal."
        }
      ]
    },
    {
      "questao": "Como verter וְכַפֵּר עֲלֵיהֶם?",
      "escolha": "“para fazer expiação por eles”",
      "justificativa": "A expressão recebe a terminologia consolidada. O verso vincula a ação ao incenso e ao fogo do altar sem explicar o mecanismo além da sequência.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“perdoe-os por autoridade própria”",
          "motivo": "Atribui a Arão poder independente."
        },
        {
          "opcao": "“faça uma oração apenas”",
          "motivo": "Omite o rito explícito com incensário e incenso."
        }
      ]
    },
    {
      "questao": "Como verter יָצָא הַקֶּצֶף e הֵחֵל הַנָּגֶף?",
      "escolha": "“A ira saiu ...; a praga começou”",
      "justificativa": "קֶצֶף é a ira que procede de diante do SENHOR; נֶגֶף é o golpe coletivo aqui manifesto como praga. As duas orações breves comunicam urgência.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“uma doença talvez comece”",
          "motivo": "Enfraquece certeza e urgência."
        },
        {
          "opcao": "“a ira de Arão saiu”",
          "motivo": "Troca a origem expressa."
        }
      ]
    }
  ],
