    {
      "questao": "Como recuperar o objeto de וַיִּקַּח?",
      "escolha": "“Arão pegou o incensário”",
      "justificativa": "O objeto fica elíptico, mas a ordem imediatamente anterior nomeia o incensário. A BV o recupera sem acrescentar outro utensílio.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“Arão pegou Moisés”",
          "motivo": "Usa o antecedente errado."
        },
        {
          "opcao": "“Arão pegou uma oferta animal”",
          "motivo": "Insere objeto ausente da sequência."
        }
      ]
    },
    {
      "questao": "Como preservar a sequência ritual?",
      "escolha": "Correr, constatar a praga, pôr incenso e fazer expiação",
      "justificativa": "Arão obedece e executa pessoalmente as ações. A BV não atribui o ato de expiação ao incensário isoladamente nem omite o incenso.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“o incenso correu até o povo”",
          "motivo": "Troca o agente humano."
        },
        {
          "opcao": "“a expiação ocorreu antes do incenso”",
          "motivo": "Reordena a sequência textual."
        }
      ]
    },
    {
