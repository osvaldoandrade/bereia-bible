      "questao": "Como preservar a fórmula distributiva repetida?",
      "escolha": "“uma vara para cada líder, uma vara para cada líder”",
      "justificativa": "O hebraico repete a unidade individual antes de declarar doze varas. A BV conserva a repetição para tornar auditável a distribuição.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“os líderes trouxeram algumas varas”",
          "motivo": "Omite repetição e total."
        },
        {
          "opcao": "“cada líder trouxe duas varas”",
          "motivo": "Interpreta a repetição como duplicação numérica."
        }
      ]
    },
    {
      "questao": "As doze varas excluem ou incluem a de Arão?",
      "escolha": "“doze varas. A vara de Arão estava entre as varas deles”",
      "justificativa": "בְּתוֹךְ, “no meio de”, apresenta a vara de Arão entre o conjunto entregue. A BV não declara uma décima terceira vara nem omite a menção adicional de Arão.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“treze varas ao todo”",
          "motivo": "Acrescenta uma soma não declarada."
        },
        {
          "opcao": "“doze varas sem a de Arão”",
          "motivo": "Contraria a presença dela entre as varas."
        }
      ]
    }
