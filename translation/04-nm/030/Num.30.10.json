    {
      "questao": "Como distinguir אַלְמָנָה e גְּרוּשָׁה?",
      "escolha": "“viúva” e “mulher divorciada”",
      "justificativa": "As duas condições são categorias separadas e ambas deixam o compromisso sobre a própria mulher. A BV não as funde nem usa “abandonada” como termo genérico.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“mulher casada” para ambas",
          "motivo": "Contradiz os estados nomeados."
        },
        {
          "opcao": "“repudiada”",
          "motivo": "É possível historicamente, mas “divorciada” é a glosa consolidada e contemporânea."
        }
      ]
    },
    {
      "questao": "Quem valida ou invalida neste caso?",
      "escolha": "O verso não nomeia pai ou marido; o compromisso permanece válido para ela",
      "justificativa": "O texto afirma diretamente קום עליה. A BV não introduz nova autoridade doméstica nem exceção.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“um novo marido o anula automaticamente”",
          "motivo": "Acrescenta caso não descrito."
        },
        {
          "opcao": "“nenhum voto de viúva vale”",
          "motivo": "Inverte a norma."
        }
      ]
    },
    {
