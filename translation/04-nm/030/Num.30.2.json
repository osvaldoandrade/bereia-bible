    {
      "questao": "Como verter רָאשֵׁי הַמַּטּוֹת?",
      "escolha": "“líderes das tribos”",
      "justificativa": "רֹאשׁ designa liderança, e מַטֶּה é tribo neste contexto. A BV não importa títulos monárquicos ou administrativos modernos.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“reis das províncias”",
          "motivo": "Muda a estrutura tribal."
        },
        {
          "opcao": "“chefes das varas”",
          "motivo": "Mantém um sentido físico de מטה inadequado aqui."
        }
      ]
    },
    {
      "questao": "Como verter זֶה הַדָּבָר אֲשֶׁר צִוָּה?",
      "escolha": "“Este é o mandamento”",
      "justificativa": "דָּבָר é a palavra/matéria ordenada, e צוה lhe dá força normativa. “Mandamento” comunica a natureza jurídica sem acrescentar conteúdo.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“Esta é uma sugestão”",
          "motivo": "Enfraquece a ordem."
        },
        {
          "opcao": "“Este é todo o estatuto”",
          "motivo": "Antecipa o plural חֻקִּים do verso 17."
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "As referências tratam do conteúdo dos votos (30:3 MT), enquanto a BV aqui introduz o discurso com \"Este é o mandamento do SENHOR\" — correspondente à segunda metade de 30:2 MT. A divergência decorre da divisão versicular distinta (BV separa 30:1 e 30:2 MT em dois versos; referências os combinam). Aspas curvas de abertura preservadas conforme o digest. \"Mandamento\" é tradução legítima de \"davar\" (palavra/coisa ordenada). Forma correta. (ER-0019 v2).",
