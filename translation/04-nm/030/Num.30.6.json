  "decisoes": [
    {
      "questao": "Como verter הֵנִיא ... אֹתָהּ?",
      "escolha": "“a impedir”",
      "justificativa": "O hifil de נוא/ניא significa impedir, frustrar ou dissuadir. O objeto é a mulher; o resultado é que seus compromissos não permanecem. A BV não o confunde lexicalmente com הפר, “invalidar”, usado depois.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“encorajá-la”",
          "motivo": "Inverte o verbo."
        },
        {
          "opcao": "“invalidar” como única glosa aqui",
          "motivo": "Expressa o efeito, mas apaga a distinção com הפר."
        },
        {
          "opcao": "“castigá-la fisicamente”",
          "motivo": "Acrescenta ação não descrita."
        }
      ]
    },
    {
      "questao": "Qual é o limite temporal?",
      "escolha": "“no dia em que ouvir”",
      "justificativa": "A reação paterna deve ocorrer no dia da audição. A BV não amplia o prazo nem o reduz ao mesmo instante.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“em qualquer momento posterior”",
          "motivo": "Contradiz בְּיוֹם שָׁמְעוֹ."
        },
        {
          "opcao": "“antes de ela falar”",
          "motivo": "Torna impossível a audição do voto."
        }
      ]
    },
    {
      "questao": "Como tratar o perdão?",
      "escolha": "“O SENHOR a perdoará”",
      "justificativa": "O perdão é consequência da invalidação paterna; o pai não é apresentado como agente do perdão.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“o pai a perdoará”",
          "motivo": "Troca o sujeito explícito."
        },
        {
          "opcao": "“ela continuará obrigada apesar disso”",
          "motivo": "Contradiz לֹא יָקוּם."
        }
      ]
    }
  ],
