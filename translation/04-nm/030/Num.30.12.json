  "decisoes": [
    {
      "questao": "Por que mencionar silêncio e não impedimento?",
      "escolha": "Preservar as duas formulações: ele se cala e não a impede",
      "justificativa": "O verso coordena החריש e לא הניא. A BV não elimina a confirmação negativa dupla, pois ela fundamenta a validade.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“o marido se opôs”",
          "motivo": "Contradiz ambas as cláusulas."
        },
        {
          "opcao": "Omitir “não a impedir”",
          "motivo": "Perde a retomada lexical de ניא."
        }
      ]
    },
    {
      "questao": "Qual é o efeito?",
      "escolha": "Todos os votos e obrigações permanecem válidos",
      "justificativa": "כָּל e a repetição de קום abrangem cada categoria e compromisso. A BV não seleciona apenas alguns.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“só os votos conhecidos pelo pai”",
          "motivo": "Importa o caso paterno."
        },
        {
          "opcao": "“tudo fica automaticamente nulo”",
          "motivo": "Inverte o resultado."
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "Estrutura condicional com três condições (ouvir, silenciar, não impedir) preserva o sentido integral. ARA usa \"se calou... não lho vedando\"; NTLH \"não disser nada\"; NVIPT \"nada lhe disser e não a proibir\". Todas convergem. A BV é ligeiramente mais elaborada na enumeração tríplice, o que confere clareza e ritmo. Forma correta. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
