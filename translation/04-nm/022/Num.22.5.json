    {
      "questao": "Como tratar פְּתוֹרָה?",
      "escolha": "“que estava em Petor”",
      "justificativa": "A terminação direcional marca Petor como destino dos mensageiros. A BV o apresenta como local do destinatário dentro da construção “enviou mensageiros a Balaão”, enquanto a literal preserva “para Petor”.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“de Petor”",
          "motivo": "Inverte a direção do envio."
        },
        {
          "opcao": "omitir Petor",
          "motivo": "Apaga a localização de Balaão."
        }
      ]
    },
    {
      "questao": "Como verter הַנָּהָר?",
      "escolha": "“o Rio”",
      "justificativa": "O substantivo vem com artigo e funciona como designação geográfica conhecida, mas o verso não nomeia explicitamente o Eufrates. A maiúscula preserva o uso titular sem inserir o nome.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“o rio Jordão”",
          "motivo": "Identifica um rio diferente sem apoio no verso."
        },
        {
          "opcao": "“o Eufrates” no texto BV",
          "motivo": "É identificação histórica provável, mas acrescentaria um nome ausente do hebraico."
        }
      ]
    },
    {
      "questao": "Como verter כִסָּה אֶת־עֵין הָאָרֶץ?",
      "escolha": "“cobre a face da terra”",
      "justificativa": "O idioma usa literalmente “olho da terra” para a superfície visível. “Face” é natural em português e a literal registra a imagem lexical.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“cobriu um olho humano”",
          "motivo": "Materializa indevidamente a expressão."
        },
        {
          "opcao": "“ocupou todo o planeta”",
          "motivo": "Universaliza além do horizonte narrativo."
        }
      ]
    },
