      "questao": "Como verter וַיִּצָּמֶד?",
      "escolha": "“se ligou”",
      "justificativa": "O nifal de צמד expressa prender-se, unir-se ou atrelar-se. “Ligou-se” mantém vínculo deliberado sem especificar um rito formal não descrito.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“visitou casualmente”",
          "motivo": "Suaviza a adesão."
        },
        {
          "opcao": "“tornou-se fisicamente parte da estátua”",
          "motivo": "Materializa indevidamente a metáfora."
        }
      ]
    },
    {
      "questao": "Como tratar בַּעַל פְּעוֹר?",
      "escolha": "“Baal-Peor”",
      "justificativa": "O nome composto da divindade/culto é preservado sem traduzir Baal como título genérico nem identificar Peor além do texto.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“o SENHOR de Peor”",
          "motivo": "Confunde a divindade com YHWH."
        },
        {
          "opcao": "“todos os deuses de Moabe”",
          "motivo": "Troca o singular nomeado pelo plural."
        }
      ]
    },
