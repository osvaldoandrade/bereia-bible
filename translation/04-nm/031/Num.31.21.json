    {
      "questao": "Como verter חֻקַּת הַתּוֹרָה?",
      "escolha": "“estatuto da instrução”",
      "justificativa": "חקה é estatuto prescrito; תורה, neste contexto ritual, segue a âncora “instrução”. A BV não usa “lei” como categoria genérica que apague o procedimento.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“conselho opcional”",
          "motivo": "Enfraquece o estatuto."
        },
        {
          "opcao": "“código civil”",
          "motivo": "Moderniza e desloca o contexto ritual."
        }
      ]
    },
    {
      "questao": "Quem fala e a quem?",
      "escolha": "Eleazar aos combatentes que voltaram",
      "justificativa": "Eleazar assume a fala ritual; Moisés permanece aquele a quem o SENHOR deu a ordem.",
      "alternativas_rejeitadas": [
        {
          "opcao": "Moisés fala novamente",
          "motivo": "Muda o sujeito explícito."
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "NTLH/ARA/NVIPT usam “lei” onde a BV usa “instrução” para torah. “Instrução” é tradução válida e moderna de torah (cf. NVI inglesa “instruction”), não é arcaica nem imprecisa. Mantida como escolha estilística legítima. (ER-0019 v2).",
