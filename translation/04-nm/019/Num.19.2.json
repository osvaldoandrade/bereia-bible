      "questao": "Como verter חֻקַּת הַתּוֹרָה?",
      "escolha": "“estatuto da instrução”",
      "justificativa": "חֻקָּה designa determinação estabelecida, e תּוֹרָה, instrução normativa; a escolha evita reduzir תּוֹרָה a legislação abstrata.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“ordenança da lei”",
          "motivo": "É tradicional, mas “lei” comunica pior o alcance instrutivo de תּוֹרָה."
        },
        {
          "opcao": "“rito da Torá”",
          "motivo": "Importa a nomeação posterior do corpus e restringe חֻקָּה a rito."
        }
      ]
    },
    {
      "questao": "Como distinguir תְּמִימָה e אֵין־בָּהּ מוּם?",
      "escolha": "“perfeita, sem defeito”",
      "justificativa": "תָּמִים descreve integridade ou completude; מוּם nega defeito identificável. A redundância aparente pertence ao texto.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“sem mancha nem defeito”",
          "motivo": "“Mancha” pode sugerir somente cor da pelagem."
        },
        {
          "opcao": "“perfeita” apenas",
          "motivo": "Apaga a segunda condição explícita."
        }
      ]
    },
    {
      "questao": "Como verter אֲשֶׁר לֹא־עָלָה עָלֶיהָ עֹל?",
      "escolha": "“sobre a qual nunca tenha sido colocado um jugo”",
      "justificativa": "O idioma diz que jugo não subiu sobre ela; a passiva natural preserva a exigência sem inferir outros trabalhos.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“que nunca trabalhou”",
          "motivo": "Amplia a proibição além do jugo."
        },
        {
          "opcao": "“que não carregou peso”",
          "motivo": "Troca jugo por carga genérica."
        }
      ]
    },
