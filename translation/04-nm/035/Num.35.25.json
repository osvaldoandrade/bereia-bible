  "decisoes": [
    {
      "questao": "Quais ações cabem à comunidade?",
      "escolha": "Livrar do vingador e devolver à cidade de refúgio",
      "justificativa": "Os dois hifis têm עֵדָה como sujeito. A BV não faz do vingador o agente do retorno nem permite permanência fora da cidade.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“entregar imediatamente ao vingador”",
          "motivo": "Inverte o veredito do caso acidental."
        },
        {
          "opcao": "“mandar para qualquer cidade”",
          "motivo": "Apaga a cidade de refúgio específica."
        }
      ]
    },
    {
      "questao": "Qual é o limite da permanência?",
      "escolha": "Até a morte do sumo sacerdote",
      "justificativa": "עַד־מוֹת estabelece o termo. A BV não substitui por prazo fixo nem antecipa a liberação.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“por trinta dias”",
          "motivo": "Inventaria duração."
        },
        {
          "opcao": "“até a morte do vingador”",
          "motivo": "Troca a pessoa decisiva."
        }
      ]
    },
    {
      "questao": "Como verter אֲשֶׁר־מָשַׁח אֹתוֹ?",
      "escolha": "“que foi ungido com o azeite sagrado”",
      "justificativa": "A forma ativa não nomeia o agente da unção; a passiva portuguesa conserva o sacerdote como recipiente e o material sagrado.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“que ungiu a si mesmo”",
          "motivo": "Atribui reflexividade ausente."
        },
        {
          "opcao": "“sem qualquer unção”",
          "motivo": "Omite a qualificação."
        }
      ]
    },
