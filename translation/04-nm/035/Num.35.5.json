        {
          "opcao": "“dois mil côvados no total”",
          "motivo": "Reduz quatro medidas a uma."
        },
        {
          "opcao": "Omitir um dos lados",
          "motivo": "Quebra o esquema quadrilateral."
        },
        {
          "opcao": "Converter em quilômetros",
          "motivo": "Moderniza a medida."
        }
      ]
    },
    {
      "questao": "Como tratar a cidade no centro?",
      "escolha": "“ficando a cidade no centro”",
