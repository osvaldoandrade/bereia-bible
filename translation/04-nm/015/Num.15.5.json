      "questao": "Por que usar o singular “você”?",
      "escolha": "Para preservar o ofertante individual indicado por תַּעֲשֶׂה",
      "justificativa": "Depois do destinatário coletivo, o hebraico muda para segunda pessoa masculina singular e regula cada oferta individual.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“vocês prepararão”",
          "motivo": "Naturaliza, mas apaga a mudança de número e o agente distributivo."
        }
      ]
    },
    {
      "questao": "Como verter נֶסֶךְ?",
      "escolha": "“libação”",
      "justificativa": "O termo designa a oferta líquida vertida; a quantidade de vinho e a unidade são mantidas.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“bebida”",
          "motivo": "Não expressa a função ritual."
        },
        {
          "opcao": "“derramamento”",
          "motivo": "Descreve a ação, mas perde a categoria cultual consolidada."
        }
      ]
