  "decisoes": [
    {
      "questao": "וַיֵּלֶךְ בְּלֹא חֶמְדָּה e sepultamento",
      "escolha": "Usar ‘partiu sem ser desejado’ e distinguir Cidade de Davi dos túmulos reais.",
      "justificativa": "הלך é eufemismo de partida; בְּלֹא חֶמְדָּה marca ausência de desejo/estima; o sepultamento 3mp não nomeia agente.",
      "alternativas_rejeitadas": [
        {
          "opcao": "morreu amado e recebeu sepultura real",
          "motivo": "Inverteria as duas negações."
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "NTLH/ARA/NVIPT convergem em explicitar 'morreu' seguido de 'sem lamento/saudade', enquanto a BV mantém o eufemismo hebraico ('foi sem desejo' na traducao_literal) como 'partiu sem ser desejado' — 'partiu' é uso corrente e natural em português contemporâneo como eufemismo para morte, e a oração seguinte ('sepultaram-no') deixa o sentido inequívoco; preserva o registro literário do eufemismo original sem prejuízo de clareza. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
