  "variantes_textuais": [],
  "decisoes": [
    {
      "questao": "Como representar os partitivos מִשֶּׁמֶן e מִן־הַדָּם?",
      "escolha": "“parte do óleo ... e do sangue”",
      "justificativa": "As preposições indicam porções das duas substâncias; “parte” torna o partitivo natural sem definir quantidade.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“o óleo ... e o sangue”",
          "motivo": "Pode sugerir o uso integral das substâncias disponíveis."
        }
      ]
    },
    {
      "questao": "Valor resultativo de וַיְקַדֵּשׁ",
      "escolha": "“Desse modo, consagrou”",
      "justificativa": "A segunda oração declara o efeito cultual da aspersão sobre pessoas e vestes; “Desse modo” explicita a relação sem acrescentar novo ato.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“e santificou”",
          "motivo": "É lexicalmente possível, mas “consagrou” distingue a instalação ritual de santidade moral e mantém o uso de Êxodo 29.21."
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "RAT-1 é falso-positivo: a condensação da repetição massiva da literal (“sobre Arão, sobre as vestes dele, e sobre os filhos dele, e sobre as vestes dos filhos dele com ele” ×2) é editorialmente correta per ER-0013/§6.2 — a BV preserva a informação completa sem redundância artificial. PRO-1 é falso-positivo: os pronomes (“seus filhos”, “vestes deles”, “suas vestes”) têm antecedente claro (Arão) e são necessários para distinguir os grupos. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
