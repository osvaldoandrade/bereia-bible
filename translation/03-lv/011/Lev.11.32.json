        {
          "opcao": "“será lavado”",
          "motivo": "Explicita uma ação não codificada pelo verbo."
        },
        {
          "opcao": "“será mergulhado”",
          "motivo": "Pode ser correto ritualmente, mas é mais específico que “ser levado à água”."
        }
      ]
    },
