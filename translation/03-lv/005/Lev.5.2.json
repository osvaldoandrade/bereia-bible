    {
      "questao": "Valor de וְנֶעְלַם מִמֶּנּוּ e וְאָשֵׁם",
      "escolha": "“isso lhe passar despercebido” e “será culpado”",
      "justificativa": "O primeiro descreve falta de percepção, não ocultação intencional; o segundo marca responsabilidade cultual resultante, mesmo antes da plena consciência.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“isso lhe foi escondido”",
          "motivo": "O calque, preservado na literal, pode sugerir um agente que ocultou o fato."
        },
        {
          "opcao": "“oferecerá uma oferta pela culpa”",
          "motivo": "אָשֵׁם é verbo de tornar-se culpado, não o substantivo sacrificial אָשָׁם."
        }
      ]
    },
