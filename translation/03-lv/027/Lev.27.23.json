  "decisoes": [
    {
      "questao": "Como verter מִכְסַת הָעֶרְכְּךָ?",
      "escolha": "“a parte da avaliação correspondente ao período”",
      "justificativa": "מִכְסָה é a quota ou montante proporcional. O jubileu limita o período útil do campo comprado, por isso o sacerdote calcula apenas a parcela correspondente.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“a avaliação integral”",
          "motivo": "Ignora a proporcionalidade e o limite jubilar."
        },
        {
          "opcao": "“uma taxa administrativa”",
          "motivo": "Moderniza o valor sem apoio lexical."
        }
      ]
    },
    {
      "questao": "Como verter קֹדֶשׁ לַיהוָה aplicado ao pagamento?",
      "escolha": "“como coisa sagrada ao SENHOR”",
      "justificativa": "O valor pago é destinado ao domínio sagrado do SENHOR; o texto não diz que o campo comprado se torna propriedade sacerdotal permanente.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“como imposto estatal”",
          "motivo": "Moderniza a instituição."
        },
        {
          "opcao": "“como dedicação irrevogável”",
          "motivo": "Não aparece חרם e o campo retornará no jubileu."
        }
      ]
    }
  ],
