      "questao": "Como distinguir נֶדֶר de נְדָבָה?",
      "escolha": "“para cumprir algum voto” e “como oferta voluntária”",
      "justificativa": "נֶדֶר decorre de obrigação assumida por voto; נְדָבָה é apresentação espontânea. A BV mantém a diferença e não trata ambas como voluntárias no mesmo sentido.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“duas ofertas voluntárias”",
          "motivo": "Apaga a obrigação criada pelo voto."
        },
        {
          "opcao": "“promessa e doação secular”",
          "motivo": "Desloca as categorias para fora do culto sacrificial."
        }
      ]
    },
    {
      "questao": "Como verter הַגֵּר בְּיִשְׂרָאֵל?",
      "escolha": "“estrangeiro que vive em Israel”",
      "justificativa": "גֵּר designa quem reside no meio da comunidade sem pertencer à casa de Israel por nascimento, mas participa desta norma de oferta.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“turista em Israel”",
          "motivo": "Não expressa residência comunitária."
        },
        {
          "opcao": "“qualquer estrangeiro no mundo”",
          "motivo": "Excede o âmbito “em Israel”."
        }
      ]
    },
