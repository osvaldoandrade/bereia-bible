      "questao": "Como verter שַׁבְּתֹת שָׁנִים?",
      "escolha": "“ciclos sabáticos de anos”",
      "justificativa": "A expressão conta conjuntos de sete anos, não sábados semanais. “Ciclos sabáticos” mantém a raiz institucional e esclarece a unidade cronológica.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“semanas de anos”",
          "motivo": "Comunica sete unidades, mas substitui o substantivo sábado por semana."
        },
        {
          "opcao": "“sete sábados anuais”",
          "motivo": "Pode ser entendido como sete dias dentro de cada ano."
        }
      ]
    },
