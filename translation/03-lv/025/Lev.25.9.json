    {
      "questao": "Como verter שׁוֹפַר תְּרוּעָה e o verbo העביר?",
      "escolha": "“fazer soar a trombeta de aclamação”",
      "justificativa": "שׁוֹפָר designa a trombeta de chifre, e תְּרוּעָה um toque forte de aclamação ou alarme. “Fazer soar” comunica a circulação do toque por toda a terra sem dizer que o instrumento físico é transportado.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“passar o chifre de grito”",
          "motivo": "É calque lexical ininteligível no texto publicado."
        },
        {
          "opcao": "“tocar a trombeta da liberdade”",
          "motivo": "Anteciparia דְּרוֹר do verso seguinte e fundiria duas frases distintas."
        }
      ]
    },
