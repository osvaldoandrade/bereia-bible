  "decisoes": [
    {
      "questao": "παράπτωμα: fixação da glosa 'transgressão' como termo-guia do capítulo",
      "escolha": "transgressão",
      "justificativa": "παράπτωμα ('passo em falso, queda') é distinto de ἁμαρτία ('pecado', termo mais genérico usado em vv.12-13,20-21); 'transgressão' preserva essa distinção lexical ao longo do capítulo (vv.15,16,17,18,20), conforme EDITORIAL §11.",
      "alternativas_rejeitadas": [
        {
          "opcao": "ofensa",
          "motivo": "tradição de Almeida, mas em português contemporâneo desloca o sentido para o campo social/interpessoal, menos técnico"
        },
        {
          "opcao": "pecado (mesma glosa de ἁμαρτία)",
          "motivo": "colapsaria dois termos gregos distintos que Paulo usa lado a lado no mesmo capítulo"
        }
      ]
    },
    {
      "questao": "distinção lexical entre χάρισμα ('dom gratuito') e δωρεά ('dádiva'), ambos no mesmo verso",
      "escolha": "χάρισμα = 'dom gratuito'; δωρεά = 'dádiva'",
      "justificativa": "Paulo emprega dois substantivos de dom no mesmo verso; a BV distingue as glosas para preservar a variação lexical proposital, ainda que ambos apontem para o mesmo referente teológico.",
      "alternativas_rejeitadas": [
        {
          "opcao": "traduzir os dois por 'dom'",
          "motivo": "apagaria a variação lexical do original"
        }
      ]
    },
    {
      "questao": "verbo elíptico na primeira oração ('não é assim como...')",
      "escolha": "suprir 'é' duas vezes",
      "justificativa": "Oração nominal grega sem cópula; o português exige o verbo suprido (EDITORIAL §4).",
      "alternativas_rejeitadas": []
    }
  ],
  "palavras_supridas": [
    "é (1ª ocorrência, 'não é assim')",
    "é (2ª ocorrência, 'assim também é')"
  ],
  "ambiguidades_preservadas": [],
  "justificativa": "Inicia a comparação formal (não-simetria) entre Adão e Cristo: o dom excede em muito a transgressão.",
