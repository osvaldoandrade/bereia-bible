    {
      "questao": "Glosa de ὑπόδικος (termo jurídico raro no NT)",
      "escolha": "'réu' (diante de Deus)",
      "justificativa": "termo forense, coerente com o campo semântico jurídico do capítulo (δικαιόω, δικαιοσύνη, κρίνω); 'réu' preserva o registro de tribunal",
      "alternativas_rejeitadas": [
        {
          "opcao": "'responsável/sujeito ao juízo'",
          "motivo": "mais vago; perde a nitidez forense do termo grego"
        }
      ]
    },
    {
      "questao": "Revisão editorial do texto_bv",
      "escolha": "tudo o que a lei diz, fala aos que estão sob a lei → tudo o que a lei diz, ela o fala aos que estão sob a lei",
      "justificativa": "Adição de pronome objeto \"o\" (retomando \"tudo\") e sujeito \"ela\" (retomando \"a lei\") para resolver sintaxe ambígua — sem \"o\", o verbo \"fala\" fica sem objeto direto referenciado. ARA e NVIPT usam idêntica construção com pronome objeto (§6.1). — revisão de forma sem alteração de sentido (ER-0019). ARA: \"aos que estão debaixo da lei o diz\"; NVIPT: \"o diz àqueles que estão debaixo dela\". A BV omitia o pronome objeto \"o\", criando frase agramatical em português normativo. Correção puramente sintática, sem alteração de sentido.",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    },
