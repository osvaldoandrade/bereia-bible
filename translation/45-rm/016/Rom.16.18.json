  "decisoes": [
    {
      "questao": "χρηστολογίας καὶ εὐλογίας — 'boa fala' e 'discurso lisonjeiro/elogio bajulador' (não 'bênção' religiosa); como render o par sem introduzir o sentido litúrgico comum de εὐλογία?",
      "escolha": "palavras suaves e lisonjeiras",
      "justificativa": "No contexto de engano retórico (não de bênção litúrgica), εὐλογία assume o sentido secular grego de 'discurso favorável/elogioso, bajulação'; traduzir literalmente 'bênção' introduziria um falso sentido religioso ausente aqui.",
      "alternativas_rejeitadas": [
        {
          "opcao": "bom falar e bendizer",
          "motivo": "mais literal palavra-por-palavra, mas soa estranho e sugere erroneamente o sentido religioso de 'bendizer' em português."
        }
      ]
    },
    {
      "questao": "ἀκάκων (literalmente 'sem malícia/mal') — 'ingênuos' ou 'simples'?",
      "escolha": "ingênuos",
      "justificativa": "ἄκακος descreve quem não tem malícia, alvo fácil de engano; 'ingênuo' capta essa vulnerabilidade em português contemporâneo.",
      "alternativas_rejeitadas": [
        {
          "opcao": "simples",
          "motivo": "mais próximo da tradição Almeida, mas em português atual 'simples' tende a sugerir baixa inteligência, deslocando o sentido moral de 'sem malícia'."
        }
      ]
    }
  ],
