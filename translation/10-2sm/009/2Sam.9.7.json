    {
      "questao": "Como preservar a ênfase עָשֹׂה אֶעֱשֶׂה?",
      "escolha": "“certamente lhe demonstrarei lealdade”.",
      "justificativa": "O infinitivo absoluto seguido do verbo finito intensifica a promessa, reproduzida por “certamente”.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“talvez eu lhe demonstre lealdade”",
          "motivo": "Enfraquece a construção enfática."
        }
      ]
    },
    {
      "questao": "Como traduzir אָבִיךָ aplicado a Saul?",
      "escolha": "“seu avô” no texto BV, com “teu pai” no literal.",
      "justificativa": "A genealogia do v. 6 estabelece Saul como avô de Mefibosete; אָב pode designar ancestral. A BV explicita a relação sem alterar o referente.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“Saul, seu pai biológico”",
          "motivo": "Contradiz a filiação a Jônatas."
        }
      ]
    },
    {
      "questao": "O que Davi promete restaurar e conceder?",
      "escolha": "Todas as terras de Saul e presença permanente à mesa real.",
      "justificativa": "כָּל־שְׂדֵה funciona coletivamente para a propriedade territorial; תָּמִיד conserva a continuidade.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“apenas uma pequena parcela e uma única refeição”",
          "motivo": "Reduz כָּל e elimina תָּמִיד."
        }
      ]
    }
  ],
