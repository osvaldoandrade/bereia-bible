      "questao": "Como Davi reage ao censo?",
      "escolha": "seu coração o fere, ele confessa pecado e pede remoção da culpa",
      "justificativa": "וַיַּךְ לֵב־דָּוִד אֹתוֹ mantém a reação interior incisiva; חָטָאתִי, הַעֲבֶר־נָא e עֲוֹן preservam confissão, pedido e culpa.",
      "alternativas_rejeitadas": [
        {
          "opcao": "Davi se orgulhou do censo",
          "motivo": "Inverte sua reação."
        },
        {
          "opcao": "culpou Joabe sem se confessar",
          "motivo": "Apaga primeira pessoa."
        }
      ]
    },
    {
      "questao": "Como qualifica sua ação?",
      "escolha": "“agi com extrema insensatez”",
      "justificativa": "נִסְכַּלְתִּי מְאֹד é uma autoavaliação intensificada, não simples erro administrativo.",
      "alternativas_rejeitadas": [
        {
          "opcao": "agiu com grande sabedoria",
          "motivo": "Dá sentido oposto."
        }
      ]
    },
