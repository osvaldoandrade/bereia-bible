          "opcao": "se for bom para o rei",
          "motivo": "aceitável, mas 'do agrado' é mais idêntico ao registro protocolar formal da corte"
        }
      ]
    },
    {
      "questao": "Idiomatismo jurídico וְלֹא יַעֲבוֹר ('e não passe')",
      "escolha": "'para que não seja revogado'",
      "justificativa": "termo técnico para irrevogabilidade dos decretos medo-persas (tema central do livro, cf. Est 8:8).",
      "alternativas_rejeitadas": [
        {
          "opcao": "e não passe",
          "motivo": "calque opaco; não comunica o sentido jurídico técnico de irrevogabilidade"
        }
      ]
