      "questao": "אַחַת דָּתוֹ לְהָמִית (oração nominal \"uma [é] a sua lei: matar\")",
      "escolha": "\"há uma só lei ... a morte\", condensando a oração nominal do hebraico em estrutura equivalente e natural em português.",
      "justificativa": "ER-0013 — normalização de construção nominal densa do hebraico para fluência, sem perda de conteúdo (preservada na literal).",
      "alternativas_rejeitadas": [
        {
          "opcao": "\"uma é a sua lei, para morrer\" (calque direto)",
          "motivo": "soa artificial e ambíguo em português corrido."
        }
      ]
    },
    {
      "questao": "זֶה שְׁלוֹשִׁים יוֹם (\"este trinta dias\") — expressão temporal idiomática",
      "escolha": "\"há trinta dias\".",
      "justificativa": "Construção idiomática hebraica para duração decorrida (\"estes já trinta dias\"), equivalente a \"há trinta dias\" em português.",
      "alternativas_rejeitadas": [
        {
          "opcao": "\"este trinta dias\" (calque)",
          "motivo": "agramatical em português."
        }
      ]
    },
