  "decisoes": [
    {
      "questao": "Como preservar a enumeração regional?",
      "escolha": "“região montanhosa ... Neguebe ... Gósen ... Sefelá ... Arabá ... região montanhosa de Israel e sua Sefelá”",
      "justificativa": "Cada unidade introduzida pelo marcador de objeto ou coordenação permanece na lista; os dois כָּל ligados a Neguebe e Gósen não são reduzidos.",
      "alternativas_rejeitadas": [
        {
          "opcao": "somente Hazor e Merom",
          "motivo": "Substitui a síntese territorial por locais da batalha."
        },
        {
          "opcao": "fundir Sefelá e Arabá",
          "motivo": "Apaga regiões distintas."
        }
      ]
    },
    {
      "questao": "Como verter וּשְׁפֵלָתֹהּ?",
      "escolha": "“e sua Sefelá”",
      "justificativa": "O sufixo feminino retoma a região montanhosa/terra de Israel como área associada. A repetição de Sefelá é mantida em vez de apagada como redundância.",
      "alternativas_rejeitadas": [
        {
          "opcao": "e o mar de Israel",
          "motivo": "Troca o substantivo."
        },
        {
          "opcao": "omitir a segunda Sefelá",
          "motivo": "Remove repetição e sufixo presentes."
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "RED-1 (repetição de “região montanhosa”) é falso positivo: o hebraico emprega har duas vezes para designar duas regiões geográficas distintas (a região montanhosa geral e a região montanhosa de Israel especificamente). ARA também repete “região montanhosa” duas vezes. Repetição fiel ao original. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
