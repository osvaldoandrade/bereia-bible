      "questao": "Quem determina o resultado da batalha?",
      "escolha": "“entregarei todos eles mortos diante de Israel”",
      "justificativa": "אָנֹכִי נֹתֵן mantém o SENHOR como agente explícito; כֻּלָּם não permite reduzir o alcance, e חֲלָלִים descreve os inimigos como mortos.",
      "alternativas_rejeitadas": [
        {
          "opcao": "Josué vencerá sem ação do SENHOR",
          "motivo": "Apaga o sujeito divino enfático."
        },
        {
          "opcao": "somente alguns serão feridos levemente",
          "motivo": "Reduz כֻּלָּם e suaviza חֲלָלִים."
        }
      ]
    },
    {
      "questao": "Que ordem Josué recebe a respeito dos cavalos?",
      "escolha": "“Corte os tendões dos cavalos”",
      "justificativa": "O piel de עקר, aplicado a cavalos, indica jarretar ou cortar tendões para incapacitá-los. A BV explicita a ação corporal sem substituí-la por morte.",
      "alternativas_rejeitadas": [
        {
          "opcao": "alimente os cavalos",
          "motivo": "Inverte a ação destrutiva."
        },
        {
          "opcao": "mate todos os cavalos",
          "motivo": "Pode ser consequência, mas não é o procedimento lexicalmente ordenado."
        }
      ]
    },
    {
      "questao": "Que destino recebem os carros?",
      "escolha": "“queime seus carros”",
      "justificativa": "תִּשְׂרֹף בָּאֵשׁ exige combustão pelo fogo e mantém Josué como destinatário singular da ordem.",
      "alternativas_rejeitadas": [
        {
          "opcao": "use os carros na perseguição",
          "motivo": "Contradiz a ordem de queimá-los."
        },
        {
          "opcao": "abandone-os intactos",
          "motivo": "Apaga o verbo."
        }
      ]
    },
