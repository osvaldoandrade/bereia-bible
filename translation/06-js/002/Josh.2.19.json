        {
          "opcao": "“se ninguém lhe causar dano”",
          "motivo": "Inverte a condição."
        },
        {
          "opcao": "“se ela tocar numa parede”",
          "motivo": "Ignora o valor hostil da mão sobre alguém."
        }
      ]
    },
