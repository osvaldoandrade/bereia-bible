  "decisoes": [
    {
      "questao": "Como verter הַגָּג?",
      "escolha": "“terraço”",
      "justificativa": "O teto plano da casa funciona como espaço utilizável. “Terraço” torna natural o local elevado sem mudar sua posição sobre a casa.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“porão subterrâneo”",
          "motivo": "Inverte o local."
        },
        {
          "opcao": "“fora da cidade”",
          "motivo": "Contradiz o esconderijo doméstico."
        }
      ]
    },
    {
      "questao": "Como verter פִשְׁתֵּי הָעֵץ?",
      "escolha": "“talos de linho que estavam dispostos”",
      "justificativa": "A expressão designa hastes lenhosas de linho, e o particípio passivo descreve sua disposição no terraço sem identificar quem as arrumou.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“tecido pronto de algodão”",
          "motivo": "Troca material e estágio."
        },
        {
          "opcao": "“árvores de linho gigantes”",
          "motivo": "Lê o calque sem sentido agrícola."
        }
      ]
    },
    {
      "questao": "Revisão editorial do texto_bv",
      "escolha": "escondera → havia escondido",
      "justificativa": "Mais-que-perfeito sintético (arcaísmo funcionalmente morto, EDITORIAL §1.2 tabela). Substituído por pretérito composto \"havia escondido\", mantendo paralelismo com \"havia levado\" no mesmo verso. NTLH/ARA/NVIPT usam \"tinha escondido\" ou \"tinha feito subir\" — todas formas compostas. — revisão de forma sem alteração de sentido (ER-0019).",
