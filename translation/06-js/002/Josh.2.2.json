      "questao": "Como preservar וַיֵּאָמַר passivo?",
      "escolha": "“informaram ao rei” sem nomear o agente",
      "justificativa": "O nifal apresenta a informação recebida pelo rei, mas não identifica quem a transmitiu. O plural indeterminado é natural em português.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“Raabe informou pessoalmente”",
          "motivo": "Acrescenta agente não expresso."
        },
        {
          "opcao": "“o rei descobriu sem receber notícia”",
          "motivo": "Apaga o ato de informar."
        }
      ]
    },
    {
      "questao": "Como verter לַחְפֹּר אֶת־הָאָרֶץ?",
      "escolha": "“investigar a terra”",
      "justificativa": "חפר pode ser cavar ou buscar; no contexto dos espiões, descreve sondar ou investigar o território.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“cavar toda a terra com ferramentas”",
          "motivo": "Aplica sentido físico inadequado à missão."
        },
