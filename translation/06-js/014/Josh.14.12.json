  "decisoes": [
    {
      "questao": "הָהָר designa um pico isolado ou uma área?",
      "escolha": "“esta região montanhosa”",
      "justificativa": "A presença dos anaquins e de cidades no espaço favorece o valor territorial de região montanhosa, sem identificar um local moderno.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“este único pico”",
          "motivo": "Restringiria indevidamente a área que contém cidades."
        },
        {
          "opcao": "substituir pela designação de uma região moderna",
          "motivo": "Acrescentaria identificação extratextual."
        }
      ]
    },
    {
      "questao": "Como tratar a elipse em אוּלַי יְהוָה אוֹתִי?",
      "escolha": "“Talvez o SENHOR esteja comigo”",
      "justificativa": "“Esteja” supre a cópula elíptica e mantém אוּלַי como possibilidade expressa por Calebe, sem convertê-la em certeza ou incredulidade.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“certamente o SENHOR está comigo”",
          "motivo": "Eliminaria o “talvez”."
        },
        {
          "opcao": "“o SENHOR não estará comigo”",
          "motivo": "Transformaria possibilidade em negação."
        }
      ]
    },
    {
      "questao": "Que ação expressa וְהוֹרַשְׁתִּים?",
      "escolha": "“eu os expulsarei”",
      "justificativa": "A forma causativa de ירש apresenta os anaquins como desapossados; “expulsarei” mantém Calebe como agente e o sufixo plural como objeto.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“eles me expulsarão”",
          "motivo": "Inverteria agente e objeto."
        },
        {
          "opcao": "“eu apenas visitarei as cidades”",
          "motivo": "Apagaria o desapossamento pretendido."
        }
      ]
    }
  ],
  "palavras_supridas": [
    "“havia”, como cópula da frase nominal sobre anaquins e cidades",
    "“esteja”, como cópula elíptica em “talvez o SENHOR [esteja] comigo”"
  ],
  "ambiguidades_preservadas": [
    "הָהָר pode ser vertido literalmente “a montanha” ou territorialmente “a região montanhosa”; a BV adota o valor regional exigido pelas cidades, e a literal conserva “montanha”.",
    "A hesitação de “talvez” é mantida sem definir se expressa modéstia, incerteza estratégica ou outra nuance."
  ],
  "justificativa": "O pedido preserva região, repetição de “naquele dia”, anaquins, cidades grandes e fortificadas, possibilidade da presença do SENHOR e expulsão futura.",
