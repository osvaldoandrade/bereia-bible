  "decisoes": [
    {
      "questao": "Como preservar a cronologia apresentada por Calebe?",
      "escolha": "“quarenta e cinco anos... hoje já tenho oitenta e cinco anos”",
      "justificativa": "Os dois números são mantidos sem recalcular, arredondar ou substituir a cronologia declarada.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“cerca de quarenta anos”",
          "motivo": "Apagaria o número quarenta e cinco."
        },
        {
          "opcao": "“oitenta anos”",
          "motivo": "Alteraria a idade explicitamente declarada."
        }
      ]
    },
    {
      "questao": "Como verter הֶחֱיָה אוֹתִי?",
      "escolha": "“me conservou vivo”",
      "justificativa": "A formulação mantém o SENHOR como agente da preservação da vida de Calebe ao longo do período.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“eu sobrevivi sozinho”",
          "motivo": "Retiraria do SENHOR a ação expressa."
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "Achado RED-1 (“cinco anos”) é falso-positivo: trata-se do numeral composto “oitenta e cinco anos”, presente na tradução literal e nas três referências (NTLH/ARA/NVIPT). A repetição de “SENHOR” reflete duas ocorrências distintas de YHWH no hebraico, preservadas também pela ARA. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
      "diretriz_ref": "ER-0019"
    }
  ],
  "palavras_supridas": [
    "“tenho”, como cópula natural para a idade",
    "“já”, para a ênfase temporal de “agora/eis” em português"
  ],
  "ambiguidades_preservadas": [
    "O verbo “caminhava” descreve o percurso de Israel no deserto sem importar para este verso uma qualificação adicional como peregrinação ou punição."
