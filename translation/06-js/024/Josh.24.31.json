      "questao": "Por quanto tempo Israel serviu?",
      "escolha": "“durante toda a vida de Josué ... toda a vida dos anciãos”",
      "justificativa": "כֹּל é repetido nos dois períodos. A BV conserva ambas as totalidades e a extensão posterior à morte de Josué.",
      "alternativas_rejeitadas": [
        {
          "opcao": "somente durante um dia",
          "motivo": "Reduz os dois períodos."
        },
        {
          "opcao": "apenas depois dos anciãos",
          "motivo": "Inverte a cronologia."
        }
      ]
    },
    {
      "questao": "O que caracterizava os anciãos?",
      "escolha": "“continuaram vivendo ... e conheciam toda a obra”",
      "justificativa": "As duas orações relativas são mantidas: sobrevivência após Josué e conhecimento abrangente dos atos do SENHOR por Israel.",
      "alternativas_rejeitadas": [
        {
          "opcao": "anciãos que desconheciam os atos",
          "motivo": "Inverte o segundo relativo."
        },
        {
          "opcao": "anciãos mortos antes de Josué",
          "motivo": "Contradiz “depois de Josué”."
        }
      ]
    },
