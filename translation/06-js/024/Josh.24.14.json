        {
          "opcao": "com medo fingido",
          "motivo": "Contradiz ambas as qualidades."
        },
        {
          "opcao": "apenas com emoção",
          "motivo": "Reduz duas disposições éticas."
        }
      ]
    },
    {
      "questao": "Como preservar a repetição de “servir”?",
      "escolha": "“sirvam-no ... serviram ... sirvam”",
      "justificativa": "O verbo עבד aparece três vezes com objetos diferentes. A BV mantém a repetição para sustentar o contraste de lealdades.",
      "alternativas_rejeitadas": [
