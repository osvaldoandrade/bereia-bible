      "questao": "Como preservar a personificação da pedra?",
      "escolha": "“ela ouviu”",
      "justificativa": "O pronome feminino e o verbo ouvir atribuem audição à pedra como figura jurídica. A BV não explica a imagem como mero registro humano.",
      "alternativas_rejeitadas": [
        {
          "opcao": "a pedra não ouviu nada e o verso é corrigido",
          "motivo": "Harmoniza a personificação."
        },
        {
          "opcao": "Josué ouviu no lugar da pedra",
          "motivo": "Troca o sujeito."
        }
      ]
    },
    {
      "questao": "Como mudam as relações de testemunho?",
      "escolha": "“entre nós” e “contra vocês”",
      "justificativa": "בָּנוּ e בָכֶם usam preposições e pessoas diferentes. A BV conserva a passagem da inclusão de Josué para a responsabilização do povo.",
      "alternativas_rejeitadas": [
        {
          "opcao": "somente contra Josué",
          "motivo": "Inverte o segundo alvo."
        },
        {
          "opcao": "sem testemunho contra ninguém",
          "motivo": "Apaga a função jurídica."
        }
      ]
    },
    {
