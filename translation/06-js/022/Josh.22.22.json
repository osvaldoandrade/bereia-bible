    {
      "questao": "Como verter a fórmula אֵל אֱלֹהִים יְהוָה repetida?",
      "escolha": "“O Poderoso, Deus, o SENHOR”",
      "justificativa": "אֵל é mantido como título “O Poderoso”, אֱלֹהִים como “Deus” e יהוה como “SENHOR”; a repetição integral conserva a invocação solene e distingue os três elementos.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“Deus” uma única vez",
          "motivo": "Apaga a tripla fórmula e sua repetição."
        },
        {
          "opcao": "“o SENHOR dos Exércitos”",
          "motivo": "Introduz צְבָאוֹת, que não ocorre."
        },
        {
          "opcao": "“Javé”",
          "motivo": "Contraria a política de verter יהוה por SENHOR."
        }
      ]
    },
    {
      "questao": "A quem se dirige אַל־תּוֹשִׁיעֵנוּ?",
      "escolha": "“não nos salves hoje”",
      "justificativa": "O jussivo de segunda pessoa singular dirige-se ao Deus invocado, não aos delegados; a mudança da terceira pessoa “ele sabe” para apelo direto é preservada.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“não os salvem hoje”",
          "motivo": "Muda pessoa, número e objeto."
        },
        {
          "opcao": "“Israel não nos salvará”",
          "motivo": "Transforma Israel em agente e apaga a invocação divina."
        }
      ]
    },
