  "decisoes": [
    {
      "questao": "Qual alternativa a delegação oferece antes de ameaçar guerra?",
      "escolha": "“atravessem... e recebam propriedade entre nós”",
      "justificativa": "Os imperativos oferecem mudança territorial e participação na propriedade ocidental caso a terra oriental seja considerada impura.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“abandonem toda herança”",
          "motivo": "Omite a oferta de propriedade entre Israel."
        },
        {
          "opcao": "“construam outro tabernáculo”",
          "motivo": "O único tabernáculo mencionado já está estabelecido na terra do SENHOR."
        }
      ]
    },
    {
      "questao": "Como verter מִבַּלְעֲדֵי מִזְבַּח?",
      "escolha": "“outro altar além do altar”",
      "justificativa": "A preposição exclui qualquer altar rival ao altar do SENHOR; “outro” torna a relação clara sem afirmar uso já realizado.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“um altar ao lado do altar”",
          "motivo": "Sugere proximidade física, não exclusão cultual."
        },
        {
          "opcao": "“uma cópia memorial”",
          "motivo": "Antecipa a defesa que ainda não foi ouvida."
        }
      ]
    }
  ],
