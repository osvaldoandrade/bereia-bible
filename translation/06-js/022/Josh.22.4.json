        {
          "opcao": "“Virai-vos e ide para vós”",
          "motivo": "Preserva o calque, mas é artificial no publicado."
        },
        {
          "opcao": "“Permaneçam aqui”",
          "motivo": "Inverte a dispensa expressa pelos imperativos."
        }
      ]
    },
    {
