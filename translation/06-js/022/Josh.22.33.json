      "questao": "Como verter וַיִּיטַב הַדָּבָר בְּעֵינֵי?",
      "escolha": "“acolheram favoravelmente o relatório”",
      "justificativa": "O idioma afirma avaliação positiva da mensagem recebida. “Relatório” retoma דָּבָר do verso 32 e preserva a cadeia narrativa.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“rejeitaram o relatório”",
          "motivo": "Inverte a avaliação."
        },
        {
          "opcao": "“aprovaram sacrifícios no altar”",
          "motivo": "Vai além do conteúdo aceito."
        }
      ]
    },
    {
      "questao": "Como representar וְלֹא אָמְרוּ לַעֲלוֹת ... לַצָּבָא?",
      "escolha": "“A proposta de marchar... foi abandonada: não haveria guerra”",
      "justificativa": "A negação de “dizer” cancela a intenção anteriormente formulada em 22:12. A passiva de estado comunica desistência, não derrota militar.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“Israel iniciou a guerra”",
          "motivo": "Elimina a negação."
        },
        {
          "opcao": "“Israel venceu e destruiu Gileade”",
          "motivo": "Afirma exatamente o resultado evitado."
        }
      ]
    },
    {
      "questao": "Quem é nomeado como habitante da terra?",
      "escolha": "“Rúben e Gade”",
      "justificativa": "O verso menciona somente os filhos dessas duas tribos. Manassés não é acrescentado por harmonização.",
