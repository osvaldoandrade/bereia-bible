      "questao": "Quais grupos transjordanianos atravessam?",
      "escolha": "“os rubenitas, os gaditas e a metade da tribo de Manassés”",
      "justificativa": "Os gentílicos naturais vertem “filhos de Rúben” e “filhos de Gade”, e o terceiro grupo permanece explicitamente metade da tribo. A ordem do texto é mantida sem ampliar para toda Manassés.",
      "alternativas_rejeitadas": [
        {
          "opcao": "toda a tribo de Manassés",
          "motivo": "Apaga חֲצִי."
        },
        {
          "opcao": "Judá e Benjamim",
          "motivo": "Substitui os nomes."
        }
      ]
    },
    {
      "questao": "Como verter חֲמֻשִׁים?",
      "escolha": "“armados”",
      "justificativa": "O particípio descreve equipados ou organizados para combate. A BV não o interpreta como numeral cinco nem como população civil desarmada.",
      "alternativas_rejeitadas": [
        {
          "opcao": "em cinco famílias",
          "motivo": "Segue associação numérica inadequada ao contexto militar."
        },
        {
          "opcao": "sem armas",
          "motivo": "Inverte a preparação."
        }
      ]
    },
    {
      "questao": "Qual posição ocupam?",
      "escolha": "antepor “À frente dos israelitas”",
      "justificativa": "לִפְנֵי indica a posição dos grupos diante do restante de Israel. A anteposição preserva a ordem hebraica do complemento em relação ao verbo e destaca sua posição na marcha.",
