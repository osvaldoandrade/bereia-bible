  "decisoes": [
    {
      "questao": "Como marcar a segunda etapa da conquista?",
      "escolha": "Josué e Israel “a oeste do Jordão”",
      "justificativa": "יָמָּה, literalmente “para o mar”, indica o lado ocidental e contrasta com a seção oriental de Moisés.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“Moisés conquistou a oeste do Jordão”",
          "motivo": "Funde os agentes das duas seções."
        }
      ]
    },
    {
      "questao": "Como tratar הָהָר הֶחָלָק?",
      "escolha": "“monte Halaque”",
      "justificativa": "O OSHB analisa Halaque como nome próprio; a literal conserva a estrutura com artigo. O sentido lexical possível de “liso/desnudado” fica registrado como ambiguidade.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“monte Hermom”",
          "motivo": "Troca o limite meridional pelo limite setentrional da seção anterior."
        }
      ]
    },
    {
      "questao": "Como entender כְּמַחְלְקֹתָם?",
      "escolha": "“segundo as partes destinadas a cada uma”",
      "justificativa": "A terra é distribuída às tribos conforme suas divisões ou parcelas, sem afirmar neste verso o mecanismo de sorteio.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“sem qualquer divisão tribal”",
          "motivo": "Contradiz a distribuição expressa."
        }
      ]
    },
