      "questao": "Como representar o singular coletivo הָאוֹרֵב seguido de verbos plurais?",
      "escolha": "“Os homens da emboscada”",
      "justificativa": "O particípio substantivado singular nomeia o contingente como unidade, enquanto וַיָּרֻצוּ e os verbos seguintes são plurais. A BV explicita os integrantes sem criar novo grupo.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“um único emboscador”",
          "motivo": "Não explica nem preserva os verbos plurais."
        },
        {
          "opcao": "“todo Israel”",
          "motivo": "Amplia o contingente além do grupo posicionado."
        }
      ]
    },
    {
      "questao": "Quando o grupo corre?",
      "escolha": "“assim que Josué estendeu a mão”",
      "justificativa": "כִּנְטוֹת liga a corrida ao gesto. O sujeito do infinitivo é recuperado como Josué pelo verso anterior, sem inserir intervalo.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“antes de Josué mover a mão”",
          "motivo": "Inverte a relação temporal."
        },
        {
          "opcao": "“muito depois do gesto”",
          "motivo": "Rompe a sincronização sintática."
        }
      ]
    }
  ],
