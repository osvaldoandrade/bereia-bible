    {
      "questao": "Como organizar os grupos ao redor da arca?",
      "escolha": "Israel e suas lideranças em ambos os lados; sacerdotes levitas portadores diante deles; metade diante de cada monte",
      "justificativa": "A BV preserva os grupos nomeados e a distribuição dupla. A arca permanece eixo central, e Gerizim e Ebal não são trocados.",
      "alternativas_rejeitadas": [
        {
          "opcao": "colocar todo o povo somente em Gerizim",
          "motivo": "Apaga a divisão em metades."
        },
        {
          "opcao": "fazer os sacerdotes levitas carregarem os montes",
          "motivo": "Confunde o objeto do particípio נֹשְׂאֵי, que é a arca."
        }
      ]
    },
    {
      "questao": "Como verter כַּגֵּר כָּאֶזְרָח?",
      "escolha": "“Tanto o estrangeiro residente como o nativo”",
      "justificativa": "As duas categorias são incluídas sob a mesma disposição cultual. “Estrangeiro residente” segue a âncora de Deuteronômio e não o reduz a visitante passageiro.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“somente israelitas nativos”",
          "motivo": "Exclui explicitamente o גֵּר."
        },
        {
          "opcao": "“turista e cidadão moderno”",
          "motivo": "Moderniza categorias sociais antigas."
        }
      ]
    },
    {
      "questao": "Como entender בָּרִאשֹׁנָה?",
      "escolha": "“havia ordenado anteriormente, para abençoar”",
      "justificativa": "O advérbio modifica a ordem dada por Moisés e a situa anteriormente. Ele não estabelece uma sequência entre a bênção e a maldição.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“amaldiçoar primeiro”",
          "motivo": "Inverte o verbo לְבָרֵךְ."
        },
        {
          "opcao": "“abençoar primeiro”",
          "motivo": "Liga o advérbio ao infinitivo e introduz uma sequência não afirmada no hebraico."
        },
        {
          "opcao": "omitir toda referência à ordem",
          "motivo": "Apaga o advérbio e a sequência prescrita."
        }
      ]
    }
