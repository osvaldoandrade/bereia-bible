        {
          "opcao": "matou os três",
          "motivo": "O verso não usa verbo de matar."
        },
        {
          "opcao": "convidou-os a permanecer",
          "motivo": "Inverte a expulsão."
        }
      ]
    },
    {
      "questao": "Como preservar a enumeração?",
      "escolha": "“Sesai, Aimã e Talmai”",
      "justificativa": "Os três nomes seguem o quantificador “três” e são qualificados como nascidos ou descendentes de Anaque.",
