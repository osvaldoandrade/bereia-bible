  "decisoes": [
    {
      "questao": "Como preservar o paralelo entre הַדָּבָר הַטּוֹב e הַדָּבָר הָרָע?",
      "escolha": "“toda boa palavra” / “toda palavra de calamidade”",
      "justificativa": "O mesmo substantivo דָּבָר estrutura a reversão entre a palavra benéfica cumprida e a palavra adversa que o SENHOR fará vir. ‘Calamidade’ expressa o mal ocorrido sobre os destinatários, não maldade moral em Deus.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“a promessa boa se cumpriu, mas nenhuma advertência ocorrerá”",
          "motivo": "Elimina o paralelo כַּאֲשֶׁר ... כֵּן e a ação futura do SENHOR."
        },
        {
          "opcao": "“Deus praticará maldade moral”",
          "motivo": "Confunde רַע como calamidade sofrida com culpa moral do agente."
        },
        {
          "opcao": "“alguma calamidade talvez venha”",
          "motivo": "Enfraquece כָּל e a certeza da reversão."
        }
      ]
    },
    {
      "questao": "Quem traz a calamidade e qual é seu limite?",
      "escolha": "“o SENHOR fará vir ... até eliminar vocês desta boa terra”",
      "justificativa": "O SENHOR é sujeito explícito do hifil יָבִיא e também do infinitivo com sufixo הַשְׁמִידוֹ. A destruição da terra dada é o limite da sequência.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“as nações destruirão a terra sem ação do SENHOR”",
          "motivo": "Substitui o agente gramatical explícito."
        },
        {
          "opcao": "“vocês jamais perderão a terra”",
          "motivo": "Nega a ameaça formulada."
        }
      ]
    }
  ],
