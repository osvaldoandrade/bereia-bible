      "questao": "Como preservar a enumeração?",
      "escolha": "Lista integral, incluindo filhos e filhas",
      "justificativa": "Cada objeto é coordenado: Acã, bens, filhos, filhas, animais, tenda e tudo o que lhe pertence. Nada é omitido para suavizar o relato.",
      "alternativas_rejeitadas": [
        {
          "opcao": "omitir filhos e filhas",
          "motivo": "Mutila a enumeração."
        },
        {
          "opcao": "resumir como “alguns bens”",
          "motivo": "Apaga pessoas, animais e totalidade."
        },
        {
          "opcao": "acrescentar a esposa",
          "motivo": "Introduz pessoa ausente."
        }
      ]
    },
    {
      "questao": "Referente de “com ele”",
      "escolha": "Manter o pronome",
      "justificativa": "O sufixo pode retomar Josué como líder ou Acã como centro do cortejo; a BV não fixa o antecedente.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“Todo Israel ficou no acampamento”",
          "motivo": "Contradiz a presença expressa."
        },
        {
          "opcao": "“somente os filhos acompanharam”",
          "motivo": "Substitui o coletivo."
        }
      ]
    },
    {
      "questao": "Como verter עֵמֶק עָכוֹר?",
      "escolha": "“vale de Acor”",
      "justificativa": "O topônimo é preservado e prepara o jogo com עכר no verso seguinte.",
      "alternativas_rejeitadas": [
