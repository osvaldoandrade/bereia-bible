  "decisoes": [
    {
      "questao": "Como verter דּוֹם dirigido ao sol?",
      "escolha": "“pare”",
      "justificativa": "דמם pode significar calar-se, ficar quieto ou cessar movimento. No paralelo com a lua “ficar em pé” no verso 13, “pare” comunica imobilidade sem acrescentar explicação cosmológica; a literal conserva “cala-te”.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“deixe de existir”",
          "motivo": "Excede o campo do verbo."
        },
        {
          "opcao": "“brilhe mais forte”",
          "motivo": "Introduz uma ação não expressa."
        }
      ]
    },
    {
      "questao": "Relação de בְּגִבְעוֹן e בְּעֵמֶק אַיָּלוֹן",
      "escolha": "“em Gibeão” e “no vale de Aijalom”",
      "justificativa": "As preposições localizam os astros em relação aos lugares vistos no horizonte narrativo. A BV não converte as referências em trajetórias astronômicas modernas.",
      "alternativas_rejeitadas": [
        {
          "opcao": "omitir Gibeão e Aijalom",
          "motivo": "Apaga o paralelismo geográfico."
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "Divergência menor de preposição: BV usa 'em Gibeão'/'no vale' enquanto NTLH/ARA/NVIPT usam 'sobre'. A traducao_literal da BV também emprega 'em'/'no', refletindo a preposição hebraica. A escolha é estilística e legítima; 'em' e 'sobre' comunicam a mesma ideia de posição celeste acima do lugar. (ER-0019 v2).",
      "alternativas_rejeitadas": [],
