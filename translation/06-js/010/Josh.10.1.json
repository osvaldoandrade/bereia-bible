  "decisoes": [
    {
      "questao": "Como verter וַיַּחֲרִימָהּ?",
      "escolha": "“a dedicado à destruição”",
      "justificativa": "O hifil de חרם combina devotamento e destruição total. A redação mantém a âncora adotada em Josué 2:10 e não suaviza a ação.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“a anexado pacificamente”",
          "motivo": "Contradiz o verbo e apaga a destruição."
        },
        {
          "opcao": "“a amaldiçoado”",
          "motivo": "Reduz חרם a uma fala de maldição, sem a execução destrutiva."
        }
      ]
    },
    {
      "questao": "Qual é a relação de Gibeão com Israel?",
      "escolha": "“tinham feito paz com Israel e viviam no meio deles”",
      "justificativa": "השלים את indica estabelecer paz com, e בקרבם localiza os gibeonitas no meio de Israel. As duas afirmações são mantidas separadas.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“Israel conquistou Gibeão”",
          "motivo": "Inverte a iniciativa diplomática narrada."
        },
        {
          "opcao": "“Gibeão permaneceu fora de Israel”",
          "motivo": "Contradiz “viviam no meio deles”."
        }
      ]
    }
  ],
