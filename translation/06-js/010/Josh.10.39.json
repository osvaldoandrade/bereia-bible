    {
      "questao": "Como preservar os agentes singulares e plurais?",
      "escolha": "“Josué conquistou ... Os israelitas ... Josué não deixou”",
      "justificativa": "וַיִּלְכְּדָהּ é singular; וַיַּכּוּם e וַיַּחֲרִימוּ são plurais; לֹא הִשְׁאִיר retorna ao singular. A BV nomeia os agentes para tornar a alternância auditável.",
      "alternativas_rejeitadas": [
        {
          "opcao": "usar “eles” em todo o verso sem antecedente claro",
          "motivo": "Oculta as mudanças de número."
        },
        {
          "opcao": "fazer o rei de Debir conquistar as próprias cidades",
          "motivo": "Inverte objeto e agente."
        }
      ]
    },
    {
      "questao": "Dois paralelos históricos",
      "escolha": "“como ... Hebrom ... e ... Libna”",
      "justificativa": "O verso compara Debir e seu rei a duas conquistas anteriores. As duas comparações são mantidas, não fundidas numa referência genérica.",
      "alternativas_rejeitadas": [
        {
          "opcao": "mencionar apenas Jericó",
          "motivo": "Substitui os paralelos explícitos."
        }
      ]
    },
    {
      "questao": "Manutenção do texto_bv (revisão ER-0019 v2)",
      "escolha": "texto mantido",
      "justificativa": "RED-1 ('havia feito'): falso-positivo — a repetição de 'havia feito' é fórmula comparativa intencional (como fez com X, assim fez com Y), preservada também na ARA ('Como fizera a Hebrom, e como fizera também a Libna...assim fez a Debir'). PRO-1 (4 pronomes 3ª pessoa): falso-positivo — 'seu rei' (de Debir, de Libna) e os demais pronomes têm antecedente inequívoco na cadeia narrativa. (ER-0019 v2).",
