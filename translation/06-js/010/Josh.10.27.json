  "decisoes": [
    {
      "questao": "Como verter לְעֵת בּוֹא הַשֶּׁמֶשׁ?",
      "escolha": "“Ao pôr do sol”",
      "justificativa": "A entrada do sol é o idioma do ocaso. A BV preserva o limite temporal sem o calque espacial no publicado.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“ao nascer do sol”",
          "motivo": "Inverte o momento do dia."
        }
      ]
    },
    {
      "questao": "Relação das pedras com עַד־עֶצֶם הַיּוֹם הַזֶּה",
      "escolha": "“que permanecem ali até hoje”",
      "justificativa": "O hebraico afirma a colocação das pedras e prolonga seu marco até o dia do narrador. “Permanecem” explicita a continuidade necessária em português e é registrado como suprimento.",
      "alternativas_rejeitadas": [
        {
          "opcao": "“foram removidas imediatamente”",
          "motivo": "Contradiz a fórmula temporal."
        }
      ]
    }
