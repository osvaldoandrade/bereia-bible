  "decisoes": [
    {
      "questao": "Idiom שָׂמוּ...טְעֵם ('puseram atenção') — diferente do idiom שָׂמְתָּ טְעֵם de v.10 ('decretaste')",
      "escolha": "'não têm dado atenção/obedecido'.",
      "justificativa": "mesma raiz שים+טעם, mas idiotismo distinto ('prestar atenção') do usado para 'decretar'; o idiom com עליך ('sobre ti') marca regência distinta, e a distinção é documentada para não confundir os dois sentidos do mesmo par lexical.",
      "alternativas_rejeitadas": [
        {
          "opcao": "traduzir uniformemente como 'decreto' nas duas ocorrências",
          "motivo": "confundiria a nuance sintática marcada pela regência diferente."
        }
      ]
    },
    {
      "questao": "לאלהיך — 'seus deuses' (plural, minúscula)",
      "escolha": "plural, minúscula.",
      "justificativa": "referente aos deuses pagãos de Nabucodonosor (politeísmo babilônico); morfologia é claramente plural (Ncmpc/Sp2ms), e minúscula por não se tratar do Deus de Israel.",
      "alternativas_rejeitadas": [
        {
          "opcao": "singular 'seu deus'",
          "motivo": "apagaria o contraste com o monoteísmo confessado pelos três hebreus em v.17."
        }
      ]
    }
  ],
