      "questao": "בִּטְעֵ֣ם חַמְרָ֗א — 'sob o efeito do vinho' vs 'por decreto relativo ao vinho'",
      "escolha": "sob o efeito do vinho",
      "justificativa": "טְעֵם admite 'gosto' ou 'decreto'; o contexto de embriaguez do capítulo (vv.4,5,9) sustenta a leitura idiomática 'sob o efeito/gosto do vinho'.",
      "alternativas_rejeitadas": [
        {
          "opcao": "por ordem relativa ao vinho",
          "motivo": "sentido de 'decreto' é atestado para טְעֵם alhures em aramaico bíblico, mas menos natural neste contexto de festim"
        }
      ]
    },
    {
      "questao": "שֵׁגְלָתֵהּ / לְחֵנָתֵהּ — 'esposas' e 'concubinas'",
      "escolha": "suas esposas / suas concubinas",
      "justificativa": "distinção lexical entre consorte real (שֵׁגַל) e concubina (לְחֵנָה) preservada por dois termos distintos em português.",
      "alternativas_rejeitadas": [
        {
          "opcao": "'suas mulheres' para ambos",
          "motivo": "apaga a distinção lexical que o aramaico marca com dois substantivos diferentes"
        }
      ]
    },
