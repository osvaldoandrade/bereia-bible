  "decisoes": [
    {
      "questao": "כָּל־אֱנָ֠שׁ — 'todo homem' vs 'qualquer pessoa'",
      "escolha": "qualquer pessoa",
      "justificativa": "אֱנָשׁ é o termo genérico aramaico para 'ser humano', sem marcação de gênero; 'qualquer pessoa' preserva o sentido inclusivo do original.",
      "alternativas_rejeitadas": [
        {
          "opcao": "todo homem",
          "motivo": "restringe ao masculino algo que o aramaico não restringe lexicalmente"
        }
      ]
    },
    {
      "questao": "עָנֵ֨ה מַלְכָּ֜א וְאָמַ֣ר — fórmula 'respondeu e disse'",
      "escolha": "o rei respondeu e disse",
      "justificativa": "fórmula recorrente no capítulo (vv.7,10,13,17); mantida uniformemente para rastreabilidade, como idiotismo narrativo de 'tomar a palavra', não pressupondo pergunta prévia.",
      "alternativas_rejeitadas": [
        {
          "opcao": "o rei falou e disse",
          "motivo": "perde o valor formular de עָנֵה, reaproveitado como marca estrutural do capítulo"
        }
      ]
    }
