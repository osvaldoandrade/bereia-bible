    {
      "questao": "τέλειοι — 'perfeitos' (absoluto) ou 'maduros' (relativo)?",
      "escolha": "'maduros'.",
      "justificativa": "τέλειος em Paulo frequentemente denota maturidade relativa (cf. 1Co 2.6); 'perfeitos' geraria tensão lógica desnecessária com a negação explícita de τετελείωμαι no v.12 ('ainda não fui aperfeiçoado').",
      "alternativas_rejeitadas": [
        {
          "opcao": "'perfeitos' (tradução literal-padrão)",
          "motivo": "gramaticalmente possível, mas cria contradição aparente com o v.12 que o sentido usual de maturidade evita; jogo retórico com a mesma raiz τέλει- registrado aqui"
        }
      ]
    },
    {
      "questao": "Cópula elíptica em Ὅσοι...τέλειοι",
      "escolha": "Suprida como 'somos'.",
      "justificativa": "EDITORIAL §4.",
      "alternativas_rejeitadas": []
    }
  ],
