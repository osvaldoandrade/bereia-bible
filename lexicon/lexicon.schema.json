{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bereia.org/schemas/lexicon/1",
  "title": "Léxico terminológico — Bereia Version",
  "version": "1.0.0",
  "description": "Contrato do lexicon/lexicon.json. Invariantes I-1..I-10 e onde cada uma é verificada: I-1 lemma+dominio único (internal/lexicon); I-2 glosa_bv não-vazia (este schema, minLength); I-3 justificativa obrigatória (este schema); I-4 status ∈ {PROPOSED, APPROVED, SUPERSEDED} (este schema, enum); I-5 SUPERSEDED exige superseded_por apontando para entrada existente do mesmo domínio (internal/lexicon); I-6 politica_ref/diretriz_ref quando dominio = nome divino, e politica_ref declarada (internal/lexicon); I-7 primeiras_ocorrencias em formato OSIS (internal/lexicon); I-8 owner obrigatório (este schema). I-9 (mudança de glosa APPROVED via nova entrada + supersede, nunca edição in-place) e I-10 (bump de versao a cada mudança) são REGRAS DE PROCESSO auditadas por git diff e ratificação humana — nenhum código as valida hoje.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "versao", "owner", "politicas", "entradas"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "versao": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "owner": { "type": "string", "minLength": 1 },
    "politicas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "regra", "justificativa", "diretriz_ref"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "regra": { "type": "string", "minLength": 1 },
          "justificativa": { "type": "string", "minLength": 1 },
          "diretriz_ref": { "type": "string", "pattern": "^ER-[0-9]{4}$" },
          "arquivo": { "type": "string" },
          "versao_politica": { "type": "string" }
        }
      }
    },
    "entradas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lemma", "original", "translit", "glosa_bv", "dominio", "justificativa", "status", "owner", "primeiras_ocorrencias"],
        "properties": {
          "lemma": { "type": "string", "pattern": "^[HG][0-9]+[ab]?$" },
          "original": { "type": "string", "minLength": 1 },
          "translit": { "type": "string", "minLength": 1 },
          "glosa_bv": { "type": "string", "minLength": 1 },
          "dominio": { "type": "string", "minLength": 1 },
          "justificativa": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PROPOSED", "APPROVED", "SUPERSEDED"] },
          "owner": { "type": "string", "minLength": 1 },
          "primeiras_ocorrencias": {
            "type": "array", "minItems": 1,
            "items": { "type": "string", "pattern": "^[1-4]?[A-Z][a-z]+\\.[0-9]+\\.[0-9]+$" }
          },
          "politica_ref": { "type": "string" },
          "diretriz_ref": { "type": "string", "pattern": "^ER-[0-9]{4}$" },
          "superseded_por": { "type": "string" },
          "observacao": { "type": "string" }
        }
      }
    }
  }
}
